# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Turso / LibSQL Configuration
TURSO_DATABASE_URL=libsql://...
TURSO_AUTH_TOKEN=...

# Admin Configuration
ADMIN_PASSCODE=1234

# Auth.js Configuration
AUTH_SECRET=your_auth_secret_here
AUTH_TRUST_HOST=true

# Email Configuration (Resend)
RESEND_API_KEY=re_...

# Club season registration stays dark until production launch.
CLUB_SEASON_REGISTRATION_ENABLED=false
# Controlled pilot bypass. Effective only while the public feature flag is off,
# for exact allowlisted emails, and while STRIPE_SECRET_KEY is a test key.
CLUB_SEASON_PILOT_MODE=false
CLUB_SEASON_PILOT_EMAILS=
CLUB_SEASON_CRON_SECRET=use-a-long-random-value
CLUB_SEASON_BILLING_EMAIL=loren@tualatinvalleyvb.com
