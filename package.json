{
  "name": "tvvc-website",
  "version": "1.0.0",
  "description": "Tualatin Valley Volleyball Club website",
  "main": "index.html",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "test": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:prod": "set BASE_URL=https://tualatinvalleyvb.com && playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui"
  },
  "keywords": [
    "volleyball",
    "club",
    "hillsboro"
  ],
  "author": "TVVC",
  "license": "MIT",
  "devDependencies": {
