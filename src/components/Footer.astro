---
const currentYear = new Date().getFullYear();
---

<footer class="bg-black/50 border-t border-white/10 py-16 mt-20">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12">
    <div class="col-span-1 md:col-span-2 text-center md:text-left">
      <h2 class="text-2xl font-heading font-extrabold mb-4">TVVC</h2>
      <p class="text-white/60 max-w-md mb-6">
        Tualatin Valley Volleyball Club — Volleyball with Purpose. Coaching with Heart. We keep volleyball accessible and joyful.
      </p>
    </div>
    
    <div>
      <h3 class="font-bold mb-4 uppercase text-xs tracking-widest text-brand-teal">Quick Links</h3>
      <ul class="space-y-2 text-sm text-white/60">
        <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
        <li><a href="/teams" class="hover:text-white transition-colors">Club Teams</a></li>
        <li><a href="/programs" class="hover:text-white transition-colors">In-House Programs</a></li>
        <li><a href="/summer-camps-clinics" class="hover:text-white transition-colors">Summer Camps & Clinics</a></li>
        <li><a href="/faq" class="hover:text-white transition-colors">FAQ</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-bold mb-4 uppercase text-xs tracking-widest text-brand-teal">Contact</h3>
      <ul class="space-y-2 text-sm text-white/60">
        <li>(503) 389-0760</li>
        <li>info@tualatinvalleyvb.com</li>
        <li class="pt-2">
          <a 
            href="https://www.google.com/maps/search/?api=1&query=2820+SE+58th+Court,+Hillsboro,+OR+97123" 
            target="_blank" 
            class="hover:text-white transition-colors block"
          >
            2820 SE 58th Court<br/>
            Hillsboro, OR 97123
          </a>
        </li>
        <li class="pt-4"><a href="/privacy-policy" class="text-[10px] uppercase tracking-widest hover:text-white transition-colors">Privacy Policy</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-bold mb-4 uppercase text-xs tracking-widest text-brand-teal">Location</h3>
      <p class="text-sm text-white/60 mb-4">
        2820 SE 58th Court<br/>
        Hillsboro, OR 97123
      </p>
      <div class="rounded-xl overflow-hidden border border-white/10 shadow-2xl shadow-black/50 h-32 w-full">
        <iframe 
          title="Tualatin Valley Volleyball Club Location Map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3164.3335793665105!2d-122.9224053!3d45.498861299999994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x54950ff866da519f%3A0x391c11667eeade27!2sTualatin%20Valley%20Volleyball%20Club!5e1!3m2!1sen!2sus!4v1776808277481!5m2!1sen!2sus" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
  
  <div class="max-w-6xl mx-auto px-6 mt-16 pt-8 border-t border-white/5 text-[10px] text-white/50 flex justify-between uppercase tracking-widest">
    <p>© {currentYear} Tualatin Valley Volleyball Club</p>
    <p>Hillsboro, Oregon</p>
  </div>
</footer>
