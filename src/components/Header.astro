---
const { pathname } = Astro.url;
const normalizedPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navLinks = [
  { href: '/teams', label: 'Club Teams' },
  { href: '/tryouts', label: 'Tryouts' },
  { href: '/programs', label: 'In-House Programs' },
  { href: '/summer-camps-clinics', label: 'Summer Camps & Clinics' },
  { href: '/faq', label: 'FAQ' },
];

const portalLink = { href: '/portal', label: 'My Portal', class: 'lg:bg-brand-teal lg:text-brand-charcoal lg:px-4 lg:py-2 lg:rounded-full lg:hover:bg-brand-teal/80 lg:shadow-lg lg:shadow-brand-teal/20' };

const isHome = normalizedPath === '/';
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-6xl z-50">
  <nav class="glass rounded-full px-6 py-2 md:py-3 flex items-center justify-between">
    <a href="/" class="flex flex-col">
      <span class="font-heading font-extrabold text-lg leading-tight tracking-tight">
        <span class="text-brand-teal">TV</span>VC
      </span>
      <span class="text-[10px] uppercase tracking-widest text-white/50 font-bold -mt-1">Hillsboro, OR</span>
    </a>

    <div class="hidden lg:flex items-center gap-5">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "text-sm font-heading font-bold hover:text-brand-teal transition-colors",
            normalizedPath === link.href ? "text-brand-teal" : "text-white"
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={portalLink.href}
        class:list={[
          "text-sm font-heading font-bold transition-all hover:text-brand-teal",
          portalLink.class,
          normalizedPath.startsWith('/portal') ? "text-brand-teal" : "text-white"
        ]}
      >
        {portalLink.label}
      </a>
    </div>

    <!-- Navigation Toggle -->
    <button class="lg:hidden text-white p-2 focus-visible:ring-2 focus-visible:ring-brand-teal rounded-lg outline-none" id="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
    </button>
  </nav>

  <!-- Navigation Menu Backdrop -->
  <div id="mobile-menu" class="hidden absolute top-16 left-0 w-full bg-brand-charcoal/95 backdrop-blur-xl border border-white/10 rounded-3xl p-8 flex flex-col gap-6 shadow-2xl transition-all duration-300 opacity-0 -translate-y-4 max-h-[calc(100vh-6rem)] overflow-y-auto">
    {navLinks.map(link => (
      <a 
        href={link.href} 
        class:list={[
          "text-lg font-heading font-bold hover:text-brand-teal transition-colors",
          normalizedPath === link.href ? "text-brand-teal" : "text-white"
        ]}
      >
        {link.label}
      </a>
    ))}
    <div class="h-px w-full bg-white/10 my-2"></div>
    <a 
      href={portalLink.href} 
      class:list={[
        "text-lg font-heading font-bold text-brand-charcoal bg-brand-teal px-6 py-4 rounded-2xl flex items-center justify-center gap-2 hover:bg-brand-teal/90 transition-all shadow-lg shadow-brand-teal/20",
        normalizedPath.startsWith('/portal') ? "ring-2 ring-white" : ""
      ]}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      {portalLink.label}
    </a>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      
      if (isHidden) {
        menu.classList.remove('hidden');
        // Small delay to allow transition
        requestAnimationFrame(() => {
          menu.classList.remove('opacity-0', '-translate-y-4');
        });
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('opacity-0', '-translate-y-4');
        toggle.setAttribute('aria-expanded', 'false');

        let closed = false;
        const finishClose = () => {
          if (closed) return;
          closed = true;
          menu.classList.add('hidden');
          menu.removeEventListener('transitionend', onTransitionEnd);
        };
        const onTransitionEnd = () => finishClose();
        menu.addEventListener('transitionend', onTransitionEnd);
        window.setTimeout(finishClose, 350);
      }
    });

    // Close menu on link click
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('opacity-0', '-translate-y-4', 'hidden');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
