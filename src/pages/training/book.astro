---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import TrainingBookingForm from '../../components/training/TrainingBookingForm';
import { getDb } from '../../db';
import { events } from '../../db/schema';
import { asc, and, eq, lt } from 'drizzle-orm';

const db = getDb(
  import.meta.env.TURSO_DATABASE_URL || '',
  import.meta.env.TURSO_AUTH_TOKEN || ''
);

const now = new Date();

let trainingBlocks = [];
let error = null;

const getSortValue = (b: any) => {
  try {
    const datePart = b.dateInfo.split('–')[0].trim();
    const timePart = b.timeInfo?.split('–')[0].trim();
    const eventDate = new Date(`${datePart}, 2026 ${timePart || ''}`);
    return eventDate.getTime();
  } catch (e) {
    return 0;
  }
};

try {
  // Fetch available training blocks (not full)
  const results = await db
    .select()
    .from(events)
    .where(
      and(
        eq(events.type, 'training-block'),
        eq(events.active, true)
      )
    );
    
  // Filter and Sort
  trainingBlocks = results
    .filter(b => {
      // 1. Check capacity
      if ((b.spotsFilled || 0) >= b.capacity) return false;

      // 2. Check if in the past
      try {
        const eventDate = new Date(getSortValue(b));
        if (isNaN(eventDate.getTime())) return true;
        return eventDate > now;
      } catch (e) {
        return true;
      }
    })
    .sort((a, b) => getSortValue(a) - getSortValue(b));
} catch (e) {
  console.error("Database Error:", e);
  error = "Technical issue loading training blocks. Please try again later.";
}
---

<BaseLayout title="Book Training Block" description="Select and book a 90-minute volleyball training block at TVVC.">
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-brand-teal font-bold uppercase tracking-[0.2em] text-[10px] mb-4 block">Small Group Training</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold text-white uppercase mb-6 leading-tight">
          Book a <span class="text-brand-teal italic text-5xl md:text-8xl">Block</span>
        </h1>
        <p class="text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
          Training blocks are $80 for 90 minutes. You may book for a single player or a small group (max 4).
        </p>
      </div>

      {error ? (
        <div class="glass-card p-12 text-center border-brand-coral/20">
          <p class="text-brand-coral font-bold mb-4">{error}</p>
          <a href="/training" class="btn btn-secondary">Back to Training</a>
        </div>
      ) : trainingBlocks.length > 0 ? (
        <TrainingBookingForm client:load availableBlocks={trainingBlocks} />
      ) : (
        <div class="glass-card p-16 text-center border-white/5">
          <div class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/20"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <h2 class="text-xl font-heading font-bold text-white uppercase mb-2">No Blocks Available</h2>
          <p class="text-white/40 text-sm max-w-xs mx-auto mb-8">We don't have any training blocks scheduled at the moment. Please check back soon or contact us directly.</p>
          <a href="mailto:info@tualatinvalleyvb.com" class="btn btn-secondary !px-8">Inquire About Training</a>
        </div>
      )}
      
      <div class="mt-20 pt-12 border-t border-white/5 text-center">
        <p class="text-white/40 text-xs uppercase tracking-widest font-bold">Need a different time or have questions?</p>
        <a href="mailto:info@tualatinvalleyvb.com" class="text-brand-teal font-bold hover:underline mt-2 inline-block">info@tualatinvalleyvb.com</a>
      </div>
    </div>
  </main>
</BaseLayout>
