---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import TrainingBookingForm from '../../components/training/TrainingBookingForm';
import { getSession } from 'auth-astro/server';
import { db } from '../../db/db';
import { events, athletes } from '../../db/schema';
import { and, eq } from 'drizzle-orm';
import { ensureCanonicalPortalUser } from '../../lib/portal-ownership';

let session = null;
try {
  session = await getSession(Astro.request);
} catch (e) {
  console.error('Failed to get session:', e);
}
const now = new Date();
const currentYear = 2026;

let trainingBlocks = [];
let userAthletes = [];
let error = null;

const getSortValue = (b: any) => {
  try {
    // Handle both en-dash and hyphen
    const datePart = b.dateInfo.split(/[–-]/)[0].trim();
    const timePart = b.timeInfo?.split(/[–-]/)[0].trim();
    
    // Clean time string (remove am/pm for a moment to check if it's just the time)
    const timeClean = timePart?.replace(/(am|pm)/i, '').trim();
    const isPM = /pm/i.test(timePart || '');
    
    const eventDate = new Date(`${datePart}, ${currentYear} ${timePart || ''}`);
    
    // If the above fails or produces an invalid date, try a simpler version
    if (isNaN(eventDate.getTime())) {
      return new Date(`${datePart}, ${currentYear}`).getTime();
    }
    
    return eventDate.getTime();
  } catch (e) {
    return 0;
  }
};

try {
  // Fetch available training blocks (not full)
  const results = await db
    .select()
    .from(events)
    .where(
      and(
        eq(events.type, 'training-block'),
        eq(events.active, true)
      )
    );
    
  // Filter and Sort
  trainingBlocks = results
    .filter(b => {
      // 1. Check capacity
      if ((b.spotsFilled || 0) >= b.capacity) return false;

      // 2. Check if in the past
      try {
        const eventTime = getSortValue(b);
        if (eventTime === 0) return true; // Keep if we really can't parse it
        
        // Hide if the event time is before "now"
        return eventTime > now.getTime();
      } catch (e) {
        return true;
      }
    })
    .sort((a, b) => getSortValue(a) - getSortValue(b));

  if (session) {
    const portalUser = await ensureCanonicalPortalUser(session.user);

    if (portalUser?.emergencyPhone) {
      (session.user as any).emergencyPhone = portalUser.emergencyPhone;
    }

    if (portalUser) {
      userAthletes = await db.select({
        id: athletes.id,
        firstName: athletes.firstName,
        lastName: athletes.lastName,
        grade: athletes.grade,
        medicalInfo: athletes.medicalInfo,
        tshirtSize: athletes.tshirtSize,
        waiverAgreed: athletes.waiverAgreed,
        photoReleaseAgreed: athletes.photoReleaseAgreed,
      })
      .from(athletes)
      .where(eq(athletes.parentId, portalUser.id))
      .groupBy(athletes.id);
    }
  }
} catch (e) {
  console.error("Database Error:", e);
  error = "Technical issue loading training blocks. Please try again later.";
}
---

