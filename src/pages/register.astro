---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import RegistrationForm from '../components/registration/RegistrationForm';
import { getDb } from '../db';
import { events } from '../db/schema';
import { asc, and, eq } from 'drizzle-orm';

const db = getDb(
  import.meta.env.TURSO_DATABASE_URL || '',
  import.meta.env.TURSO_AUTH_TOKEN || ''
);

let allEvents = [];
let error = null;

try {
  allEvents = await db.select().from(events).where(eq(events.active, true)).orderBy(asc(events.type), asc(events.dateInfo));
} catch (e) {
  console.error("Database Error:", e);
  error = "We're experiencing a technical issue loading the registration data. Please try again later or contact Loren at 503-389-0760.";
}
---

<BaseLayout title="Summer Registration" description="Register for TVVC Summer 2026 Volleyball Camps and Clinics in Hillsboro, OR.">
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-brand-teal font-bold uppercase tracking-[0.2em] text-[10px] mb-4 block">Summer 2026</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold text-white uppercase mb-6 leading-tight">
          Secure Your <span class="text-brand-teal italic text-5xl md:text-8xl">Spot</span>
        </h1>
        <p class="text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
          Complete the form below to register your athlete(s) for our summer training programs.
        </p>
      </div>

      {error ? (
        <div class="glass-card p-12 text-center border-brand-coral/20">
          <p class="text-brand-coral font-bold mb-4">{error}</p>
          <a href="/" class="btn btn-secondary">Back to Home</a>
        </div>
      ) : (
        <RegistrationForm client:load initialEvents={allEvents} />
      )}
    </div>
  </main>
</BaseLayout>
