---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import RegistrationForm from '../components/registration/RegistrationForm';
import { getSession } from 'auth-astro/server';
import { db } from '../db/db';
import { events, playerProfiles } from '../db/schema';
import { asc, and, eq, isNull } from 'drizzle-orm';
import { ensureCanonicalPortalUser } from '../lib/portal-ownership';
import { isRegistrationEventEligible } from '../lib/event-eligibility';

let session = null;
try {
  session = await getSession(Astro.request);
} catch (e) {
  console.error('Failed to get session:', e);
}

let allEvents = [];
let userAthletes = [];
let error = null;

try {
  const results = await db.select().from(events).where(eq(events.active, true)).orderBy(asc(events.type));
  
  allEvents = results.filter((event) => isRegistrationEventEligible(event));

  if (session) {
    const portalUser = await ensureCanonicalPortalUser(session.user);

    if (portalUser?.emergencyPhone) {
      (session.user as any).emergencyPhone = portalUser.emergencyPhone;
    }

    if (portalUser) {
      userAthletes = await db.select({
        id: playerProfiles.id,
        firstName: playerProfiles.firstName,
        lastName: playerProfiles.lastName,
        grade: playerProfiles.grade,
        medicalInfo: playerProfiles.medicalInfo,
        tshirtSize: playerProfiles.tshirtSize,
      })
      .from(playerProfiles)
      .where(and(
        eq(playerProfiles.parentId, portalUser.id),
        isNull(playerProfiles.archivedAt),
        isNull(playerProfiles.mergedIntoProfileId)
      ))
      .groupBy(playerProfiles.id);
    }
  }
} catch (e) {
  console.error("Database Error:", e);
  error = "We're experiencing a technical issue loading the registration data. Please try again later or contact Loren at 503-389-0760.";
}

const requestedTab = Astro.url.searchParams.get('tab') || 'tryout-prep';
---

<BaseLayout title="Event Registration" description="Register for TVVC camps, clinics, and tryout prep in Hillsboro, OR.">
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-brand-teal font-bold uppercase tracking-[0.2em] text-[10px] mb-4 block">2026-2027 Season</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold text-white uppercase mb-6 leading-tight">
          Secure Your <span class="text-brand-teal italic text-5xl md:text-8xl">Spot</span>
        </h1>
        <p class="text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
          Complete the form below to register your athlete(s) for our upcoming tryout prep clinics.
        </p>
      </div>

      {/* 
      {!session && (
        <div class="glass-card mb-12 p-6 flex flex-col md:flex-row items-center justify-between gap-6 border-brand-teal/20 bg-brand-teal/5">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-brand-teal/20 flex items-center justify-center text-brand-teal">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-white uppercase tracking-tight">Already have an account?</h3>
              <p class="text-white/40 text-sm">Log in to auto-fill your info and select saved players.</p>
            </div>
          </div>
          <a href="/portal/login?callbackUrl=/register" class="bg-brand-teal hover:bg-brand-teal/80 text-brand-charcoal font-black py-3 px-8 rounded-xl transition-all uppercase tracking-widest text-[10px] shadow-lg shadow-brand-teal/10">
            Login to Save Time
          </a>
        </div>
      )}
      */}

      {error ? (
        <div class="glass-card p-12 text-center border-brand-coral/20">
          <p class="text-brand-coral font-bold mb-4">{error}</p>
          <a href="/" class="btn btn-secondary">Back to Home</a>
        </div>
      ) : (
        <RegistrationForm 
          client:load 
          initialEvents={allEvents} 
          userAthletes={userAthletes} 
          currentUser={session?.user} 
          initialTab={requestedTab}
        />
      )}
    </div>
  </main>
</BaseLayout>
