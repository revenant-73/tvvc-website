---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const lastUpdated = "April 23, 2025";
const effectiveDate = "April 1, 2025";
---

<BaseLayout title="Privacy Policy" description="Privacy policy for Tualatin Valley Volleyball Club. Learn how we collect, use, and protect your personal data.">
  <main class="pt-32 pb-20">
    <section class="max-w-4xl mx-auto px-6 py-20 relative">
      <ScrollReveal>
        <div class="mb-12">
          <h1 class="text-4xl md:text-6xl font-heading font-extrabold mb-4 text-white">
            Privacy <span class="text-brand-teal">Policy</span>
          </h1>
          <p class="text-white/40 text-sm uppercase tracking-widest font-bold">
            Effective: {effectiveDate} | Last Updated: {lastUpdated}
          </p>
        </div>
      </ScrollReveal>

      <div class="space-y-12 text-white/70 leading-relaxed">
        <ScrollReveal delay={0.1}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">1. Who we are</h2>
            <p>
              Tualatin Valley Volleyball Club ("TVVC," "we," "our," "us") provides youth volleyball training, teams, and
              events. Our primary website is <a href="https://tualatinvalleyvb.com" class="text-brand-teal hover:underline">https://tualatinvalleyvb.com</a>.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.2}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">2. Information we collect</h2>
            <ul class="space-y-4">
              <li><strong class="text-white">Identity data:</strong> parent or guardian name, athlete name, date of birth.</li>
              <li><strong class="text-white">Contact data:</strong> email address, phone number, mailing address.</li>
              <li><strong class="text-white">Payment data:</strong> Stripe customer ID, last four digits of the card, transaction amounts, refunds.</li>
              <li><strong class="text-white">Technical data:</strong> IP address, browser type, device information, and cookies.</li>
              <li><strong class="text-white">Usage data:</strong> pages visited, links clicked, time spent on pages, basic analytics.</li>
            </ul>
            <p class="mt-4 italic">
              We collect this information when you create an account, register for programs, complete a payment, submit
              forms, or browse our website.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.3}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">3. How we use your information</h2>
            <ul class="list-disc pl-6 space-y-2">
              <li>To process payments, issue refunds, and send receipts.</li>
              <li>To display your current balance and payment history in the parent portal or in email statements.</li>
              <li>To communicate schedules, club updates, policy changes, and promotional offers.</li>
              <li>To improve website functionality, security, and user experience.</li>
              <li>To comply with legal, tax, and accounting obligations.</li>
            </ul>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.4}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">4. Sharing and disclosure</h2>
            <ul class="list-disc pl-6 space-y-2 mb-4">
              <li>Stripe processes all card payments; full card numbers never touch our servers.</li>
              <li>Email and SMS providers deliver receipts and notifications.</li>
              <li>Government or regulatory authorities if required to satisfy a law, regulation, or legal process.</li>
            </ul>
            <p class="font-bold text-brand-teal">We do not sell or rent your personal data to anyone.</p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.5}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">5. Cookies and tracking</h2>
            <p>
              We use essential cookies for site security and for Stripe checkout to function. Optional analytics cookies
              help us understand traffic patterns. You can disable non-essential cookies in your
              browser settings at any time.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.6}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">6. Data security</h2>
            <ul class="list-disc pl-6 space-y-2">
              <li>All data is transmitted over HTTPS/TLS encryption.</li>
              <li>Stripe is PCI-DSS Level 1 certified; we store only the minimal payment references.</li>
              <li>Access to personal data inside TVVC is restricted to staff who need it.</li>
              <li>We review site code and third-party integrations periodically.</li>
            </ul>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.7}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">7. Data retention</h2>
            <p>
              We keep account and transaction records for as long as you remain a customer and for up to seven (7) years
              afterward, to meet tax and accounting requirements.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.8}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">8. Your rights</h2>
            <p>
              Depending on your location, you may have the right to access, correct, delete, or restrict your personal
              data. To exercise these rights, email us at <a href="mailto:info@tualatinvalleyvb.com" class="text-brand-teal hover:underline">info@tualatinvalleyvb.com</a>.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.9}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">9. Children's privacy</h2>
            <p>
              TVVC's services require a parent or legal guardian to create and
              manage all accounts and payments. We do not knowingly collect personal data from children without parental
              consent.
            </p>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={1.0}>
          <div class="glass-card bg-white/5 border-white/10 p-8">
            <h2 class="text-2xl font-heading font-bold mb-4 text-white">10. Contact us</h2>
            <p class="font-bold text-white mb-2">TVVC Privacy Officer</p>
            <p>Email: <a href="mailto:info@tualatinvalleyvb.com" class="text-brand-teal hover:underline">info@tualatinvalleyvb.com</a></p>
            <p>Mail: 27170 NW Dorland Rd, North Plains, OR 97133, USA</p>
          </div>
        </ScrollReveal>
      </div>

      <ScrollReveal delay={1.1}>
        <div class="mt-20 text-center">
          <h2 class="text-3xl font-heading font-bold mb-8 text-white">Questions about our privacy practices?</h2>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="mailto:info@tualatinvalleyvb.com" class="btn btn-primary">Email Us</a>
            <a href="tel:+15033890760" class="btn btn-secondary">Call Us</a>
            <a href="/" class="btn btn-secondary">Back to Home</a>
          </div>
        </div>
      </ScrollReveal>
    </section>
  </main>
</BaseLayout>
