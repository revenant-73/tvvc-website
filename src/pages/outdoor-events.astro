---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import OutdoorRegistrationManager from '../components/registration/OutdoorRegistrationManager';
import { getSession } from 'auth-astro/server';
import { db } from '../db/db';
import { events as eventsTable, playerProfiles } from '../db/schema';
import { eq } from 'drizzle-orm';
import { ensureCanonicalPortalUser } from '../lib/portal-ownership';

let session = null;
try {
  session = await getSession(Astro.request);
} catch (e) {
  console.error('Failed to get session:', e);
}

let dbEvents = [];
let userAthletes = [];

try {
  const allRows = await db.select().from(eventsTable);
  
  dbEvents = allRows.filter(e => 
    (e.type === 'tournament' || e.type === 'family-challenge') && e.active
  );

  if (session) {
    const portalUser = await ensureCanonicalPortalUser(session.user);

    if (portalUser?.emergencyPhone) {
      (session.user as any).emergencyPhone = portalUser.emergencyPhone;
    }

    if (portalUser) {
      userAthletes = await db.select({
        id: playerProfiles.id,
        firstName: playerProfiles.firstName,
        lastName: playerProfiles.lastName,
        grade: playerProfiles.grade,
        medicalInfo: playerProfiles.medicalInfo,
        tshirtSize: playerProfiles.tshirtSize,
      })
      .from(playerProfiles)
      .where(eq(playerProfiles.parentId, portalUser.id))
      .groupBy(playerProfiles.id);
    }
  }
} catch (e) {
  console.error("Outdoor Events DB Error:", e);
}
---

<BaseLayout title="Outdoor Events & Drop-in Grass Volleyball" description="TVVC Outdoor 2026 Grass Series, Family Events, and community drop-in grass volleyball in Hillsboro, OR.">
  <main class="pt-32">
    <!-- Hero -->
    <section class="px-6 py-20 relative text-center md:text-left">
      <div class="max-w-6xl mx-auto">
        <span class="text-brand-teal font-bold uppercase tracking-widest text-xs mb-4 block text-brand-teal">Outdoor 2026</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold mb-6 leading-tight text-white">
          Grass Series & <span class="text-brand-teal italic text-4xl md:text-7xl">Drop-in Play</span>
        </h1>
        <p class="text-lg text-white/60 max-w-2xl leading-relaxed">
          From organized 2v2 tournaments and family events to community drop-in play. Join us for a summer of competitive and fun grass volleyball.
        </p>
      </div>
    </section>

    <!-- Drop-in Section -->
    <section class="max-w-6xl mx-auto px-6 py-24 border-y border-white/5 bg-brand-teal/5">
       <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
             <span class="text-brand-teal font-bold uppercase tracking-widest text-[10px] mb-4 block">Summer Pick-up</span>
             <h2 class="text-3xl md:text-5xl font-heading mb-8 text-white leading-tight">Drop-in <span class="text-brand-teal italic text-4xl">Grass Volleyball</span></h2>
             <p class="text-white/60 text-lg leading-relaxed mb-10">
                Looking for free options to play over the summer? We encourage anyone wanting more touches to join the <strong class="text-white">Westside Grass Volleyball</strong> Facebook group. It's a great community-run resource for finding local pick-up games and meeting other players.
             </p>
             <a href="https://www.facebook.com/share/g/17JigvL5yc/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary !px-8">Join the Facebook Group</a>
          </div>
          <div class="glass-card p-10 border-brand-teal/20 bg-white/5">
             <h4 class="text-white font-bold mb-4">Why Play Pick-up?</h4>
             <ul class="space-y-4 text-sm text-white/50">
                <li class="flex items-start gap-3">
                   <span class="text-brand-teal mt-1">✓</span>
                   <span>Completely free and community-driven</span>
                </li>
                <li class="flex items-start gap-3">
                   <span class="text-brand-teal mt-1">✓</span>
                   <span>Great for building court awareness and speed</span>
                </li>
                <li class="flex items-start gap-3">
                   <span class="text-brand-teal mt-1">✓</span>
                   <span>Connect with the local volleyball community</span>
                </li>
             </ul>
          </div>
       </div>
    </section>

    <!-- Intro -->
    <section class="max-w-6xl mx-auto px-6 py-24 scroll-mt-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-5xl font-heading mb-8 text-white leading-tight">2v2 Grass <span class="text-brand-teal italic text-4xl">Tournaments</span></h2>
          <p class="text-white/60 text-lg leading-relaxed mb-8">
            TVVC Outdoor is designed to bring athletes together in a competitive but relaxed summer environment. These events are not training sessions. They are opportunities to compete, connect, and enjoy the game in a different setting.
          </p>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
           {['Doubles (2v2)', 'Min. 4 Matches', 'Organized & Efficient', 'MS & HS Divisions'].map(item => (
             <div class="glass p-6 rounded-2xl border-white/5 text-center text-xs font-bold uppercase tracking-widest text-brand-teal">
                {item}
             </div>
           ))}
        </div>
      </div>
    </section>

    <!-- Division Descriptions -->
    <section class="max-w-6xl mx-auto px-6 py-24 border-t border-white/5">
       <div class="mb-16">
          <span class="text-brand-teal font-bold uppercase tracking-widest text-[10px] mb-4 block">Event Details</span>
          <h2 class="text-3xl md:text-5xl font-heading text-white mb-6 leading-tight">Doubles (2v2) <span class="text-brand-teal italic text-4xl">Divisions</span></h2>
          <p class="text-white/60 text-lg max-w-2xl leading-relaxed">
             These are <strong class="text-white">Doubles (2v2)</strong> events. To ensure the best experience for everyone, we offer multiple divisions based on skill level rather than just grade. All events begin at <strong class="text-white">8:00 AM</strong> at <strong class="text-white">Century High School</strong>.
          </p>
       </div>

       <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <!-- Summer Series -->
          <div class="glass-card p-10 border-white/5 bg-white/5 h-full">
             <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-xl bg-brand-teal/20 flex items-center justify-center text-brand-teal">
                   <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                </div>
                <div>
                   <h3 class="text-xl font-heading font-bold text-white">Summer Grass Series</h3>
                   <p class="text-[10px] text-brand-teal font-bold uppercase tracking-widest">Players entering 7th-12th Grade</p>
                </div>
             </div>

             <div class="space-y-8">
                <div>
                   <h4 class="text-white font-bold mb-3 flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-brand-teal"></span>
                      A Division — Competitive
                   </h4>
                   <p class="text-sm text-white/50 leading-relaxed">
                      For experienced players with club or high school experience looking for a faster, more competitive environment. Best for those who can serve consistently and want a high-level challenge.
                   </p>
                </div>
                <div>
                   <h4 class="text-white font-bold mb-3 flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-brand-teal/40"></span>
                      B Division — Developmental
                   </h4>
                   <p class="text-sm text-white/50 leading-relaxed">
                      For newer or developing players who want a fun, competitive environment with less pressure. Perfect for building confidence and learning grass volleyball.
                   </p>
                </div>
             </div>
          </div>

          <!-- Family Challenge -->
          <div class="glass-card p-10 border-white/5 bg-white/5 h-full">
             <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-xl bg-brand-teal/20 flex items-center justify-center text-brand-teal">
                   <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div>
                   <h3 class="text-xl font-heading font-bold text-white">Family Challenge</h3>
                   <p class="text-[10px] text-brand-teal font-bold uppercase tracking-widest">Youth (18 & under) + Adult (30 & over)</p>
                </div>
             </div>

             <div class="space-y-8">
                <div>
                   <h4 class="text-white font-bold mb-3 flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-brand-teal"></span>
                      Competitive Family Division
                   </h4>
                   <p class="text-sm text-white/50 leading-relaxed">
                      For teams ready to play hard and chase the win. Best when both players have athletic experience and want a serious competitive environment.
                   </p>
                </div>
                <div>
                   <h4 class="text-white font-bold mb-3 flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-brand-teal/40"></span>
                      Fun Family Division
                   </h4>
                   <p class="text-sm text-white/50 leading-relaxed">
                      For teams who want a relaxed, lighthearted experience built around laughter and playing together. Winning matters less than the shared experience.
                   </p>
                </div>
             </div>
          </div>
       </div>
       
       <div class="mt-12 p-6 rounded-2xl bg-brand-teal/5 border border-brand-teal/10">
          <p class="text-xs text-white/50 italic text-center">
             <strong>Note:</strong> Players should register for the division that best matches their current experience level. TVVC may adjust teams or divisions if needed to create the best tournament experience.
          </p>
       </div>
    </section>

    <!-- Grass Series Grid -->
    <section class="max-w-6xl mx-auto px-6 py-32" id="registration">
       {/* 
       {!session && (
          <div class="glass-card mb-12 p-6 flex flex-col md:flex-row items-center justify-between gap-6 border-brand-teal/20 bg-brand-teal/5">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-brand-teal/20 flex items-center justify-center text-brand-teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-white uppercase tracking-tight">Already have an account?</h3>
                <p class="text-white/40 text-sm">Log in to auto-fill your info and select saved players.</p>
              </div>
            </div>
            <a href="/portal/login" class="bg-brand-teal hover:bg-brand-teal/80 text-brand-charcoal font-black py-3 px-8 rounded-xl transition-all uppercase tracking-widest text-[10px] shadow-lg shadow-brand-teal/10">
              Login to Save Time
            </a>
          </div>
       )}
       */}

       {dbEvents.length > 0 ? (
         <OutdoorRegistrationManager client:load events={dbEvents} userAthletes={userAthletes} currentUser={session?.user} />
       ) : (
         <div class="glass-card p-12 text-center border-white/5">
            <p class="text-white/20 uppercase tracking-widest font-bold text-xs">No active tournaments found. Check back soon!</p>
         </div>
       )}
    </section>

    <!-- Flyer Section -->
    <section class="max-w-4xl mx-auto px-6 py-12">
       <ScrollReveal>
          <div class="glass-card border-white/10 p-4 md:p-8 text-center">
             <span class="text-brand-teal font-bold uppercase tracking-widest text-[10px] mb-6 block">Tournament Overview</span>
             <h2 class="text-2xl font-heading mb-8 text-white">Download the <span class="text-brand-teal italic">Summer Flyer</span></h2>
             <a 
                href="/assets/images/summer vball options.png" 
                download="summer-vball-options.png" 
                class="block group relative overflow-hidden rounded-2xl cursor-pointer"
                title="Click to download flyer"
             >
                <img 
                   src="/assets/images/summer vball options.png" 
                   alt="Summer Volleyball Options Flyer" 
                   class="w-full h-auto transition-transform duration-700 group-hover:scale-[1.03]" 
                />
                <div class="absolute inset-0 bg-brand-teal/20 opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-center justify-center backdrop-blur-[2px] z-10">
                   <div class="bg-white text-zinc-900 px-8 py-3 rounded-full font-bold text-base transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500 shadow-2xl">
                      Download Flyer
                   </div>
                </div>
             </a>
             <p class="mt-8 text-white/40 text-xs italic">Click the image above to download the flyer.</p>
          </div>
       </ScrollReveal>
    </section>

  </main>
</BaseLayout>
