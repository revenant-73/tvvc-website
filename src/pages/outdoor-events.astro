---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const events = [
  {
    date: 'June 27, 2026',
    title: 'Summer Grass Series #1',
    who: 'Middle School (6th–8th) & High School (9th–12th)',
    desc: 'Pool play into Gold & Silver brackets. Seeded matches ensure every team continues competing after pool results are finalized.',
    cost: '$15 per player',
    capacity: 'Max 24 Teams'
  },
  {
    date: 'July 18, 2026',
    title: 'Summer Grass Series #2',
    who: 'Middle School (6th–8th) & High School (9th–12th)',
    desc: 'Build momentum and compete for bragging rights across the summer. Participation in both Series #1 and #2 is encouraged!',
    cost: '$15 per player',
    capacity: 'Max 24 Teams'
  },
  {
    date: 'August 8, 2026',
    title: 'Family Grass Challenge',
    who: 'Parent/Player Doubles (2v2)',
    desc: 'A lighthearted and memorable event focused on connection and community. Expect music, friendly competition, and family fun.',
    cost: '$30 per team',
    capacity: 'Max 24 Teams'
  }
];
---

<BaseLayout title="Outdoor Events & Drop-in Grass Volleyball" description="TVVC Outdoor 2026 Grass Series, Family Events, and community drop-in grass volleyball in Hillsboro, OR.">
  <main class="pt-32">
    <!-- Hero -->
    <section class="px-6 py-20 relative text-center md:text-left">
      <div class="max-w-6xl mx-auto">
        <span class="text-brand-teal font-bold uppercase tracking-widest text-xs mb-4 block text-brand-teal">Outdoor 2026</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold mb-6 leading-tight text-white">
          Grass Series & <span class="text-brand-teal italic text-4xl md:text-7xl">Drop-in Play</span>
        </h1>
        <p class="text-lg text-white/60 max-w-2xl leading-relaxed">
          From organized 2v2 tournaments and family events to community drop-in play. Join us for a summer of competitive and fun grass volleyball.
        </p>
      </div>
    </section>

    <!-- Drop-in Section -->
    <section class="max-w-6xl mx-auto px-6 py-24 border-y border-white/5 bg-brand-teal/5">
       <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
             <span class="text-brand-teal font-bold uppercase tracking-widest text-[10px] mb-4 block">Summer Pick-up</span>
             <h2 class="text-3xl md:text-5xl font-heading mb-8 text-white leading-tight">Drop-in <span class="text-brand-teal italic text-4xl">Grass Volleyball</span></h2>
             <p class="text-white/60 text-lg leading-relaxed mb-10">
                Looking for free options to play over the summer? We encourage anyone wanting more touches to join the <strong class="text-white">Westside Grass Volleyball</strong> Facebook group. It's a great community-run resource for finding local pick-up games and meeting other players.
             </p>
             <a href="https://www.facebook.com/share/g/17JigvL5yc/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary !px-8">Join the Facebook Group</a>
          </div>
          <div class="glass-card p-10 border-brand-teal/20 bg-white/5">
             <h4 class="text-white font-bold mb-4">Why Play Pick-up?</h4>
             <ul class="space-y-4 text-sm text-white/50">
                <li class="flex items-start gap-3">
                   <span class="text-brand-teal mt-1">✓</span>
                   <span>Completely free and community-driven</span>
                </li>
                <li class="flex items-start gap-3">
                   <span class="text-brand-teal mt-1">✓</span>
                   <span>Great for building court awareness and speed</span>
                </li>
                <li class="flex items-start gap-3">
                   <span class="text-brand-teal mt-1">✓</span>
                   <span>Connect with the local volleyball community</span>
                </li>
             </ul>
          </div>
       </div>
    </section>

    <!-- Intro -->
    <section class="max-w-6xl mx-auto px-6 py-24 scroll-mt-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-5xl font-heading mb-8 text-white leading-tight">2v2 Grass <span class="text-brand-teal italic text-4xl">Tournaments</span></h2>
          <p class="text-white/60 text-lg leading-relaxed mb-8">
            TVVC Outdoor is designed to bring athletes together in a competitive but relaxed summer environment. These events are not training sessions. They are opportunities to compete, connect, and enjoy the game in a different setting.
          </p>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
           {['Doubles (2v2)', 'Min. 4 Matches', 'Organized & Efficient', 'MS & HS Divisions'].map(item => (
             <div class="glass p-6 rounded-2xl border-white/5 text-center text-xs font-bold uppercase tracking-widest text-brand-teal">
                {item}
             </div>
           ))}
        </div>
      </div>
    </section>

    <!-- Grass Series Grid -->
    <section class="max-w-6xl mx-auto px-6 py-32">
       <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {events.map((event, i) => (
            <ScrollReveal delay={i * 0.1}>
              <div class="glass-card h-full flex flex-col justify-between border-white/5 hover:border-brand-teal/30 group relative overflow-hidden">
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-brand-teal/5 rounded-full blur-3xl group-hover:bg-brand-teal/10 transition-all duration-500"></div>
                <div>
                  <span class="bg-brand-teal/10 text-brand-teal text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-6 inline-block">{event.date}</span>
                  <h3 class="text-2xl font-heading font-bold mb-3 text-white">{event.title}</h3>
                  <p class="text-[10px] text-white/40 font-bold uppercase mb-4 tracking-wider">{event.who}</p>
                  <p class="text-sm text-white/50 leading-relaxed mb-8">{event.desc}</p>
                </div>
                
                <div class="mt-8 pt-6 border-t border-white/5">
                   <div class="flex justify-between text-[10px] font-bold uppercase tracking-widest text-white/40 mb-2">
                      <span>Cost</span>
                      <span>Capacity</span>
                   </div>
                   <div class="flex justify-between text-xs font-bold text-brand-teal mb-6">
                      <span>{event.cost}</span>
                      <span>{event.capacity}</span>
                   </div>
                   <button class="btn btn-secondary w-full !py-2.5 !text-[10px] opacity-50 cursor-not-allowed">
                      Registration Opens June 10
                   </button>
                </div>
              </div>
            </ScrollReveal>
          ))}
       </div>
    </section>

    <!-- Flyer Section -->
    <section class="max-w-4xl mx-auto px-6 py-12">
       <ScrollReveal>
          <div class="glass-card border-white/10 p-4 md:p-8 text-center">
             <span class="text-brand-teal font-bold uppercase tracking-widest text-[10px] mb-6 block">Tournament Overview</span>
             <h2 class="text-2xl font-heading mb-8 text-white">Download the <span class="text-brand-teal italic">Summer Flyer</span></h2>
             <a 
                href="/assets/images/summer vball options.png" 
                download="summer-vball-options.png" 
                class="block group relative overflow-hidden rounded-2xl cursor-pointer"
                title="Click to download flyer"
             >
                <img 
                   src="/assets/images/summer vball options.png" 
                   alt="Summer Volleyball Options Flyer" 
                   class="w-full h-auto transition-transform duration-700 group-hover:scale-[1.03]" 
                />
                <div class="absolute inset-0 bg-brand-teal/20 opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-center justify-center backdrop-blur-[2px] z-10">
                   <div class="bg-white text-zinc-900 px-8 py-3 rounded-full font-bold text-base transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500 shadow-2xl">
                      Download Flyer
                   </div>
                </div>
             </a>
             <p class="mt-8 text-white/40 text-xs italic">Click the image above to download the flyer.</p>
          </div>
       </ScrollReveal>
    </section>

  </main>
</BaseLayout>
