---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { getDb } from '../db';
import { feedback } from '../db/schema';

let submitted = false;
let error = null;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    
    const db = getDb(
      import.meta.env.TURSO_DATABASE_URL || '',
      import.meta.env.TURSO_AUTH_TOKEN || ''
    );

    // Get additional opportunities checkboxes
    const opps = data.getAll('additional_opportunities');
    const oppsString = JSON.stringify(opps);

    await db.insert(feedback).values({
      userType: data.get('user_type') as string,
      team: data.get('team') as string,
      anonymous: data.get('anonymous') as string,
      name: data.get('name') as string,
      overallRating: parseInt(data.get('overall_rating') as string),
      bestParts: data.get('best_parts') as string,
      frustratingParts: data.get('frustrating_parts') as string,
      keepDoing: data.get('keep_doing') as string,
      considerChanging: data.get('consider_changing') as string,
      coachingPositive: parseInt(data.get('coaching_positive') as string),
      coachingGrowth: parseInt(data.get('coaching_growth') as string),
      practicesUseful: parseInt(data.get('practices_useful') as string),
      encouragedProblemSolving: parseInt(data.get('encouraged_problem_solving') as string),
      coachingWell: data.get('coaching_well') as string,
      coachingImprove: data.get('coaching_improve') as string,
      teamEnvironment: data.get('team_environment') as string,
      clubCommunication: parseInt(data.get('club_communication') as string),
      teamCommunication: parseInt(data.get('team_communication') as string),
      easyToUnderstand: parseInt(data.get('easy_to_understand') as string),
      communicationWell: data.get('communication_well') as string,
      communicationImprove: data.get('communication_improve') as string,
      confusionMoments: data.get('confusion_moments') as string,
      goodValue: parseInt(data.get('good_value') as string),
      timeCommitment: parseInt(data.get('time_commitment') as string),
      tournamentSchedule: parseInt(data.get('tournament_schedule') as string),
      betterValue: data.get('better_value') as string,
      unclearLogistics: data.get('unclear_logistics') as string,
      volleyballGrowth: parseInt(data.get('volleyball_growth') as string),
      personalGrowth: parseInt(data.get('personal_growth') as string),
      noticeableGrowth: data.get('noticeable_growth') as string,
      supportNeeded: data.get('support_needed') as string,
      returnLikelihood: parseInt(data.get('return_likelihood') as string),
      returnIncentive: data.get('return_incentive') as string,
      additionalOpportunities: oppsString,
      importantOpportunities: data.get('important_opportunities') as string,
      futureHope: data.get('future_hope') as string,
      leadershipUnderstanding: data.get('leadership_understanding') as string,
      appreciation: data.get('appreciation') as string,
      advice: data.get('advice') as string,
      anythingElse: data.get('anything_else') as string,
    });

    submitted = true;
  } catch (e) {
    console.error(e);
    error = "Something went wrong. Please try again or contact us directly.";
  }
}

const teams = [
  "14 White", "14 Black", "14 Coral", "14 Teal",
  "16 Black", "16 Coral", "16 Teal",
  "18 Black", "18 Coral", "18 Teal",
  "Other / Not sure"
];

const ratings = [1, 2, 3, 4, 5];
---

<BaseLayout title="Season Feedback" description="TVVC Season Feedback - Help us notice, adapt, and grow." noindex={true}>
  <main class="pt-32 pb-24 px-6">
    <div class="max-w-4xl mx-auto">
      <ScrollReveal>
        <div class="text-center mb-16">
          <h1 class="text-4xl md:text-7xl font-heading font-extrabold mb-6 text-white leading-tight uppercase tracking-tight">
            Help Us Notice, <br/><span class="text-brand-teal italic">Adapt, and Grow</span>
          </h1>
          <div class="max-w-2xl mx-auto space-y-4 text-white/60 text-lg leading-relaxed">
            <p>Thank you for being part of TVVC this season.</p>
            <p>We are always trying to build a better club: more connected, more organized, more joyful, more competitive, and slightly less held together by duct tape, caffeine, and Loren’s questionable jokes.</p>
            <p>This form is meant to help us learn what worked, what didn’t, and what we can improve moving forward.</p>
            <p>Please be honest. You do not have to make everything sound nice. We can’t adapt to feedback we never hear.</p>
            <p>Your responses will help us shape future seasons, communication, coaching, events, training, and the overall TVVC experience.</p>
          </div>
        </div>
      </ScrollReveal>

      {submitted ? (
        <ScrollReveal>
          <div class="glass-card border-brand-teal/30 p-12 text-center max-w-2xl mx-auto">
            <div class="w-20 h-20 bg-brand-teal/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-brand-teal"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <h2 class="text-3xl font-heading font-bold text-white mb-4 uppercase tracking-widest">Thank You!</h2>
            <p class="text-white/60 mb-8 leading-relaxed">
              We are not trying to build a perfect club. Perfect is suspicious and usually wearing matching polos. <br/><br/>
              We are trying to build a club that keeps learning, keeps adapting, and keeps getting better for athletes and families.
            </p>
            <p class="text-brand-teal font-bold uppercase tracking-widest text-xs mb-8">Notice. Adapt. Commit.</p>
            <a href="/" class="btn btn-primary px-8">Back to Home</a>
          </div>
        </ScrollReveal>
      ) : (
        <ScrollReveal delay={0.2}>
          <div class="glass-card border-white/10 p-8 md:p-12 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-64 h-64 bg-brand-teal/5 rounded-full blur-[100px] -z-10"></div>
            
            {error && (
              <div class="bg-brand-coral/10 border border-brand-coral/20 text-brand-coral p-6 rounded-2xl mb-12 text-sm font-bold flex items-center gap-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                {error}
              </div>
            )}
            
            <form method="POST" class="space-y-16">
              <!-- Section 1 -->
              <div class="space-y-8">
                <div class="flex items-center gap-4">
                  <span class="w-8 h-8 rounded-full bg-brand-teal text-white flex items-center justify-center font-bold text-xs">1</span>
                  <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest italic">Who Are You?</h2>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal">1. I am filling this out as a…</label>
                    <div class="grid grid-cols-1 gap-2">
                      {["Player", "Parent/Guardian", "Both player and parent together", "Coach", "Other"].map(type => (
                        <label class="flex items-center gap-3 p-3 rounded-xl border border-white/5 bg-white/5 cursor-pointer hover:bg-white/10 transition-colors">
                          <input type="radio" name="user_type" value={type} required class="accent-brand-teal" />
                          <span class="text-sm text-white/70">{type}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <div class="space-y-4">
                    <label for="team" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal">2. Which team were you connected to this season?</label>
                    <select id="team" name="team" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 text-white focus:border-brand-teal outline-none transition-colors appearance-none">
                      <option value="" disabled selected class="bg-brand-charcoal">Select your team</option>
                      {teams.map(t => <option value={t} class="bg-brand-charcoal">{t}</option>)}
                    </select>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-white/5 pt-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal">3. Would you like your feedback to be anonymous?</label>
                    <div class="flex gap-4">
                      {["Yes", "No", "I’m fine either way"].map(opt => (
                        <label class="flex-1 text-center">
                          <input type="radio" name="anonymous" value={opt} required class="sr-only peer" />
                          <div class="py-3 rounded-xl border border-white/10 bg-white/5 cursor-pointer peer-checked:bg-brand-teal peer-checked:border-brand-teal text-xs font-bold text-white/40 peer-checked:text-white transition-all">
                            {opt}
                          </div>
                        </label>
                      ))}
                    </div>
                  </div>
                  <div class="space-y-4">
                    <label for="name" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal">4. Name — optional</label>
                    <input type="text" id="name" name="name" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 text-white focus:border-brand-teal outline-none transition-colors" />
                  </div>
                </div>
              </div>

              <!-- Section 2 -->
              <div class="space-y-8 border-t border-white/5 pt-16">
                <div class="flex items-center gap-4">
                  <span class="w-8 h-8 rounded-full bg-brand-coral text-white flex items-center justify-center font-bold text-xs">2</span>
                  <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest italic">Overall Experience</h2>
                </div>

                <div class="space-y-4">
                  <div class="flex justify-between items-end">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral">5. Overall, how would you rate your TVVC experience this season?</label>
                    <div class="flex gap-4 text-[10px] font-bold uppercase text-white/30 tracking-widest">
                      <span>1 = Not Good</span>
                      <span>5 = Excellent</span>
                    </div>
                  </div>
                  <div class="flex gap-2">
                    {ratings.map(num => (
                      <label class="flex-1">
                        <input type="radio" name="overall_rating" value={num} required class="sr-only peer" />
                        <div class="text-center py-4 rounded-xl border border-white/10 bg-white/5 cursor-pointer peer-checked:bg-brand-coral peer-checked:border-brand-coral text-white font-bold transition-all hover:scale-105">
                          {num}
                        </div>
                      </label>
                    ))}
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div class="space-y-4">
                    <label for="best_parts" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral">6. What were the best parts of your TVVC experience this season?</label>
                    <textarea id="best_parts" name="best_parts" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-coral outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label for="frustrating_parts" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral">7. What were the most frustrating or disappointing parts of your TVVC experience this season?</label>
                    <textarea id="frustrating_parts" name="frustrating_parts" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-coral outline-none transition-colors"></textarea>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div class="space-y-4">
                    <label for="keep_doing" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral">8. What is one thing TVVC should absolutely keep doing?</label>
                    <textarea id="keep_doing" name="keep_doing" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-coral outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label for="consider_changing" class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral">9. What is one thing TVVC should seriously consider changing?</label>
                    <textarea id="consider_changing" name="consider_changing" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-coral outline-none transition-colors"></textarea>
                  </div>
                </div>
              </div>

              <!-- Section 3 -->
              <div class="space-y-8 border-t border-white/5 pt-16">
                <div class="flex items-center gap-4">
                  <span class="w-8 h-8 rounded-full bg-brand-teal text-white flex items-center justify-center font-bold text-xs">3</span>
                  <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest italic">Coaching & Team Environment</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                  {[
                    { label: "10. The coaching environment felt positive and supportive.", name: "coaching_positive", sub: "1 = Strongly disagree | 5 = Strongly agree" },
                    { label: "11. The coaching helped players grow in confidence, skill, decision-making, and competitiveness.", name: "coaching_growth" },
                    { label: "12. Practices felt useful, engaging, and connected to the actual game.", name: "practices_useful" },
                    { label: "13. Players were encouraged to problem-solve, compete, and adapt.", name: "encouraged_problem_solving" }
                  ].map(q => (
                    <div class="space-y-4">
                      <div class="flex flex-col gap-1">
                        <label class="block text-sm font-bold text-white/80 leading-tight">{q.label}</label>
                        {q.sub && <span class="text-[9px] uppercase tracking-widest text-white/30 font-bold">{q.sub}</span>}
                      </div>
                      <div class="flex gap-2">
                        {ratings.map(num => (
                          <label class="flex-1">
                            <input type="radio" name={q.name} value={num} required class="sr-only peer" />
                            <div class="text-center py-2 rounded-lg border border-white/10 bg-white/5 cursor-pointer peer-checked:bg-brand-teal text-xs font-bold text-white transition-all">
                              {num}
                            </div>
                          </label>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal">14. What did your coach or coaching staff do well?</label>
                    <textarea name="coaching_well" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-teal outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal">15. What could the coaching staff improve next season?</label>
                    <textarea name="coaching_improve" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-teal outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal">16. Did the team environment feel healthy and connected? Why or why not?</label>
                    <textarea name="team_environment" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-teal outline-none transition-colors"></textarea>
                  </div>
                </div>
              </div>

              <!-- Section 4 -->
              <div class="space-y-8 border-t border-white/5 pt-16">
                <div class="flex items-center gap-4">
                  <span class="w-8 h-8 rounded-full bg-white text-brand-charcoal flex items-center justify-center font-bold text-xs">4</span>
                  <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest italic">Communication & Organization</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                  {[
                    { label: "17. Club communication was clear and timely.", name: "club_communication" },
                    { label: "18. Team communication was clear and timely.", name: "team_communication" },
                    { label: "19. Schedules, tournaments, payments, events, and expectations were easy to understand.", name: "easy_to_understand" }
                  ].map(q => (
                    <div class="space-y-4">
                      <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-white/50 leading-relaxed">{q.label}</label>
                      <div class="flex gap-1">
                        {ratings.map(num => (
                          <label class="flex-1">
                            <input type="radio" name={q.name} value={num} required class="sr-only peer" />
                            <div class="text-center py-2 rounded bg-white/5 border border-white/5 cursor-pointer peer-checked:bg-white peer-checked:text-brand-charcoal text-[10px] font-bold transition-all">
                              {num}
                            </div>
                          </label>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">20. What communication worked well?</label>
                    <textarea name="communication_well" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">21. What communication needs to improve?</label>
                    <textarea name="communication_improve" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">22. Were there any moments where you felt confused, out of the loop, or unsure what was happening?</label>
                    <textarea name="confusion_moments" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                </div>
              </div>

              <!-- Section 5 -->
              <div class="space-y-8 border-t border-white/5 pt-16">
                <div class="flex items-center gap-4">
                  <span class="w-8 h-8 rounded-full bg-brand-coral text-white flex items-center justify-center font-bold text-xs">5</span>
                  <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest italic">Cost, Value, and Club Experience</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                  {[
                    { label: "23. TVVC provided good value for the cost.", name: "good_value" },
                    { label: "24. The time commitment felt reasonable.", name: "time_commitment" },
                    { label: "25. The tournament schedule felt appropriate for our club model.", name: "tournament_schedule" }
                  ].map(q => (
                    <div class="space-y-4">
                      <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral/50 leading-relaxed">{q.label}</label>
                      <div class="flex gap-2">
                        {ratings.map(num => (
                          <label class="flex-1">
                            <input type="radio" name={q.name} value={num} required class="sr-only peer" />
                            <div class="text-center py-3 rounded-xl border border-white/10 bg-white/5 cursor-pointer peer-checked:bg-brand-coral text-xs font-bold text-white transition-all">
                              {num}
                            </div>
                          </label>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral/30">26. What would make TVVC feel like an even better value for families?</label>
                    <textarea name="better_value" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-coral outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral/30">27. Were there any costs, expectations, or logistics that felt unclear or difficult?</label>
                    <textarea name="unclear_logistics" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-coral outline-none transition-colors"></textarea>
                  </div>
                </div>
              </div>

              <!-- Section 6 -->
              <div class="space-y-8 border-t border-white/5 pt-16">
                <div class="flex items-center gap-4">
                  <span class="w-8 h-8 rounded-full bg-brand-teal text-white flex items-center justify-center font-bold text-xs">6</span>
                  <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest italic">Player Growth</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                  {[
                    { label: "28. This season helped the player grow as a volleyball player.", name: "volleyball_growth" },
                    { label: "29. This season helped the player grow in confidence, resilience, leadership, or connection.", name: "personal_growth" }
                  ].map(q => (
                    <div class="space-y-4">
                      <label class="block text-sm font-bold text-white/80 leading-tight">{q.label}</label>
                      <div class="flex gap-2">
                        {ratings.map(num => (
                          <label class="flex-1">
                            <input type="radio" name={q.name} value={num} required class="sr-only peer" />
                            <div class="text-center py-3 rounded-xl border border-white/10 bg-white/5 cursor-pointer peer-checked:bg-brand-teal text-xs font-bold text-white transition-all">
                              {num}
                            </div>
                          </label>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal/30">30. What growth did you notice this season?</label>
                    <textarea name="noticeable_growth" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-teal outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal/30">31. What areas still need more support?</label>
                    <textarea name="support_needed" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white focus:border-brand-teal outline-none transition-colors"></textarea>
                  </div>
                </div>
              </div>

              <!-- Section 7 -->
              <div class="space-y-8 border-t border-white/5 pt-16">
                <div class="flex items-center gap-4">
                  <span class="w-8 h-8 rounded-full bg-brand-coral text-white flex items-center justify-center font-bold text-xs">7</span>
                  <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest italic">Future Direction</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                  <div class="space-y-4">
                    <div class="flex justify-between items-end">
                      <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral">32. How likely are you to return to TVVC next season?</label>
                      <div class="flex gap-4 text-[10px] font-bold uppercase text-white/30 tracking-widest">
                        <span>1 = Unlikely</span>
                        <span>5 = Very likely</span>
                      </div>
                    </div>
                    <div class="flex gap-2">
                      {ratings.map(num => (
                        <label class="flex-1">
                          <input type="radio" name="return_likelihood" value={num} required class="sr-only peer" />
                          <div class="text-center py-4 rounded-xl border border-white/10 bg-white/5 cursor-pointer peer-checked:bg-brand-coral peer-checked:border-brand-coral text-white font-bold transition-all">
                            {num}
                          </div>
                        </label>
                      ))}
                    </div>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-coral/50">33. What would make you more likely to return?</label>
                    <textarea name="return_incentive" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                </div>

                <div class="space-y-6 pt-8">
                  <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal">34. What additional opportunities would you like TVVC to consider offering? (Select all that apply)</label>
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    {[
                      "Out-of-state travel tournament opportunities for top teams", "More tournaments overall", 
                      "Beach or grass doubles league/training", "Strength and movement training",
                      "More position-specific clinics", "More small group training opportunities",
                      "More open gyms", "Recruiting education for older athletes/families",
                      "Parent education sessions", "Youth beginner programs", "Other"
                    ].map(opt => (
                      <label class="flex items-center gap-3 p-4 rounded-xl border border-white/5 bg-white/5 cursor-pointer hover:bg-brand-teal/5 hover:border-brand-teal/20 transition-all">
                        <input type="checkbox" name="additional_opportunities" value={opt} class="accent-brand-teal w-5 h-5" />
                        <span class="text-xs text-white/60 font-bold leading-tight">{opt}</span>
                      </label>
                    ))}
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal/30">35. If you selected any of the above, which ones feel most important to you and why?</label>
                    <textarea name="important_opportunities" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal/30">36. What do you hope TVVC becomes over the next few years?</label>
                    <textarea name="future_hope" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                </div>
              </div>

              <!-- Section 8 -->
              <div class="space-y-8 border-t border-white/5 pt-16">
                <div class="flex items-center gap-4">
                  <span class="w-8 h-8 rounded-full bg-white text-brand-charcoal flex items-center justify-center font-bold text-xs">8</span>
                  <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest italic">Final Thoughts</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">37. What is something you wish TVVC leadership understood better?</label>
                    <textarea name="leadership_understanding" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">38. What is something you appreciated that maybe didn’t get said enough?</label>
                    <textarea name="appreciation" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">39. If you could give Loren and the TVVC staff one piece of advice, what would it be?</label>
                    <textarea name="advice" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                  <div class="space-y-4">
                    <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">40. Anything else you want us to know?</label>
                    <textarea name="anything_else" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-4 py-4 text-white outline-none transition-colors"></textarea>
                  </div>
                </div>
              </div>

              <div class="pt-16 border-t border-white/5">
                <div class="text-center mb-12 space-y-6">
                  <p class="text-white/60 text-sm leading-relaxed max-w-xl mx-auto italic">
                    We are not trying to build a perfect club. Perfect is suspicious and usually wearing matching polos. <br/>
                    We are trying to build a club that keeps learning, keeps adapting, and keeps getting better for athletes and families.
                  </p>
                  <p class="text-brand-teal font-bold uppercase tracking-[0.3em] text-xs">Notice. Adapt. Commit.</p>
                </div>
                <button type="submit" class="btn btn-primary w-full py-6 text-xl uppercase tracking-widest font-heading font-extrabold shadow-glow-teal hover:scale-[1.01] transition-all">Submit Feedback</button>
              </div>
            </form>
          </div>
        </ScrollReveal>
      )}
    </div>
  </main>
</BaseLayout>
