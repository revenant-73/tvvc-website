---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import FeedbackForm from '../components/feedback/FeedbackForm';
import { getDb } from '../db';
import { feedback } from '../db/schema';

let submitted = false;
let error = null;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    
    const db = getDb(
      import.meta.env.TURSO_DATABASE_URL || '',
      import.meta.env.TURSO_AUTH_TOKEN || ''
    );

    // Get additional opportunities checkboxes
    const opps = data.getAll('additional_opportunities');
    const oppsString = JSON.stringify(opps);

    await db.insert(feedback).values({
      userType: data.get('user_type') as string,
      team: data.get('team') as string,
      anonymous: "No",
      name: data.get('name') as string,
      overallRating: parseInt(data.get('overall_rating') as string),
      bestParts: data.get('best_parts') as string,
      frustratingParts: data.get('frustrating_parts') as string,
      keepDoing: data.get('keep_doing') as string,
      considerChanging: data.get('consider_changing') as string,
      coachingPositive: parseInt(data.get('coaching_positive') as string),
      coachingGrowth: parseInt(data.get('coaching_growth') as string),
      practicesUseful: parseInt(data.get('practices_useful') as string),
      encouragedProblemSolving: parseInt(data.get('encouraged_problem_solving') as string),
      coachingWell: data.get('coaching_well') as string,
      coachingImprove: data.get('coaching_improve') as string,
      teamEnvironment: data.get('team_environment') as string,
      clubCommunication: parseInt(data.get('club_communication') as string),
      teamCommunication: parseInt(data.get('team_communication') as string),
      easyToUnderstand: parseInt(data.get('easy_to_understand') as string),
      communicationWell: data.get('communication_well') as string,
      communicationImprove: data.get('communication_improve') as string,
      confusionMoments: data.get('confusion_moments') as string,
      goodValue: parseInt(data.get('good_value') as string),
      timeCommitment: parseInt(data.get('time_commitment') as string),
      tournamentSchedule: parseInt(data.get('tournament_schedule') as string),
      betterValue: data.get('better_value') as string,
      unclearLogistics: data.get('unclear_logistics') as string,
      volleyballGrowth: parseInt(data.get('volleyball_growth') as string),
      personalGrowth: parseInt(data.get('personal_growth') as string),
      noticeableGrowth: data.get('noticeable_growth') as string,
      supportNeeded: data.get('support_needed') as string,
      returnLikelihood: parseInt(data.get('return_likelihood') as string),
      returnIncentive: data.get('return_incentive') as string,
      additionalOpportunities: oppsString,
      importantOpportunities: data.get('important_opportunities') as string,
      futureHope: data.get('future_hope') as string,
      leadershipUnderstanding: data.get('leadership_understanding') as string,
      appreciation: data.get('appreciation') as string,
      advice: data.get('advice') as string,
      anythingElse: data.get('anything_else') as string,
    });

    submitted = true;
  } catch (e) {
    console.error(e);
    error = "Something went wrong. Please try again or contact us directly.";
  }
}
---

<BaseLayout title="Season Feedback" description="TVVC Season Feedback - Help us notice, adapt, and grow." noindex={true}>
  <main class="pt-24 md:pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-4xl mx-auto relative">
      <div class="absolute -top-12 right-0 opacity-10 hover:opacity-100 transition-opacity">
        <a href="/admin/feedback" class="text-white">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </a>
      </div>
      <ScrollReveal>
        <div class="text-center mb-12 md:mb-16">
          <h1 class="text-4xl md:text-7xl font-heading font-extrabold mb-6 text-white leading-tight uppercase tracking-tight">
            Help Us Notice, <br class="hidden sm:block"/><span class="text-brand-teal italic">Adapt, and Grow</span>
          </h1>
          <div class="max-w-2xl mx-auto space-y-4 text-white/60 text-lg leading-relaxed">
            <p>Thank you for being part of TVVC this season.</p>
            <p>We are always trying to build a better club: more connected, more organized, more joyful, more competitive, and slightly less held together by duct tape, caffeine, and Loren’s questionable jokes.</p>
            <p>This form is meant to help us learn what worked, what didn’t, and what we can improve moving forward.</p>
            <p>Please be honest. You do not have to make everything sound nice. We can’t adapt to feedback we never hear.</p>
            <p>Your responses will help us shape future seasons, communication, coaching, events, training, and the overall TVVC experience.</p>
          </div>
        </div>
      </ScrollReveal>

      {submitted ? (
        <ScrollReveal>
          <div class="glass-card border-brand-teal/30 p-12 text-center max-w-2xl mx-auto">
            <div class="w-20 h-20 bg-brand-teal/20 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-brand-teal"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <h2 class="text-3xl font-heading font-bold text-white mb-4 uppercase tracking-widest">Thank You!</h2>
            <p class="text-white/60 mb-8 leading-relaxed">
              We are not trying to build a perfect club. Perfect is suspicious and usually wearing matching polos. <br/><br/>
              We are trying to build a club that keeps learning, keeps adapting, and keeps getting better for athletes and families.
            </p>
            <p class="text-brand-teal font-bold uppercase tracking-widest text-xs mb-8">Notice. Adapt. Commit.</p>
            <a href="/" class="btn btn-primary px-8">Back to Home</a>
          </div>
        </ScrollReveal>
      ) : (
        <FeedbackForm client:load />
      )}
    </div>
  </main>
</BaseLayout>
