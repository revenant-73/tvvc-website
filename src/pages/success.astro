---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Registration Successful">
  <main class="pt-48 pb-24 px-6 text-center">
    <div class="max-w-2xl mx-auto space-y-8">
      <div class="w-24 h-24 bg-brand-teal/20 rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-teal/30">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-brand-teal"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      
      <h1 class="text-4xl md:text-6xl font-heading font-extrabold text-white uppercase leading-tight">
        You're <span class="text-brand-teal italic">In!</span>
      </h1>
      
      <p class="text-white/60 text-lg leading-relaxed">
        Thank you for registering with TVVC. A confirmation email has been sent to your inbox via Stripe.
      </p>

      <div class="glass-card border-white/5 p-8 space-y-4">
        <h2 class="text-sm font-bold uppercase tracking-widest text-white/40">What's Next?</h2>
        <ul className="text-left text-sm text-white/80 space-y-3 max-w-sm mx-auto">
          <li className="flex items-start gap-3">
            <span className="text-brand-teal font-bold">1.</span>
            <span>Check your email for the payment receipt.</span>
          </li>
          <li className="flex items-start gap-3">
            <span className="text-brand-teal font-bold">2.</span>
            <span>Add the camp/clinic dates to your calendar.</span>
          </li>
          <li className="flex items-start gap-3">
            <span className="text-brand-teal font-bold">3.</span>
            <span>We'll reach out via email with specific check-in details 1 week before the event.</span>
          </li>
        </ul>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center pt-8">
        <a href="/" class="btn btn-secondary px-10">Back to Home</a>
        <a href="/summer-camps-clinics" class="btn border border-white/10 hover:border-brand-teal transition-colors px-10">View Schedule</a>
      </div>

      <p class="text-[10px] text-white/20 uppercase tracking-[0.2em] font-bold pt-12">
        Questions? Text Loren at 503-389-0760
      </p>
    </div>
  </main>
</BaseLayout>
