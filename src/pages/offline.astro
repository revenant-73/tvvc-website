---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Offline">
  <main class="min-h-screen flex items-center justify-center px-6 text-center">
    <div>
      <h1 class="text-4xl md:text-6xl font-syne font-black uppercase mb-6 text-brand-teal">You're Offline</h1>
      <p class="text-white/60 mb-12 max-w-md mx-auto">
        It looks like you don't have an internet connection right now. Please check your connection and try again.
      </p>
      <a href="/portal" class="btn btn-primary px-10">Try Again</a>
    </div>
  </main>
</BaseLayout>
