---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { Image } from 'astro:assets';
import motionIcon from '../assets/images/volleyball-in-motion-icon.png';
---

<BaseLayout title="Small Group Volleyball Training" description="Train the skill inside the game. TVVC small group training built around game-representative learning in Hillsboro, OR.">
  <main class="pt-32 pb-24">
    <!-- Hero Section -->
    <section class="px-6 py-20 relative text-center md:text-left">
      <div class="max-w-6xl mx-auto">
        <span class="text-brand-teal font-bold uppercase tracking-widest text-xs mb-4 block">Small Group Training</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold mb-6 leading-tight text-white uppercase tracking-tighter">
          Train the Skill <br class="hidden md:block" /> <span class="text-brand-teal italic">Inside the Game</span>
        </h1>
        <p class="text-lg md:text-xl text-white/60 max-w-2xl leading-relaxed mb-10">
          Volleyball is not a script. The ball changes. The space changes. The pressure changes. The game keeps asking new questions.
        </p>
        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
          <a href="/training/book" class="btn btn-primary !px-12 !py-4">Book a Training Block</a>
          <a href="#philosophy" class="btn btn-secondary !px-8 !py-4">Our Philosophy</a>
        </div>
      </div>
    </section>

    <!-- Core Philosophy Section -->
    <section id="philosophy" class="max-w-6xl mx-auto px-6 py-24 border-y border-white/5 scroll-mt-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <ScrollReveal>
          <div class="space-y-6">
            <h2 class="text-3xl md:text-5xl font-heading font-bold text-white uppercase tracking-tight">Why Small Group <span class="text-brand-teal italic">Training?</span></h2>
            <p class="text-white/60 leading-relaxed text-lg">
              That is why TVVC small group training is built around game-representative learning. We do not just want players to perform a skill in a perfect, predictable drill. 
            </p>
            <p class="text-white/60 leading-relaxed text-lg">
              We want players to learn how to use their skills in the moments that actually matter: reading the play, making decisions, adjusting to the ball, competing with purpose, and solving the game.
            </p>
            <div class="pt-4">
               <div class="glass-card bg-brand-teal/5 border-brand-teal/20 p-8">
                  <p class="text-white font-bold italic text-lg leading-relaxed">
                    "The goal is not just cleaner technique. <br />The goal is better volleyball."
                  </p>
               </div>
            </div>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.2}>
          <div class="glass-card border-white/10 p-8 md:p-12 space-y-8">
            <div class="flex items-center gap-4 mb-4">
              <Image src={motionIcon} alt="" class="w-20 h-20 object-contain opacity-80" width={80} height={80} loading="lazy" />
              <h3 class="text-xl font-heading font-bold text-white uppercase tracking-widest">What We Work On</h3>
            </div>
            <p class="text-white/40 text-sm">Small group training gives players more touches, more feedback, and more chances to learn in realistic situations.</p>
            
            <ul class="space-y-4">
              {[
                'Serving with purpose',
                'Serve receive and first contact',
                'Attacking with vision and intent',
                'Defensive reading and reaction',
                'Setting decision-making',
                'Communication and court awareness',
                'Confidence, focus, and next-ball response'
              ].map(item => (
                <li class="flex items-center gap-3 text-white/80">
                  <svg class="w-5 h-5 text-brand-teal shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-sm font-medium uppercase tracking-wide">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <!-- Training Experience -->
    <section class="py-32 bg-white/[0.02]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
          <div class="order-2 lg:order-1">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="glass-card border-white/5 p-6 space-y-3">
                <h4 class="text-brand-teal font-bold uppercase text-xs tracking-widest">Notice</h4>
                <p class="text-white/40 text-xs leading-relaxed">Players are asked to observe what is happening on the other side of the net.</p>
              </div>
              <div class="glass-card border-white/5 p-6 space-y-3">
                <h4 class="text-brand-teal font-bold uppercase text-xs tracking-widest">Adapt</h4>
                <p class="text-white/40 text-xs leading-relaxed">Adjusting movement and technique to the specific situation.</p>
              </div>
              <div class="glass-card border-white/5 p-6 space-y-3">
                <h4 class="text-brand-teal font-bold uppercase text-xs tracking-widest">Commit</h4>
                <p class="text-white/40 text-xs leading-relaxed">Taking decisive action on the next ball with purpose.</p>
              </div>
              <div class="glass-card border-white/5 p-6 space-y-3">
                <h4 class="text-brand-teal font-bold uppercase text-xs tracking-widest">Learn</h4>
                <p class="text-white/40 text-xs leading-relaxed">Using mistakes as information to grow and improve.</p>
              </div>
            </div>
          </div>
          <div class="space-y-8 order-1 lg:order-2">
            <h2 class="text-3xl md:text-5xl font-heading font-bold text-white uppercase tracking-tight">What Training <span class="text-brand-teal italic">Looks Like</span></h2>
            <div class="space-y-6 text-white/60 leading-relaxed">
              <p>Every session is designed around the player or group in front of us. Some sessions may include focused technical work. Some may be more game-like. Most will include a blend of both.</p>
              <p>Mistakes are not a problem here. They are information. That is how players grow.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Private Lessons Callout -->
    <section class="max-w-4xl mx-auto px-6 py-24 text-center">
      <ScrollReveal>
        <div class="glass-card border-white/10 p-12 space-y-8">
          <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-widest">Private Lessons Are Still Available</h2>
          <div class="space-y-6 text-white/60 text-sm leading-relaxed max-w-2xl mx-auto">
            <p>Some players want or need one-on-one attention. That is completely fine. Private lessons can be helpful for players who are brand new, working through a specific skill issue, rebuilding confidence, or wanting more individual feedback.</p>
            <p class="text-white font-medium italic">But whenever possible, we encourage small group training because volleyball is a game of reads, decisions, timing, spacing, communication, and pressure. Those things are easier to train when another player is involved.</p>
          </div>
        </div>
      </ScrollReveal>
    </section>

    <!-- Pricing / Details -->
    <section class="bg-brand-teal/5 py-32 border-y border-brand-teal/10">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-6xl font-heading font-bold text-white uppercase tracking-tight mb-4">Training Block <span class="text-brand-teal italic">Details</span></h2>
          <p class="text-white/40 text-xs uppercase tracking-[0.3em] font-bold">Simple, transparent pricing for any group size</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
          <div class="glass-card border-brand-teal/20 p-10 flex flex-col justify-center text-center md:text-left">
            <div class="mb-8">
              <span class="text-[10px] font-bold text-brand-teal uppercase tracking-[0.2em] mb-2 block">Investment</span>
              <div class="text-6xl font-heading font-bold text-white">$80 <span class="text-sm font-normal text-white/40 uppercase tracking-widest">/ block</span></div>
            </div>
            <ul class="space-y-4 mb-10 text-white/70 text-sm">
              <li class="flex items-center gap-3 justify-center md:justify-start">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-teal"></span>
                1–4 players maximum per block
              </li>
              <li class="flex items-center gap-3 justify-center md:justify-start">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-teal"></span>
                Book for an individual or a small group
              </li>
              <li class="flex items-center gap-3 justify-center md:justify-start">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-teal"></span>
                Fixed cost regardless of player count
              </li>
            </ul>
            <a href="/training/book" class="btn btn-primary w-full !py-5 uppercase tracking-widest font-bold">Book a Training Block</a>
          </div>

          <div class="glass-card border-white/5 p-10 space-y-8">
            <div class="space-y-6">
              <h3 class="text-lg font-bold text-white uppercase tracking-widest">Best Fit For</h3>
              <p class="text-white/40 text-xs leading-relaxed uppercase tracking-wider font-bold">TVVC training blocks are a good fit for players who want to:</p>
              <ul class="grid grid-cols-1 gap-3">
                {[
                  'Get more confident',
                  'Prepare for tryouts',
                  'Improve specific skills',
                  'Learn to read the game',
                  'Build consistency',
                  'Train in a positive gym'
                ].map(item => (
                  <li class="bg-white/5 border border-white/5 rounded-lg px-4 py-2 text-[10px] font-bold uppercase tracking-widest text-white/60">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
            <div class="pt-6 border-t border-white/5">
              <p class="text-[10px] text-white/40 italic leading-relaxed">
                * If your player is solo and would like to join others, we can try to help arrange a group, but placement is not guaranteed.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="max-w-4xl mx-auto px-6 py-32 text-center">
      <ScrollReveal>
        <div class="space-y-10">
          <div class="space-y-4">
            <h2 class="text-3xl md:text-5xl font-heading font-extrabold text-white uppercase tracking-tight">A Better <span class="text-brand-teal italic">Way to Train</span></h2>
            <p class="text-lg text-white/60 leading-relaxed max-w-2xl mx-auto">
              We want players to leave training feeling like they understand the game a little more than when they walked in.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-xl mx-auto text-left">
            <div class="glass-card border-white/5 p-6">
               <p class="text-[10px] font-bold text-white/30 uppercase tracking-widest mb-4">Old Way</p>
               <p class="text-sm font-medium text-white/60 italic">"Did I do the skill right?"</p>
            </div>
            <div class="glass-card border-brand-teal/20 p-6">
               <p class="text-[10px] font-bold text-brand-teal uppercase tracking-widest mb-4">TVVC Way</p>
               <div class="space-y-2">
                 <p class="text-sm font-bold text-white">"What did I notice?"</p>
                 <p class="text-sm font-bold text-white">"What choice did I make?"</p>
               </div>
            </div>
          </div>

          <div class="pt-12">
            <h3 class="text-2xl font-heading font-bold text-white mb-6 uppercase">Ready to Train?</h3>
            <p class="text-white/40 text-sm max-w-lg mx-auto mb-10">
              Bring effort. Bring curiosity. Bring a willingness to make mistakes and learn from them. We will bring the volleyball problems. You solve the game.
            </p>
            <a href="/training/book" class="btn btn-primary !px-16 !py-5 uppercase tracking-widest font-bold">Book a Training Block</a>
          </div>
        </div>
      </ScrollReveal>
    </section>
  </main>
</BaseLayout>
