---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import TryoutRegistrationForm from '../../components/registration/TryoutRegistrationForm';
import { getSession } from 'auth-astro/server';
import { db } from '../../db/db';
import { events, athletes, registrations, users } from '../../db/schema';
import { asc, and, eq, or } from 'drizzle-orm';

let session = null;
try {
  session = await getSession(Astro.request);
} catch (e) {
  console.error('Failed to get session:', e);
}

const now = new Date();

let tryoutEvents = [];
let userAthletes = [];
let error = null;

try {
  if (db) {
    const results = await db.select().from(events).where(and(eq(events.type, 'tryout'), eq(events.active, true)));
    
    // Filter out past events
    tryoutEvents = results.filter(e => {
      if (!e.startDate) return true;
      const eventDate = new Date(e.startDate);
      return eventDate >= now || eventDate.toDateString() === now.toDateString();
    });

    if (session?.user?.email) {
      // Fetch user profile
      const [dbUser] = await db.select({
        id: users.id,
        emergencyPhone: users.emergencyPhone,
      })
      .from(users)
      .where(eq(users.email, session.user.email))
      .limit(1);

      const userId = dbUser?.id || (session.user as any).id;

      if (dbUser?.emergencyPhone) {
        (session.user as any).emergencyPhone = dbUser.emergencyPhone;
      }

      userAthletes = await db.select({
        id: athletes.id,
        firstName: athletes.firstName,
        lastName: athletes.lastName,
        preferredName: athletes.preferredName,
        dateOfBirth: athletes.dateOfBirth,
        gender: athletes.gender,
        grade: athletes.grade,
        school: athletes.school,
        gradYear: athletes.gradYear,
        experience: athletes.experience,
        jerseySize: athletes.jerseySize,
        medicalInfo: athletes.medicalInfo,
        waiverAgreed: athletes.waiverAgreed,
      })
      .from(athletes)
      .leftJoin(registrations, eq(athletes.registrationId, registrations.id))
      .where(
        or(
          eq(registrations.parentEmail, session.user.email),
          eq(athletes.parentId, userId)
        )
      )
      .groupBy(athletes.id);
    }
  }
} catch (e) {
  console.error("Database Error:", e);
  error = "We're experiencing a technical issue loading the registration data. Please try again later or contact Loren at 503-389-0760.";
}
---

<BaseLayout 
  title="Tryout Registration" 
  description="Register for TVVC 2026-2027 Club Season Tryouts in Hillsboro, OR."
  og={{
    title: "Club Tryouts 2026-2027",
    description: "Register now for the upcoming club season.",
    badge: "Registration Open"
  }}
>
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-brand-teal font-bold uppercase tracking-[0.2em] text-[10px] mb-4 block">2026-2027 Club Season</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold text-white uppercase mb-6 leading-tight">
          Tryout <span class="text-brand-teal italic text-5xl md:text-8xl">Registration</span>
        </h1>
        <p class="text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
          Complete the form below to register your athlete for our upcoming club season tryouts.
        </p>
      </div>

      {error ? (
        <div class="glass-card p-12 text-center border-brand-coral/20">
          <p class="text-brand-coral font-bold mb-4">{error}</p>
          <a href="/" class="btn btn-secondary">Back to Home</a>
        </div>
      ) : (
        <TryoutRegistrationForm client:load initialEvents={tryoutEvents} userAthletes={userAthletes} currentUser={session?.user} />
      )}
      
      <div class="mt-20 pt-12 border-t border-white/5 text-center">
        <p class="text-white/40 text-xs uppercase tracking-widest font-bold">Have questions about tryouts?</p>
        <a href="/faq" class="text-brand-teal font-bold hover:underline mt-2 inline-block">Check our FAQ</a>
      </div>
    </div>
  </main>
</BaseLayout>
