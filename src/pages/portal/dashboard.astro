---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSession } from 'auth-astro/server';
import { db } from '../../db/db';
import { registrations, registrationItems, events, athletes, playerProfiles } from '../../db/schema';
import { eq, desc, and, or, gte, inArray, isNull } from 'drizzle-orm';
import { ensurePortalAccessContext } from '../../lib/portal-ownership';
import { getPortalClubSeasonPlans } from '../../lib/club-season-portal';

const session = await getSession(Astro.request);

if (!session) {
  return Astro.redirect('/portal/login');
}

const user = session.user;
const access = await ensurePortalAccessContext(user);
if (!access) {
  return Astro.redirect('/portal/login');
}
const userId = access.user.id;
const clubSeasonPlans = await getPortalClubSeasonPlans(db, access.readableOwnerIds, userId);

const clubDateParts = new Intl.DateTimeFormat('en-US', {
  timeZone: 'America/Los_Angeles',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).formatToParts(new Date());
const clubDate = {
  year: clubDateParts.find((part) => part.type === 'year')?.value,
  month: clubDateParts.find((part) => part.type === 'month')?.value,
  day: clubDateParts.find((part) => part.type === 'day')?.value,
};
const today = `${clubDate.year}-${clubDate.month}-${clubDate.day}`;

// Fetch purchase history for the logged-in user
const userRegistrations = await db.select({
  id: registrations.id,
  ownerUserId: registrations.userId,
  parentName: registrations.parentName,
  status: registrations.status,
  totalAmount: registrations.totalAmount,
  createdAt: registrations.createdAt,
})
.from(registrations)
.where(inArray(registrations.userId, access.readableOwnerIds))
.orderBy(desc(registrations.createdAt));

// Fetch upcoming events for this user's athletes
const upcomingEvents = await db.select({
  id: events.id,
  name: events.name,
  type: events.type,
  dateInfo: events.dateInfo,
  timeInfo: events.timeInfo,
  startDate: events.startDate,
  athleteFirstName: athletes.firstName,
  athleteLastName: athletes.lastName,
})
.from(registrationItems)
.innerJoin(events, eq(registrationItems.eventId, events.id))
.innerJoin(registrations, eq(registrationItems.registrationId, registrations.id))
.innerJoin(athletes, eq(registrationItems.athleteId, athletes.id))
.where(
  and(
    inArray(registrations.userId, access.readableOwnerIds),
    eq(registrations.status, 'paid'),
    eq(events.active, true),
    or(
      gte(events.startDate, today),
      gte(events.endDate, today)
    )
  )
)
.orderBy(events.startDate);

// Fetch player profiles linked to this canonical parent account.
const userAthletes = await db.select({
  id: playerProfiles.id,
  firstName: playerProfiles.firstName,
  lastName: playerProfiles.lastName,
  grade: playerProfiles.grade,
  ownerUserId: playerProfiles.parentId,
})
.from(playerProfiles)
.where(and(
  inArray(playerProfiles.parentId, access.readableOwnerIds),
  isNull(playerProfiles.archivedAt),
  isNull(playerProfiles.mergedIntoProfileId)
))
.groupBy(playerProfiles.id);

const formatCurrency = (cents: number) => {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
};

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return 'N/A';
  return new Date(dateStr).toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'short', 
    day: 'numeric' 
  });
};

const formatClubDate = (dateStr: string | null) => {
  if (!dateStr) return 'Not available';
  return new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${dateStr.slice(0, 10)}T12:00:00Z`));
};

const paymentOptionLabel = (option: string) => ({
  standard_plan: 'Standard plan',
  custom_plan: 'Custom plan',
  pay_in_full: 'Paid in full',
}[option] || 'Payment plan');

const installmentTypeLabel = (type: string) => ({
  deposit: 'Deposit',
  installment: 'Automatic payment',
  full_payment: 'Full season payment',
}[type] || 'Payment');

const installmentStatusLabel = (status: string) => ({
  paid: 'Paid',
  satisfied: 'Satisfied',
  scheduled: 'Scheduled',
  past_due: 'Past due',
  action_required: 'Action required',
  cancelled: 'Cancelled',
}[status] || status.replaceAll('_', ' '));

const financialStatusLabel = (status: string, remainingBalance: number) => {
  if (remainingBalance === 0) return 'Paid in full';
  if (status === 'action_required') return 'Action required';
  if (status === 'past_due') return 'Past due';
  return 'Current';
};

const registrationStatusLabel = (status: string) => ({
  active: 'Active registration',
  paid: 'Registration paid',
  paid_in_full: 'Registration complete',
}[status] || 'Registration confirmed');

const hasOwnRegistrations = userRegistrations.some(
  (registration) => registration.ownerUserId === userId
);
---

<BaseLayout title="Customer Dashboard" noindex={true}>
  <main class="pt-32 pb-20 px-4 max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
      <div>
        <h1 class="text-4xl font-heading font-black uppercase tracking-tight mb-2">
          Welcome, <span class="text-brand-teal">{user.name || user.email?.split('@')[0]}</span>
        </h1>
        <p class="text-white/40 font-medium">Manage your registrations and player profiles.</p>
      </div>
      
      <div class="flex gap-4">
        {(user as any).role === 'admin' && (
          <a href="/admin" class="bg-brand-teal text-brand-charcoal px-6 py-3 rounded-2xl font-bold text-sm uppercase tracking-widest hover:bg-brand-teal/80 transition-colors">
            Admin Portal
          </a>
        )}
        <a href="/portal/settings" class="glass px-6 py-3 rounded-2xl font-bold text-sm uppercase tracking-widest hover:bg-white/10 transition-colors">
          Settings
        </a>
        <button id="signout" class="bg-white/5 border border-white/10 px-6 py-3 rounded-2xl font-bold text-sm uppercase tracking-widest hover:bg-brand-coral hover:border-brand-coral transition-all">
          Sign Out
        </button>
      </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Left Column: Registration History -->
      <div class="lg:col-span-2 space-y-8">
        {clubSeasonPlans.map((plan) => {
          const financialLabel = financialStatusLabel(plan.financialStatus, plan.remainingBalance);
          const requiresAction = plan.financialStatus === 'action_required' || plan.financialStatus === 'past_due';
          return (
            <section
              class="overflow-hidden rounded-3xl border border-brand-teal/25 bg-[#11151d] shadow-2xl shadow-black/20"
              aria-labelledby={`club-season-heading-${plan.id}`}
              data-club-season-registration={plan.registrationId}
              data-plan-player={plan.playerName}
              data-plan-team={plan.teamName}
              data-plan-season={plan.seasonName}
            >
              <header class="border-b border-white/10 px-6 py-6 md:px-8">
                <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <p class="text-[10px] font-extrabold uppercase tracking-[0.22em] text-brand-teal">{plan.seasonName}</p>
                    <h2 id={`club-season-heading-${plan.id}`} class="mt-1 font-heading text-2xl font-black uppercase tracking-tight text-white">
                      Club Season &amp; Payment Plan
                    </h2>
                    <p class="mt-2 text-base font-bold text-white">{plan.playerName} <span class="font-medium text-white/45">&middot; {plan.teamName}</span></p>
                  </div>
                  <div class="flex flex-wrap gap-2 sm:justify-end">
                    <span class="rounded-full border border-brand-teal/25 bg-brand-teal/10 px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest text-brand-teal">{registrationStatusLabel(plan.registrationStatus)}</span>
                    <span class:list={[
                      'rounded-full border px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest',
                      requiresAction
                        ? 'border-brand-coral/30 bg-brand-coral/10 text-brand-coral'
                        : 'border-white/15 bg-white/[0.06] text-white/70',
                    ]}>{financialLabel}</span>
                    {!plan.isOwned && <span class="rounded-full border border-white/15 bg-white/[0.06] px-3 py-1 text-[10px] font-extrabold uppercase tracking-widest text-white/55">Shared view</span>}
                  </div>
                </div>
              </header>

              <div class="px-6 py-7 md:px-8">
                <div class="rounded-2xl border border-brand-teal/20 bg-brand-teal/[0.055] p-5 md:p-6">
                  <div class="grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-3 sm:gap-4">
                    <div>
                      <p class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-white/60">Season total</p>
                      <p class="mt-1 font-heading text-lg font-black tabular-nums text-white sm:text-xl md:text-2xl">{formatCurrency(plan.seasonTotal)}</p>
                    </div>
                    <div class="border-l border-white/10 pl-4">
                      <p class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-white/60">Paid &amp; credited</p>
                      <p class="mt-1 font-heading text-lg font-black tabular-nums text-brand-teal sm:text-xl md:text-2xl">{formatCurrency(plan.paidOrCreditedAmount)}</p>
                    </div>
                    <div class="col-span-2 border-t border-white/10 pt-4 sm:col-span-1 sm:border-l sm:border-t-0 sm:pl-4 sm:pt-0 sm:text-right">
                      <p class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-white/60">Remaining</p>
                      <p class="mt-1 font-heading text-2xl font-black tabular-nums text-white">{formatCurrency(plan.remainingBalance)}</p>
                    </div>
                  </div>
                  <div class="mt-5 h-2 overflow-hidden rounded-full bg-black/30" role="progressbar" aria-label={`${formatCurrency(plan.paidOrCreditedAmount)} of ${formatCurrency(plan.seasonTotal)} resolved`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(plan.progressPercent)}>
                    <div class="h-full rounded-full bg-brand-teal" style={`width: ${plan.progressPercent}%`}></div>
                  </div>
                </div>

                <div class:list={[
                  'mt-4 flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-center sm:justify-between',
                  requiresAction ? 'border-brand-coral/30 bg-brand-coral/[0.08]' : 'border-white/10 bg-black/20',
                ]}>
                  {plan.remainingBalance === 0 ? (
                    <div>
                      <p class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-brand-teal">Season balance complete</p>
                      <p class="mt-1 font-heading text-xl font-black uppercase tracking-tight text-white">Paid in full</p>
                      <p class="mt-1 text-xs text-white/60">No future automatic payments are scheduled.</p>
                    </div>
                  ) : plan.nextPayment ? (
                    <div>
                      <p class:list={['text-[10px] font-extrabold uppercase tracking-[0.18em]', requiresAction ? 'text-brand-coral' : 'text-brand-teal']}>
                        {requiresAction ? 'Payment needs attention' : 'Next automatic payment'}
                      </p>
                      <p class="mt-1 font-heading text-xl font-black uppercase tracking-tight text-white sm:text-2xl">
                        <span class="block tabular-nums sm:inline">{formatCurrency(plan.nextPayment.amount)}</span>
                        <span class="mt-1 block font-medium text-white/60 sm:mt-0 sm:inline"> on {formatClubDate(plan.nextPayment.dueDate)}</span>
                      </p>
                    </div>
                  ) : (
                    <div>
                      <p class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-white/45">Payment schedule</p>
                      <p class="mt-1 font-bold text-white">No additional automatic payments are scheduled.</p>
                    </div>
                  )}
                  {plan.isOwned && (
                    <div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto sm:flex-row">
                      <button data-manage-billing data-default-label="Manage payment method" type="button" class="min-h-11 w-full rounded-xl border border-white/15 bg-white/[0.06] px-4 text-xs font-extrabold uppercase tracking-wider text-white transition hover:border-brand-teal/40 hover:text-brand-teal focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-[#11151d] disabled:cursor-wait disabled:opacity-50 sm:w-auto">
                        <span>Manage payment method</span>
                      </button>
                      {plan.initialTransactionId && (
                        <button
                          data-club-season-receipt
                          data-transaction-id={plan.initialTransactionId}
                          data-default-label={plan.paymentOption === 'pay_in_full' ? 'View payment receipt' : 'View deposit receipt'}
                          type="button"
                          class="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-brand-teal/40 bg-brand-teal/[0.08] px-4 text-xs font-extrabold uppercase tracking-wider text-brand-teal transition hover:border-brand-teal hover:bg-brand-teal/[0.14] focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-[#11151d] disabled:cursor-wait disabled:opacity-50 sm:w-auto"
                        >
                          <svg data-receipt-icon aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2v20l3-2 3 2 3-2 3 2V2l-3 2-3-2-3 2-3-2Z"/><path d="M9 9h6"/><path d="M9 13h6"/></svg>
                          <span>{plan.paymentOption === 'pay_in_full' ? 'View payment receipt' : 'View deposit receipt'}</span>
                          <svg data-receipt-spinner aria-hidden="true" class="hidden h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        </button>
                      )}
                    </div>
                  )}
                </div>

                <div class="mt-7 grid gap-7 md:grid-cols-[minmax(0,1fr)_13rem]">
                  <div>
                    <h3 class="text-xs font-extrabold uppercase tracking-[0.18em] text-white/65">Current payment schedule</h3>
                    <ol class="mt-4 overflow-hidden rounded-2xl border border-white/10 bg-black/15">
                      {plan.installments.map((installment, index) => (
                        <li class:list={['grid grid-cols-[minmax(0,1fr)_auto] gap-4 px-4 py-4 sm:grid-cols-[minmax(0,1fr)_9rem_6rem]', index && 'border-t border-white/10']}>
                          <div class="flex min-w-0 items-center gap-3">
                            <span class:list={[
                              'flex h-7 w-7 shrink-0 items-center justify-center rounded-full border text-xs font-black',
                              ['paid', 'satisfied'].includes(installment.status)
                                ? 'border-brand-teal/30 bg-brand-teal/10 text-brand-teal'
                                : installment.status === 'action_required' || installment.status === 'past_due'
                                  ? 'border-brand-coral/30 bg-brand-coral/10 text-brand-coral'
                                  : 'border-white/15 bg-white/[0.04] text-white/40',
                            ]} aria-hidden="true">
                              {['paid', 'satisfied'].includes(installment.status) ? '✓' : index + 1}
                            </span>
                            <div class="min-w-0">
                              <p class="text-sm font-bold leading-5 text-white">{installmentTypeLabel(installment.type)}</p>
                              <p class="mt-0.5 text-xs tabular-nums text-white/60">{formatClubDate(installment.dueDate)}</p>
                            </div>
                          </div>
                          <p class="self-center text-right font-bold tabular-nums text-white">{formatCurrency(installment.amount)}</p>
                          <p class:list={[
                            'col-span-2 self-center text-right text-[10px] font-extrabold uppercase tracking-wider sm:col-span-1',
                            ['paid', 'satisfied'].includes(installment.status) ? 'text-brand-teal' :
                              ['past_due', 'action_required'].includes(installment.status) ? 'text-brand-coral' : 'text-white/60',
                          ]}>{installmentStatusLabel(installment.status)}</p>
                        </li>
                      ))}
                    </ol>
                    {plan.priorPaidInstallments.length > 0 && (
                      <div class="mt-4 rounded-2xl border border-white/10 bg-white/[0.025] px-4 py-4">
                        <p class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-white/60">Payments retained from a previous schedule</p>
                        {plan.priorPaidInstallments.map((installment) => (
                          <div class="mt-3 flex items-center justify-between gap-4 text-sm">
                            <span class="text-white/60">{installmentTypeLabel(installment.type)} &middot; {formatClubDate(installment.dueDate)}</span>
                            <strong class="tabular-nums text-brand-teal">{formatCurrency(installment.amount)} paid</strong>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>

                  <aside class="rounded-2xl border border-white/10 bg-white/[0.025] p-5" aria-label="Payment plan facts">
                    <h3 class="text-xs font-extrabold uppercase tracking-[0.18em] text-white/65">Plan facts</h3>
                    <dl class="mt-4 space-y-4 text-sm">
                      <div>
                        <dt class="text-xs text-white/60">Plan type</dt>
                        <dd class="mt-1 font-bold text-white">{paymentOptionLabel(plan.paymentOption)}</dd>
                      </div>
                      <div>
                        <dt class="text-xs text-white/60">Automatic payments</dt>
                        <dd class="mt-1 font-bold text-white">{plan.paymentOption === 'pay_in_full' ? 'Not applicable' : plan.autopayAuthorized ? 'Authorized' : 'Not authorized'}</dd>
                      </div>
                      {plan.billingDay && (
                        <div>
                          <dt class="text-xs text-white/60">Billing day</dt>
                          <dd class="mt-1 font-bold text-white">{plan.billingDay}{plan.billingDay === 1 ? 'st' : plan.billingDay === 2 ? 'nd' : plan.billingDay === 3 ? 'rd' : 'th'} of the month</dd>
                        </div>
                      )}
                    </dl>
                    {!plan.isOwned && (
                      <p class="mt-5 border-t border-white/10 pt-4 text-xs leading-5 text-white/60">You have view-only household access. Billing and receipt controls remain with the primary parent.</p>
                    )}
                  </aside>
                </div>
                <p class="mt-6 border-t border-white/10 pt-5 text-xs leading-5 text-white/60">
                  Amounts and dates are read-only. Contact TVVC if your family needs a different arrangement.
                  {plan.isOwned ? ' Any proposed revision will appear below for your approval before it takes effect.' : ''}
                </p>
              </div>
            </section>
          );
        })}

        <section id="club-season-plan" data-plan-revision-card class="hidden overflow-hidden rounded-3xl border border-amber-300/25 bg-[#11151d] shadow-2xl" aria-labelledby="plan-revision-heading">
          <div class="border-b border-white/10 px-6 py-5 md:px-8">
            <div class="flex items-start gap-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-300/30 bg-amber-300/10 text-amber-300">
                <svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h10M4 17h7"></path><path d="m17 15 3 3 3-3"></path></svg>
              </div>
              <div>
                <p class="text-[10px] font-extrabold uppercase tracking-[0.2em] text-amber-300">Your review is needed</p>
                <h2 id="plan-revision-heading" class="mt-1 font-heading text-2xl font-extrabold uppercase tracking-tight text-white">Revised payment schedule</h2>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-white/60">The matching current plan remains in effect. Nothing changes until you review and authorize its proposal.</p>
              </div>
            </div>
          </div>
          <div data-plan-revision-loading class="px-6 py-8 md:px-8" role="status"><div class="h-24 animate-pulse rounded-2xl bg-white/[0.05]"></div><p class="mt-3 text-xs font-bold uppercase tracking-wider text-white/35">Loading proposal…</p></div>
          <div data-plan-revision-error class="hidden px-6 py-8 md:px-8" role="alert"><p class="font-bold text-brand-coral">We couldn’t load the proposed schedule.</p><p data-plan-revision-error-copy class="mt-2 text-sm text-white/50">Please try again.</p><button data-plan-revision-retry type="button" class="mt-4 min-h-11 rounded-xl border border-white/15 px-4 text-xs font-extrabold uppercase tracking-wider text-white focus:outline-none focus:ring-2 focus:ring-brand-teal">Try again</button></div>
          <div data-plan-revision-list></div>
          <p data-plan-revision-live class="sr-only" role="status" aria-live="polite"></p>
        </section>

        <section class="glass rounded-3xl p-8 border-white/5">
          <h2 class="text-2xl font-heading font-bold mb-6 uppercase tracking-tight flex items-center gap-3">
            <span class="w-2 h-8 bg-brand-teal rounded-full"></span>
            Purchase History
          </h2>

          {userRegistrations.length > 0 ? (
            <div class="space-y-4">
              {userRegistrations.map((reg) => (
                <div class="bg-white/5 rounded-2xl p-6 border border-white/5 hover:border-white/10 transition-all flex justify-between items-center group">
                  <div>
                    <div class="flex items-center gap-3 mb-1">
                      <span class="font-bold text-lg group-hover:text-brand-teal transition-colors">Order #{reg.id.slice(0, 8).toUpperCase()}</span>
                      <span class:list={[
                        "text-[10px] uppercase tracking-widest px-2 py-0.5 rounded-full font-bold",
                        reg.status === 'paid' ? "bg-brand-teal/20 text-brand-teal" : "bg-brand-coral/20 text-brand-coral"
                      ]}>
                        {reg.status}
                      </span>
                      {reg.ownerUserId !== userId && (
                        <span class="text-[10px] uppercase tracking-widest px-2 py-0.5 rounded-full font-bold bg-white/10 text-white/50">
                          Shared
                        </span>
                      )}
                    </div>
                    <p class="text-white/40 text-sm">{formatDate(reg.createdAt)}</p>
                  </div>
                  <div class="text-right">
                    <p class="font-black text-xl">{formatCurrency(reg.totalAmount)}</p>
                    <a href={`/portal/orders/${reg.id}`} class="text-xs uppercase tracking-widest font-bold text-brand-teal hover:underline mt-1 block">View Details</a>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-12 bg-white/5 rounded-2xl border border-dashed border-white/10">
              <p class="text-white/40 mb-4">You haven't made any purchases yet.</p>
              <a href="/tryouts" class="text-brand-teal font-bold hover:underline uppercase tracking-widest text-sm">Browse Programs &rarr;</a>
            </div>
          )}
        </section>

        <!-- Feature 3: My Schedule -->
        <section class="glass rounded-3xl p-8 border-white/5">
          <h2 class="text-2xl font-heading font-bold mb-6 uppercase tracking-tight flex items-center gap-3">
            <span class="w-2 h-8 bg-brand-coral rounded-full"></span>
            Upcoming Events
          </h2>
          
          {upcomingEvents.length > 0 ? (
            <div class="space-y-4">
              {upcomingEvents.map((event) => (
                <div class="bg-white/5 rounded-2xl p-6 border border-white/5 flex gap-6 items-center">
                  <div class="flex-shrink-0 w-16 h-16 bg-brand-coral/10 rounded-2xl flex flex-col items-center justify-center text-brand-coral">
                    <span class="text-xs uppercase font-black tracking-widest">{event.dateInfo.split(' ')[0]}</span>
                    <span class="text-2xl font-black">{event.dateInfo.split(' ')[1]?.replace(/\D/g, '') || '??'}</span>
                  </div>
                  <div class="flex-grow">
                    <h3 class="font-bold text-lg leading-tight mb-1">{event.name}</h3>
                    <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-white/40 font-medium">
                      <span class="flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        {event.timeInfo}
                      </span>
                      <span class="flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        {event.athleteFirstName}
                      </span>
                      <span class="bg-white/10 px-2 rounded text-[10px] uppercase tracking-widest font-bold self-center">{event.type}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-12 bg-white/5 rounded-2xl border border-dashed border-white/10">
              <p class="text-white/40 mb-4">You have no upcoming confirmed events.</p>
              <a href="/tryouts" class="text-brand-coral font-bold hover:underline uppercase tracking-widest text-sm">Find Programs &rarr;</a>
            </div>
          )}
        </section>
      </div>

      <!-- Right Column: Player Profiles -->
      <div class="space-y-8">
        <section class="glass rounded-3xl p-8 border-white/5">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-heading font-bold uppercase tracking-tight">Players</h2>
            <div class="flex items-center gap-3">
              <a href="/portal/players" class="text-xs uppercase tracking-widest font-bold text-white/40 hover:text-brand-teal transition-colors">
                Manage
              </a>
              <a href="/portal/athletes/new" aria-label="Add player" class="text-brand-teal hover:text-brand-teal/80 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
              </a>
            </div>
          </div>

          <div class="space-y-4">
            {userAthletes.length > 0 ? (
              userAthletes.map((athlete) => {
                const isOwned = athlete.ownerUserId === userId;
                const content = (
                  <>
                    <div class="w-12 h-12 bg-brand-teal/20 rounded-full flex items-center justify-center text-brand-teal font-black text-xl group-hover:scale-110 transition-transform">
                      {athlete.firstName[0]}
                    </div>
                    <div class="flex-grow">
                      <p class="font-bold group-hover:text-brand-teal transition-colors">{athlete.firstName} {athlete.lastName}</p>
                      <p class="text-xs text-white/40 uppercase tracking-widest font-bold">
                        {isOwned ? `Grade: ${athlete.grade}` : `Shared · Grade: ${athlete.grade}`}
                      </p>
                    </div>
                    {isOwned && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/20 group-hover:text-brand-teal transition-colors"><path d="m9 18 6-6-6-6"/></svg>
                    )}
                  </>
                );

                return isOwned ? (
                  <a href={`/portal/athletes/${athlete.id}`} class="bg-white/5 rounded-2xl p-4 border border-white/5 flex items-center gap-4 hover:border-brand-teal/30 transition-all group">
                    {content}
                  </a>
                ) : (
                  <div class="bg-white/5 rounded-2xl p-4 border border-white/5 flex items-center gap-4 group">
                    {content}
                  </div>
                );
              })
            ) : (
              <p class="text-white/40 text-sm text-center py-4">No players added yet.</p>
            )}
          </div>
        </section>

        <!-- Feature 4: Billing & Payments -->
        {hasOwnRegistrations ? (
          <section class="glass rounded-3xl p-8 border-white/5 bg-gradient-to-br from-white/5 to-transparent">
            <h2 class="text-xl font-heading font-bold mb-4 uppercase tracking-tight">Billing</h2>
            <p class="text-sm text-white/40 mb-6">Update your payment methods and download tax receipts via our secure payment partner.</p>
            <button id="manage-billing" data-manage-billing data-default-label="Manage via Stripe" class="w-full bg-white text-brand-charcoal font-black py-4 rounded-2xl hover:bg-brand-teal transition-all uppercase tracking-widest text-xs disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
              <span>Manage via Stripe</span>
              <svg data-billing-spinner class="animate-spin h-4 w-4 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </section>
        ) : access.sharedOwnerIds.length > 0 ? (
          <section class="glass rounded-3xl p-8 border-white/5">
            <h2 class="text-xl font-heading font-bold mb-4 uppercase tracking-tight">Shared Access</h2>
            <p class="text-sm text-white/40 leading-relaxed">
              You have view-only access to this household. Billing, receipts, registrations, and player changes remain with the primary parent.
            </p>
          </section>
        ) : null}
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const { signOut } = await import('auth-astro/client');
  document.getElementById('signout')?.addEventListener('click', () => signOut());

  type PlanRevision = {
    id: string;
    registrationId: string;
    reason: string;
    proposedAt: string;
    termsFingerprint: string;
    remainingBalance: number;
    authorizationText: string;
    installments: Array<{ id: string; dueDate: string; amount: number }>;
  };
  const revisionCard = document.querySelector<HTMLElement>('[data-plan-revision-card]');
  const revisionList = revisionCard?.querySelector<HTMLElement>('[data-plan-revision-list]');
  const revisionLoading = revisionCard?.querySelector<HTMLElement>('[data-plan-revision-loading]');
  const revisionError = revisionCard?.querySelector<HTMLElement>('[data-plan-revision-error]');
  const revisionLive = revisionCard?.querySelector<HTMLElement>('[data-plan-revision-live]');
  const revisionMoney = (cents: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
  const revisionDate = (value: string) => new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T12:00:00Z`));
  const revisionEscape = (value: unknown) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character] || character));
  const revisionNotify = (type: 'success' | 'error', message: string) => {
    const toast = (window as Window & { toast?: Record<string, (text: string) => void> }).toast;
    toast?.[type]?.(message);
    if (revisionLive) revisionLive.textContent = message;
  };
  const renderRevisions = (revisions: PlanRevision[]) => {
    if (!revisionList || !revisionCard) return;
    if (!revisions.length) {
      revisionCard.classList.add('hidden');
      revisionList.replaceChildren();
      return;
    }
    revisionCard.classList.remove('hidden');
    revisionList.innerHTML = revisions.map((revision, index) => {
      const matchingPlan = Array.from(document.querySelectorAll<HTMLElement>('[data-club-season-registration]'))
        .find((plan) => plan.dataset.clubSeasonRegistration === revision.registrationId);
      const planIdentity = matchingPlan
        ? `${matchingPlan.dataset.planPlayer} · ${matchingPlan.dataset.planTeam} · ${matchingPlan.dataset.planSeason}`
        : `Registration ${revision.registrationId.slice(0, 8).toUpperCase()}`;
      return `
      <article class="px-6 py-7 md:px-8 ${index ? 'border-t border-white/10' : ''}" data-revision-id="${revisionEscape(revision.id)}">
        <p class="mb-5 rounded-xl border border-amber-300/20 bg-amber-300/[.07] px-4 py-3 text-xs font-extrabold uppercase tracking-[.12em] text-amber-200">Proposed revision for <span class="text-white">${revisionEscape(planIdentity)}</span></p>
        <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_15rem]">
          <div>
            <p class="text-sm font-bold text-white">Why this is being offered</p>
            <p class="mt-2 text-sm leading-6 text-white/60">${revisionEscape(revision.reason)}</p>
            <div class="mt-5 overflow-hidden rounded-2xl border border-white/10 bg-black/20">
              <div class="flex items-center justify-between border-b border-white/10 px-4 py-3">
                <span class="text-[10px] font-extrabold uppercase tracking-[.16em] text-white/65">Proposed automatic charges</span>
                <strong class="font-heading text-lg font-extrabold tabular-nums text-white">${revisionMoney(revision.remainingBalance)}</strong>
              </div>
              <ol class="divide-y divide-white/[.07]">${revision.installments.map((installment, chargeIndex) => `<li class="flex min-h-12 items-center justify-between gap-4 px-4 py-3"><span class="text-sm tabular-nums text-white/70"><span class="mr-2 text-[10px] font-bold text-white/55">${String(chargeIndex + 1).padStart(2, '0')}</span>${revisionDate(installment.dueDate)}</span><strong class="text-base tabular-nums text-white">${revisionMoney(installment.amount)}</strong></li>`).join('')}</ol>
            </div>
          </div>
          <aside class="rounded-2xl border border-brand-teal/20 bg-brand-teal/[0.055] p-5">
            <p class="text-[10px] font-extrabold uppercase tracking-[.17em] text-brand-teal">Balance rail</p>
            <p class="mt-2 font-heading text-3xl font-extrabold tabular-nums tracking-tight text-white">${revisionMoney(revision.remainingBalance)}</p>
            <p class="mt-1 text-xs text-white/65">Remaining balance</p>
            <div class="mt-5 border-t border-brand-teal/15 pt-4 text-xs leading-5 text-white/65">
              <p>The current schedule remains active until you accept.</p>
              <p class="mt-2">Payments already made and your payment history do not change.</p>
            </div>
          </aside>
        </div>
        <form data-revision-authorize class="mt-6 rounded-2xl border border-white/10 bg-white/[.025] p-4 md:p-5">
          <input type="hidden" name="revisionId" value="${revisionEscape(revision.id)}" />
          <input type="hidden" name="termsFingerprint" value="${revisionEscape(revision.termsFingerprint)}" />
          <div class="rounded-xl border border-brand-teal/20 bg-brand-teal/[.055] p-4">
            <p class="text-[10px] font-extrabold uppercase tracking-[.15em] text-brand-teal">Exact authorization</p>
            <p class="mt-2 text-sm leading-6 text-white/80">${revisionEscape(revision.authorizationText)}</p>
            <label class="mt-4 flex min-h-11 cursor-pointer items-start gap-3 rounded-xl border border-brand-teal/30 bg-[#0b0e14] px-3.5 py-3 text-sm font-semibold leading-5 text-white hover:border-brand-teal"><input name="autopayAuthorized" required type="checkbox" class="mt-0.5 h-4 w-4 shrink-0 rounded border-white/30 bg-transparent text-brand-teal focus:ring-brand-teal focus:ring-offset-[#0b0e14]" /><span>I have read and agree to the exact automatic-payment authorization above.</span></label>
          </div>
          <div class="mt-4 max-w-md">
            <label for="authorized-name-${index}" class="mb-1.5 block text-[10px] font-extrabold uppercase tracking-wider text-white/65">Your full legal name</label><input id="authorized-name-${index}" name="authorizedName" required autocomplete="name" class="min-h-11 w-full rounded-xl border border-white/15 bg-[#0b0e14] px-3.5 text-sm text-white outline-none focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20" />
          </div>
          <div class="mt-4 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
            <button data-revision-decline type="button" class="min-h-11 px-3 text-xs font-extrabold uppercase tracking-wider text-white/65 hover:text-brand-coral focus:outline-none focus:ring-2 focus:ring-brand-coral">Decline this proposal</button>
            <button type="submit" class="min-h-11 rounded-xl bg-brand-teal px-5 text-xs font-extrabold uppercase tracking-wider text-white transition hover:bg-brand-teal-dark focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-[#11151d] disabled:cursor-wait disabled:opacity-50">Authorize revised schedule</button>
          </div>
          <p data-revision-form-status class="mt-3 min-h-5 text-sm text-white/55" role="status" aria-live="polite"></p>
        </form>
      </article>`;
    }).join('');
    revisionList.querySelectorAll<HTMLFormElement>('[data-revision-authorize]').forEach((form) => form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('[data-revision-form-status]');
      const formData = new FormData(form);
      if (button) { button.disabled = true; button.textContent = 'Authorizing…'; }
      if (status) status.textContent = 'Recording your authorization…';
      try {
        const response = await fetch('/api/club-season/payment-revision', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'authorize', revisionId: String(formData.get('revisionId')), authorizedName: String(formData.get('authorizedName') || '').trim(), autopayAuthorized: formData.get('autopayAuthorized') === 'on', termsFingerprint: String(formData.get('termsFingerprint')) }) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Your authorization could not be recorded.');
        revisionNotify('success', 'Revised payment schedule authorized.');
        await loadRevisions();
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Your authorization could not be recorded.';
        if (status) status.textContent = message;
        revisionNotify('error', message);
        if (button) { button.disabled = false; button.textContent = 'Authorize revised schedule'; }
      }
    }));
    revisionList.querySelectorAll<HTMLButtonElement>('[data-revision-decline]').forEach((button) => button.addEventListener('click', async () => {
      const article = button.closest<HTMLElement>('[data-revision-id]');
      if (!article || !window.confirm('Decline this proposed schedule? Your current payment schedule will remain active.')) return;
      const form = button.closest('form');
      const status = form?.querySelector<HTMLElement>('[data-revision-form-status]');
      button.disabled = true;
      button.textContent = 'Declining…';
      try {
        const response = await fetch('/api/club-season/payment-revision', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'decline', revisionId: article.dataset.revisionId }) });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'The proposal could not be declined.');
        revisionNotify('success', 'Proposed schedule declined. Your current schedule remains active.');
        await loadRevisions();
      } catch (error) {
        const message = error instanceof Error ? error.message : 'The proposal could not be declined.';
        if (status) status.textContent = message;
        revisionNotify('error', message);
        button.disabled = false;
        button.textContent = 'Decline this proposal';
      }
    }));
  };
  const loadRevisions = async () => {
    if (!revisionCard) return;
    revisionCard.classList.remove('hidden');
    revisionLoading?.classList.remove('hidden');
    revisionError?.classList.add('hidden');
    try {
      const response = await fetch('/api/club-season/payment-revision');
      const data = await response.json().catch(() => ({}));
      if (response.status === 404) { revisionCard.classList.add('hidden'); return; }
      if (!response.ok) throw new Error(data.error || 'The proposed schedule could not be loaded.');
      renderRevisions(data.revisions || []);
    } catch (error) {
      revisionError?.classList.remove('hidden');
      const copy = revisionCard.querySelector<HTMLElement>('[data-plan-revision-error-copy]');
      if (copy) copy.textContent = error instanceof Error ? error.message : 'Please try again.';
    } finally {
      revisionLoading?.classList.add('hidden');
    }
  };
  revisionCard?.querySelector('[data-plan-revision-retry]')?.addEventListener('click', loadRevisions);
  loadRevisions();

  document.querySelectorAll<HTMLButtonElement>('[data-club-season-receipt]').forEach((receiptButton) => receiptButton.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const label = button.querySelector('span');
    const icon = button.querySelector<HTMLElement>('[data-receipt-icon]');
    const spinner = button.querySelector<HTMLElement>('[data-receipt-spinner]');
    const defaultLabel = button.dataset.defaultLabel || 'View receipt';
    const transactionId = button.dataset.transactionId;

    if (!transactionId) return;
    button.disabled = true;
    if (label) label.textContent = 'Opening receipt...';
    icon?.classList.add('hidden');
    spinner?.classList.remove('hidden');

    try {
      const response = await fetch(`/api/stripe/club-season-receipt?transactionId=${encodeURIComponent(transactionId)}`);
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.url) throw new Error(data.error || 'The receipt could not be opened.');
      window.location.assign(data.url);
    } catch (error) {
      const message = error instanceof Error ? error.message : 'The receipt could not be opened.';
      window.toast?.error(message);
      button.disabled = false;
      if (label) label.textContent = defaultLabel;
      icon?.classList.remove('hidden');
      spinner?.classList.add('hidden');
    }
  }));

  document.querySelectorAll<HTMLButtonElement>('[data-manage-billing]').forEach((billingButton) => billingButton.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const spinner = btn.querySelector('[data-billing-spinner]');
    const text = btn.querySelector('span');
    const defaultLabel = btn.dataset.defaultLabel || 'Manage via Stripe';
    
    btn.disabled = true;
    if (text) text.textContent = 'Opening...';
    if (spinner) spinner.classList.remove('hidden');

    try {
      const response = await fetch('/api/stripe/portal', { method: 'POST' });
      const data = await response.json();
      
      if (data.url) {
        window.location.href = data.url;
      } else {
        window.toast.error(data.error || 'Failed to open billing portal');
        btn.disabled = false;
        if (text) text.textContent = defaultLabel;
        if (spinner) spinner.classList.add('hidden');
      }
    } catch (err) {
      console.error(err);
      window.toast.error('An error occurred');
      btn.disabled = false;
      if (text) text.textContent = defaultLabel;
      if (spinner) spinner.classList.add('hidden');
    }
  }));
</script>
