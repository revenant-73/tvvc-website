---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSession } from 'auth-astro/server';
import { db } from '../../../db/db';
import { registrations, registrationItems, events, athletes } from '../../../db/schema';
import { eq, and } from 'drizzle-orm';

const { id } = Astro.params;

const session = await getSession(Astro.request);

if (!session) {
  return Astro.redirect('/portal/login');
}

if (!id) {
  return Astro.redirect('/portal/dashboard');
}

const user = session.user;

// Fetch registration details
const [registration] = await db.select()
  .from(registrations)
  .where(eq(registrations.id, id))
  .limit(1);

// Security check: Prefer the canonical user relationship, with email fallback
// for purchases made before the parent created a portal account.
const ownsRegistration = registration && (
  registration.userId === (user as any).id ||
  registration.parentEmail === user.email
);
if (!ownsRegistration) {
  return Astro.redirect('/portal/dashboard');
}

// Fetch items for this registration
const databaseItems = await db.select({
  id: registrationItems.id,
  eventName: events.name,
  eventPrice: events.price,
  eventDate: events.dateInfo,
  eventTime: events.timeInfo,
  athleteFirstName: athletes.firstName,
  athleteLastName: athletes.lastName,
})
.from(registrationItems)
.innerJoin(events, eq(registrationItems.eventId, events.id))
.innerJoin(athletes, eq(registrationItems.athleteId, athletes.id))
.where(eq(registrationItems.registrationId, id));

type OrderItem = {
  id: number | string;
  eventName: string;
  eventPrice: number;
  eventDate: string;
  eventTime: string | null;
  athleteFirstName: string;
  athleteLastName: string;
};

let items: OrderItem[] = databaseItems;
try {
  const metadata = registration.metadata ? JSON.parse(registration.metadata) : null;
  if (Array.isArray(metadata?.orderItems) && metadata.orderItems.length > 0) {
    items = metadata.orderItems.map((item: any, index: number) => {
      const athleteName = String(item.athleteName || '').trim();
      const [athleteFirstName = '', ...lastNameParts] = athleteName.split(/\s+/);

      return {
        id: `snapshot-${index}`,
        eventName: String(item.eventName || 'Registration item'),
        eventPrice: Number(item.unitAmount) || 0,
        eventDate: String(item.eventDate || ''),
        eventTime: item.eventTime ? String(item.eventTime) : null,
        athleteFirstName,
        athleteLastName: lastNameParts.join(' '),
      };
    });
  }
} catch (error) {
  console.warn(`Unable to parse order snapshot for registration ${id}`, error);
}

const formatCurrency = (cents: number) => {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
};

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return 'N/A';
  return new Date(dateStr).toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
};
---

<BaseLayout title={`Order #${id.slice(0, 8).toUpperCase()}`} noindex={true}>
  <main class="pt-32 pb-20 px-4 max-w-4xl mx-auto">
    <div class="mb-8">
      <a href="/portal/dashboard" class="text-white/40 hover:text-white transition-colors text-sm font-bold uppercase tracking-widest flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Dashboard
      </a>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
      <div>
        <div class="flex items-center gap-4 mb-2">
          <h1 class="text-4xl font-heading font-black uppercase tracking-tight">
            Order <span class="text-brand-teal">#{registration.id.slice(0, 8).toUpperCase()}</span>
          </h1>
          <span class:list={[
            "text-xs uppercase tracking-widest px-3 py-1 rounded-full font-bold",
            registration.status === 'paid' ? "bg-brand-teal/20 text-brand-teal" : "bg-brand-coral/20 text-brand-coral"
          ]}>
            {registration.status}
          </span>
        </div>
        <p class="text-white/40 font-medium">Placed on {formatDate(registration.createdAt)}</p>
      </div>
      
      {registration.status === 'paid' && (
        <button id="download-receipt" class="glass px-6 py-3 rounded-2xl font-bold text-sm uppercase tracking-widest hover:bg-white/10 transition-colors flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Receipt
        </button>
      )}
    </div>

    <div class="grid gap-8">
      <!-- Order Summary -->
      <section class="glass rounded-3xl p-8 border-white/5">
        <h2 class="text-2xl font-heading font-bold mb-6 uppercase tracking-tight flex items-center gap-3">
          <span class="w-2 h-8 bg-brand-teal rounded-full"></span>
          Items
        </h2>

        <div class="space-y-6">
          {items.map((item) => (
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-6 border-b border-white/5 last:border-0 last:pb-0">
              <div>
                <h3 class="font-bold text-lg text-white mb-1">{item.eventName}</h3>
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-white/40 font-medium">
                  <span class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    {item.athleteFirstName} {item.athleteLastName}
                  </span>
                  <span class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                    {item.eventDate}
                  </span>
                </div>
              </div>
              <div class="text-right">
                <p class="font-bold text-xl">{formatCurrency(item.eventPrice)}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 pt-8 border-t border-white/10 flex justify-between items-center">
          <span class="text-white/40 uppercase tracking-widest font-black text-sm">Total Amount</span>
          <span class="text-3xl font-black text-brand-teal">{formatCurrency(registration.totalAmount)}</span>
        </div>
      </section>

      <!-- Customer Info -->
      <div class="grid md:grid-cols-2 gap-8">
        <section class="glass rounded-3xl p-8 border-white/5">
          <h3 class="text-xl font-heading font-bold mb-6 uppercase tracking-tight">Parent Info</h3>
          <div class="space-y-4">
            <div>
              <p class="text-[10px] uppercase tracking-widest font-bold text-white/40 mb-1">Name</p>
              <p class="font-bold">{registration.parentName}</p>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-widest font-bold text-white/40 mb-1">Email</p>
              <p class="font-bold">{registration.parentEmail}</p>
            </div>
            <div>
              <p class="text-[10px] uppercase tracking-widest font-bold text-white/40 mb-1">Phone</p>
              <p class="font-bold">{registration.parentPhone}</p>
            </div>
          </div>
        </section>

        <section class="glass rounded-3xl p-8 border-white/5">
          <h3 class="text-xl font-heading font-bold mb-6 uppercase tracking-tight">Payment Method</h3>
          <div class="space-y-4">
            <div class="flex items-center gap-3 bg-white/5 p-4 rounded-2xl border border-white/5">
              <div class="w-10 h-10 bg-brand-teal/20 rounded-xl flex items-center justify-center text-brand-teal">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
              </div>
              <div>
                <p class="font-bold text-sm">Credit / Debit Card</p>
                <p class="text-xs text-white/40 uppercase tracking-widest font-bold">Processed via Stripe</p>
              </div>
            </div>
            <p class="text-xs text-white/40 leading-relaxed italic">
              Need to change your billing info? Head to the <a href="/portal/dashboard" class="text-brand-teal hover:underline">Dashboard</a> and click "Manage via Stripe".
            </p>
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  document.getElementById('download-receipt')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;

    try {
      const registrationId = window.location.pathname.split('/').pop();
      const response = await fetch(`/api/stripe/receipt?registrationId=${encodeURIComponent(registrationId || '')}`);
      const data = await response.json();

      if (!response.ok || !data.url) {
        window.toast.error(data.error || 'Unable to load receipt');
        return;
      }

      window.location.href = data.url;
    } catch (error) {
      console.error(error);
      window.toast.error('Unable to load receipt');
    } finally {
      button.disabled = false;
    }
  });
</script>
