leading-5 text-brand-coral">${esc(a.failureMessage)}</p>`:''}</div>`,'No failed or processing attempts.')}</div></section></div>${accountActions(d)}${adjustmentsLedger(d)}<section class="border-t border-white/10 p-5 md:p-7"><h3 class="font-heading text-sm font-extrabold uppercase tracking-wider text-white">Revision history</h3><div class="mt-3 divide-y divide-white/[.07] rounded-xl border border-white/10">${rows(d.revisions,r=>`<div class="grid gap-2 px-4 py-3 md:grid-cols-[9rem_1fr_auto]"><p class="text-xs tabular-nums text-white/60">${date(r.proposedAt)}</p><p class="text-sm text-white/65">${esc(r.reason)}</p>${pill(r.status)}</div>`,'No schedule revisions.')}</div></section>${composer(d)}`; bindDetail(d);};
      const buildCharges=(d:Detail)=>{const container=detail?.querySelector<HTMLElement>('[data-charge-list]');const countInput=detail?.querySelector<HTMLSelectElement>('[data-installment-count]');if(!container||!countInput)return;const count=Number(countInput.value);const base=Math.floor(d.remainingBalance/count),remainder=d.remainingBalance%count;const start=new Date();start.setUTCMonth(start.getUTCMonth()+1,5);container.innerHTML=Array.from({length:count},(_,i)=>{const due=new Date(Date.UTC(start.getUTCFullYear(),start.getUTCMonth()+i,5)).toISOString().slice(0,10);const amount=base+(i<remainder?1:0);return `<div class="grid gap-2 rounded-xl border border-white/10 bg-black/15 p-3 sm:grid-cols-[3rem_1fr_1fr]"><span class="self-center text-center font-heading text-lg font-extrabold tabular-nums text-white/30">${String(i+1).padStart(2,'0')}</span><div><label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-white/40">Charge date</label><input data-charge-date type="date" required value="${due}" class="min-h-11 w-full rounded-lg border border-white/15 bg-[#0b0e14] px-3 text-sm tabular-nums text-white [color-scheme:dark] focus:border-brand-teal focus:outline-none focus:ring-2 focus:ring-brand-teal/20" /></div><div><label class="mb-1 block text-[9px] font-bold uppercase tracking-wider text-white/40">Amount</label><input data-charge-amount type="number" required min="0.01" step="0.01" value="${(amount/100).toFixed(2)}" class="min-h-11 w-full rounded-lg border border-white/15 bg-[#0b0e14] px-3 text-sm tabular-nums text-white focus:border-brand-teal focus:outline-none focus:ring-2 focus:ring-brand-teal/20" /></div></div>`}).join(''); container.querySelectorAll('input').forEach(input=>input.addEventListener('input',()=>reconcile(d)));reconcile(d);};
      const reconcile=(d:Detail)=>{const amounts=[...(detail?.querySelectorAll<HTMLInputElement>('[data-charge-amount]')||[])];const proposed=amounts.reduce((sum,input)=>sum+Math.round(Number(input.value||0)*100),0);const difference=proposed-d.remainingBalance;const exact=difference===0&&amounts.every(i=>Number(i.value)>0);const totalEl=detail?.querySelector<HTMLElement>('[data-proposed-total]'),diffEl=detail?.querySelector<HTMLElement>('[data-proposed-difference]'),copy=detail?.querySelector<HTMLElement>('[data-reconcile-copy]'),button=detail?.querySelector<HTMLButtonElement>('[data-submit-revision]');if(totalEl)totalEl.textContent=money(proposed);if(diffEl){diffEl.textContent=money(difference);diffEl.className=`font-heading text-lg font-extrabold tabular-nums ${exact?'text-brand-teal':'text-brand-coral'}`;}if(copy){copy.textContent=exact?'Exact match. Ready to send for family authorization.':'Amounts must match the remaining balance exactly.';copy.className=`mt-4 border-l-2 pl-3 text-xs leading-5 text-white/50 ${exact?'border-brand-teal':'border-brand-coral'}`;}if(button)button.disabled=!exact;};
      const bindDetail=(d:Detail)=>{const count=detail?.querySelector<HTMLSelectElement>('[data-installment-count]');count?.addEventListener('change',()=>buildCharges(d));if(count)buildCharges(d);detail?.querySelector<HTMLButtonElement>('[data-cancel-toggle]')?.addEventListener('click',event=>{const button=event.currentTarget as HTMLButtonElement;const form=detail.querySelector<HTMLElement>('[data-cancel-form]');if(!form)return;const opening=form.classList.contains('hidden');form.classList.toggle('hidden',!opening);button.setAttribute('aria-expanded',String(opening));if(opening)form.querySelector('textarea')?.focus();});detail?.querySelector<HTMLFormElement>('[data-revision-form]')?.addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const button=form.querySelector<HTMLButtonElement>('[data-submit-revision]');const status=form.querySelector<HTMLElement>('[data-revision-status]');const dates=[...form.querySelectorAll<HTMLInputElement>('[data-charge-date]')],amounts=[...form.querySelectorAll<HTMLInputElement>('[data-charge-amount]')];const charges=dates.map((input,i)=>({dueDate:input.value,amount:Math.round(Number(amounts[i].value)*100)}));const formData=new FormData(form);if(button)button.disabled=true;if(status)status.textContent='Sending proposal…';try{const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'propose',paymentPlanId:d.planId,reason:String(formData.get('reason')||'').trim(),adminNote:String(formData.get('adminNote')||'').trim()||undefined,charges})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'The proposal could not be created.');notify('success','Revised schedule sent for parent authorization.');await loadAccounts();await loadDetail(d.registrationId);}catch(err){const message=err instanceof Error?err.message:'The proposal could not be created.';if(status)status.textContent=message;notify('error',message);if(button)button.disabled=false;}});detail?.querySelector<HTMLFormElement>('[data-cancel-form]')?.addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const button=form.querySelector<HTMLButtonElement>('[data-cancel-revision]');const status=form.querySelector<HTMLElement>('[data-cancel-status]');const reason=String(new FormData(form).get('reason')||'').trim();if(!button||!reason)return;button.disabled=true;button.textContent='Cancelling…';if(status)status.textContent='Cancelling proposal…';try{const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'cancel',revisionId:button.dataset.cancelRevision,reason})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'The proposal could not be cancelled.');notify('success','Pending proposal cancelled.');await loadAccounts();await loadDetail(d.registrationId);}catch(err){const message=err instanceof Error?err.message:'The proposal could not be cancelled.';notify('error',message);if(status)status.textContent=message;button.disabled=false;button.textContent='Confirm cancellation';}});};
      const bindFinancialActions=(d:Detail)=>{
        if(!detail||!detail.querySelector('[data-account-actions]'))return;
        const actionRoot=detail.querySelector<HTMLElement>('[data-account-actions]');
        if(d.billingSimulatorAvailable&&!detail.querySelector('[data-billing-simulator]')){
          actionRoot?.insertAdjacentHTML('afterend',billingSimulator(d));
        }
        const closeComposers=()=>detail.querySelectorAll<HTMLElement>('[data-action-composer]').forEach(composer=>composer.classList.add('hidden'));
        const refresh=async(message:string)=>{notify('success',message);await loadAccounts();await loadDetail(d.registrationId);};
        const simulatorButtons=[...detail.querySelectorAll<HTMLButtonElement>('[data-billing-scenario]')];
        const simulatorStatus=detail.querySelector<HTMLElement>('[data-billing-simulator-status]');
        simulatorButtons.forEach(button=>button.addEventListener('click',async()=>{
          const scenario=button.dataset.billingScenario||'';
          const scenarioLabel=button.dataset.scenarioLabel||'billing recovery';
          if(!window.confirm(`Run the ${scenarioLabel} test for ${d.playerName}? This will change the pilot ledger and send test notifications.`))return;
          simulatorButtons.forEach(control=>control.disabled=true);
          if(simulatorStatus)simulatorStatus.textContent=`Running ${scenarioLabel} scenario…`;
          try{
            const response=await fetch('/api/admin/club-season-billing-simulator',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({registrationId:d.registrationId,scenario})});
            const data=await response.json().catch(()=>({}));
            if(!response.ok)throw new Error(data.error||'The test billing scenario could not be completed.');
            await refresh(`${label(scenario)} test completed. Account and attempt history refreshed.`);
          }catch(error){
            const message=error instanceof Error?error.message:'The test billing scenario could not be completed.';
            if(simulatorStatus)simulatorStatus.textContent=message;
            notify('error',message);
            simulatorButtons.forEach(control=>control.disabled=false);
          }
        }));
        const adjustmentForm=detail.querySelector<HTMLFormElement>('[data-adjustment-form]');
        const actionCopy={
          offline_payment:{eyebrow:'Money received outside Stripe',heading:'Record offline payment',explanation:'Increases collected cash and lowers the balance due.'},
          credit:{eyebrow:'Non-cash balance relief',heading:'Issue account credit',explanation:'Lowers the balance without returning or recording cash.'},
          write_off:{eyebrow:'Amount will not be collected',heading:'Write off balance',explanation:'Lowers the balance without returning or recording cash.'},
        } as const;
        const updateAdjustmentPreview=()=>{if(!adjustmentForm)return;const type=adjustmentForm.querySelector<HTMLInputElement>('input[name="type"]')?.value as keyof typeof actionCopy;const amountInput=adjustmentForm.querySelector<HTMLInputElement>('[data-adjustment-amount]');const amount=Math.round(Number(amountInput?.value||0)*100);const preview=adjustmentForm.querySelector<HTMLElement>('[data-adjustment-preview]');const submit=adjustmentForm.querySelector<HTMLButtonElement>('[data-adjustment-submit]');const excess=amount>d.remainingBalance;const after=d.remainingBalance-amount;if(amountInput)amountInput.setCustomValidity(excess?`Amount cannot exceed ${money(d.remainingBalance)}.`:'');if(preview){preview.classList.toggle('border-brand-coral',excess);preview.classList.toggle('bg-brand-coral/[.05]',excess);preview.classList.toggle('border-brand-teal',!excess);preview.innerHTML=excess?`<strong class="text-brand-coral">Amount exceeds the balance due by ${money(amount-d.remainingBalance)}.</strong><span class="mt-1 block text-xs font-medium text-white/65">Reduce the amount to ${money(d.remainingBalance)} or less before recording this entry.</span>`:amount>0?`<span class="text-white/60">Balance due</span> <span class="mx-2 tabular-nums">${money(d.remainingBalance)}</span><span aria-hidden="true">→</span><strong class="ml-2 tabular-nums text-brand-teal">${money(after)}</strong><span class="mt-1 block text-xs font-medium text-white/60">${type==='offline_payment'?'Collected cash increases by this amount.':'Collected cash does not change.'}</span>`:'Enter an amount to preview the balance effect.';}if(submit)submit.disabled=amount<=0||excess;};
        detail.querySelectorAll<HTMLButtonElement>('[data-adjustment-choice]').forEach(button=>button.addEventListener('click',()=>{if(!adjustmentForm)return;closeComposers();const type=button.dataset.adjustmentChoice as keyof typeof actionCopy;const copy=actionCopy[type];adjustmentForm.classList.remove('hidden');const typeInput=adjustmentForm.querySelector<HTMLInputElement>('input[name="type"]');if(typeInput)typeInput.value=type;const eyebrow=adjustmentForm.querySelector<HTMLElement>('[data-adjustment-eyebrow]'),heading=adjustmentForm.querySelector<HTMLElement>('[data-adjustment-heading]'),explanation=adjustmentForm.querySelector<HTMLElement>('[data-adjustment-explanation]');if(eyebrow)eyebrow.textContent=copy.eyebrow;if(heading)heading.textContent=copy.heading;if(explanation)explanation.textContent=copy.explanation;updateAdjustmentPreview();adjustmentForm.querySelector<HTMLInputElement>('[data-adjustment-amount]')?.focus();}));
        adjustmentForm?.querySelector('[data-adjustment-amount]')?.addEventListener('input',updateAdjustmentPreview);
        const adjustmentDate=adjustmentForm?.querySelector<HTMLInputElement>('input[name="effectiveDate"]');
        const validateAdjustmentDate=()=>{if(adjustmentDate)adjustmentDate.setCustomValidity(adjustmentDate.value>localToday()?'Effective date cannot be in the future.':'');};
        adjustmentDate?.addEventListener('input',validateAdjustmentDate);
        adjustmentForm?.addEventListener('submit',async event=>{event.preventDefault();validateAdjustmentDate();if(!adjustmentForm.reportValidity())return;const formData=new FormData(adjustmentForm);const button=adjustmentForm.querySelector<HTMLButtonElement>('[data-adjustment-submit]');const status=adjustmentForm.querySelector<HTMLElement>('[data-adjustment-status]');if(button)button.disabled=true;if(status)status.textContent='Recording immutable entry…';try{const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'record_adjustment',requestId:crypto.randomUUID(),registrationId:d.registrationId,type:String(formData.get('type')),amount:Math.round(Number(formData.get('amount'))*100),effectiveDate:String(formData.get('effectiveDate')),reason:String(formData.get('reason')||'').trim(),note:String(formData.get('note')||'').trim()||undefined})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'The adjustment could not be recorded.');await refresh('Financial adjustment recorded.');}catch(error){const message=error instanceof Error?error.message:'The adjustment could not be recorded.';if(status)status.textContent=message;notify('error',message);if(button)button.disabled=false;}});
        detail.querySelectorAll<HTMLButtonElement>('[data-open-refund]').forEach(button=>button.addEventListener('click',()=>{closeComposers();const form=detail.querySelector<HTMLFormElement>(`[data-refund-form][data-transaction-id="${CSS.escape(button.dataset.openRefund||'')}"]`);form?.classList.remove('hidden');form?.querySelector<HTMLInputElement>('[data-refund-amount]')?.focus();form?.querySelector<HTMLInputElement>('[data-refund-amount]')?.dispatchEvent(new Event('input'));}));
        detail.querySelectorAll<HTMLFormElement>('[data-refund-form]').forEach(form=>{const amountInput=form.querySelector<HTMLInputElement>('[data-refund-amount]');const preview=form.querySelector<HTMLElement>('[data-refund-preview]');amountInput?.addEventListener('input',()=>{const amount=Math.round(Number(amountInput.value||0)*100);if(preview)preview.innerHTML=`<span class="text-white/60">Balance due</span> <span class="mx-2 tabular-nums">${money(d.remainingBalance)}</span><span aria-hidden="true">→</span><strong class="ml-2 tabular-nums text-brand-coral">${money(d.remainingBalance+amount)}</strong><span class="mt-1 block text-xs font-medium text-white/65">Cash returned: ${money(amount)}. This restored balance remains due.</span>`;});form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;const formData=new FormData(form);const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');const status=form.querySelector<HTMLElement>('[data-refund-status]');if(button)button.disabled=true;if(status)status.textContent='Requesting Stripe refund…';try{const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'refund_payment',requestId:crypto.randomUUID(),transactionId:form.dataset.transactionId,amount:Math.round(Number(formData.get('amount'))*100),reason:String(formData.get('reason')||'').trim(),note:String(formData.get('note')||'').trim()||undefined})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Stripe could not issue the refund.');await refresh('Stripe refund issued and account balance updated.');}catch(error){const message=error instanceof Error?error.message:'Stripe could not issue the refund.';if(status)status.textContent=message;notify('error',message);if(button)button.disabled=false;}});});
        detail.querySelectorAll<HTMLButtonElement>('[data-open-reversal]').forEach(button=>button.addEventListener('click',()=>{closeComposers();const form=detail.querySelector<HTMLFormElement>(`[data-reversal-form][data-adjustment-id="${CSS.escape(button.dataset.openReversal||'')}"]`);form?.classList.remove('hidden');form?.querySelector<HTMLInputElement>('input[name="reason"]')?.focus();}));
        detail.querySelectorAll<HTMLFormElement>('[data-reversal-form]').forEach(form=>form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');const status=form.querySelector<HTMLElement>('[data-reversal-status]');if(button)button.disabled=true;if(status)status.textContent='Recording counter-entry…';try{const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'reverse_adjustment',requestId:crypto.randomUUID(),adjustmentId:form.dataset.adjustmentId,reason:String(new FormData(form).get('reason')||'').trim()})});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'The adjustment could not be reversed.');await refresh('Counter-entry recorded. Original history preserved.');}catch(error){const message=error instanceof Error?error.message:'The adjustment could not be reversed.';if(status)status.textContent=message;notify('error',message);if(button)button.disabled=false;}}));
        detail.querySelectorAll<HTMLButtonElement>('[data-close-action]').forEach(button=>button.addEventListener('click',()=>button.closest('[data-action-composer]')?.classList.add('hidden')));
      };
      const loadDetail=async(id:string)=>{if(!id)return;selectedId=id;renderList();detailShell?.classList.remove('hidden');detail?.replaceChildren();root.querySelector('[data-detail-error]')?.classList.add('hidden');root.querySelector('[data-detail-loading]')?.classList.remove('hidden');try{const response=await fetch(`${endpoint}?registrationId=${encodeURIComponent(id)}`);const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'The account detail could not be loaded.');selectedDetail=data.account;renderDetail(data.account);detailShell?.scrollIntoView({behavior:'smooth',block:'start'});}catch{root.querySelector('[data-detail-error]')?.classList.remove('hidden');}finally{root.querySelector('[data-detail-loading]')?.classList.add('hidden');}};
      const normalizeDetailMarkup=()=>{
        const heading=detail?.querySelector<HTMLElement>('#detail-heading');
        if(heading&&!heading.dataset.focusReady){
          heading.tabIndex=-1;heading.dataset.focusReady='true';
          if(!window.matchMedia('(min-width: 1280px)').matches)root.querySelector('[data-ledger-shell]')?.classList.add('hidden');
          heading.focus({preventScroll:true});
        }
        const cancelReason=detail?.querySelector<HTMLTextAreaElement>('[data-cancel-form] textarea');
        if(cancelReason)cancelReason.maxLength=240;
        detail?.querySelectorAll<HTMLElement>('.text-\\[9px\\]').forEach(element=>{element.classList.remove('text-[9px]');element.classList.add('text-[10px]');});
        detail?.querySelectorAll<HTMLElement>('.text-white\\/35, .text-white\\/40').forEach(element=>{element.classList.remove('text-white/35','text-white/40');element.classList.add('text-white/60');});
        const actionRoot=detail?.querySelector<HTMLElement>('[data-account-actions]');
        if(actionRoot&&selectedDetail&&!actionRoot.dataset.bound){
          actionRoot.dataset.bound='true';
          bindFinancialActions(selectedDetail);
        }
      };
      const detailObserver=new MutationObserver(normalizeDetailMarkup);
      if(detail)detailObserver.observe(detail,{childList:true,subtree:true});
      root.querySelector('[data-back-to-accounts]')?.addEventListener('click',()=>{
        root.querySelector('[data-ledger-shell]')?.classList.remove('hidden');
        detailShell?.classList.add('hidden');
        root.querySelector('[data-ledger-shell]')?.scrollIntoView({behavior:'smooth',block:'start'});
        list?.querySelector<HTMLButtonElement>(`[data-account-id="${CSS.escape(selectedId)}"], [data-candidate-id="${CSS.escape(selectedId)}"]`)?.focus({preventScroll:true});
      });
      root.querySelectorAll<HTMLButtonElement>('[data-finance-mode]').forEach(button=>button.addEventListener('click',()=>{
        mode=button.dataset.financeMode==='candidates'?'candidates':'accounts';selectedId='';selectedDetail=null;detailShell?.classList.add('hidden');root.querySelector('[data-ledger-shell]')?.classList.remove('hidden');
        root.querySelectorAll<HTMLButtonElement>('[data-finance-mode]').forEach(item=>{const active=item===button;item.setAttribute('aria-pressed',String(active));item.classList.toggle('bg-brand-teal',active);item.classList.toggle('text-white',active);item.classList.toggle('text-white/65',!active);});
        if(statusFilter){statusFilter.disabled=mode==='candidates';statusFilter.value='';}if(reviewFilter){reviewFilter.disabled=mode==='candidates';reviewFilter.checked=false;}
        setText('#accounts-heading',mode==='candidates'?'Awaiting payment':'Account ledger');renderList();if(live)live.textContent=`Showing ${filtered().length} ${mode==='candidates'?'awaiting-payment registrations':'financial accounts'}.`;
      }));
      [search,statusFilter,teamFilter,reviewFilter].forEach(control=>control?.addEventListener(control===search?'input':'change',renderList));root.querySelector('[data-retry]')?.addEventListener('click',loadAccounts);root.querySelector('[data-detail-retry]')?.addEventListener('click',()=>loadDetail(selectedId));loadAccounts();
    }
  </script>}
</BaseLayout>
