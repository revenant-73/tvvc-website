      const renderDetail=(d:Detail)=>{if(!detail)return;const activeVersion=d.versions.find(v=>v.version===d.currentVersion);const currentInstallments=d.installments.filter(i=>i.paymentPlanVersionId===activeVersion?.id);const pending=d.revisions.find(r=>r.id===d.pendingRevisionId);const unresolvedAttempts=d.attempts.filter(a=>a.status!=='succeeded');detail.innerHTML=`<header class="p-5 md:p-7"><div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between"><div><div class="flex flex-wrap items-center gap-2">${pill(d.financialStatus)}${pill(d.planStatus)}${pending?pill('pending_authorization'):''}</div><h2 id="detail-heading" class="mt-3 font-heading text-3xl font-extrabold uppercase tracking-tight text-white md:text-4xl">${esc(d.playerName)}</h2><p class="mt-1 text-sm text-white/65">${esc(d.teamName)} · ${esc(d.parentName)} · <a class="hover:text-brand-teal" href="mailto:${esc(d.parentEmail)}">${esc(d.parentEmail)}</a></p></div><div class="w-full lg:max-w-xl">${reconciliationRail(d)}</div></div></header>${pending?`<section class="border-y border-amber-300/20 bg-amber-300/[.055] p-5 md:p-7"><div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]"><div><p class="text-[10px] font-extrabold uppercase tracking-[.18em] text-amber-300">Awaiting parent authorization</p><p class="mt-2 max-w-2xl text-sm leading-6 text-white/60">${esc(pending.reason)} The current schedule remains active until the family accepts.</p><ul class="mt-4 max-w-md text-sm">${revisionSchedule(d,pending)}</ul></div><div><button data-cancel-toggle type="button" aria-expanded="false" class="min-h-11 w-full rounded-xl border border-amber-300/30 px-4 text-xs font-extrabold uppercase tracking-wider text-amber-200 hover:bg-amber-300/10 focus:outline-none focus:ring-2 focus:ring-amber-300">Cancel proposal</button><form data-cancel-form class="mt-3 hidden rounded-xl border border-white/10 bg-black/20 p-3"><label for="cancel-reason" class="mb-1.5 block text-[10px] font-extrabold uppercase tracki