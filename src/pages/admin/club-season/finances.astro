      const adjustmentsLedger=(d:Detail)=>`<section class="border-t border-white/10 p-5 md:p-7" aria-labelledby="adjustments-heading"><div class="flex items-end justify-between gap-4"><div><p class="text-[10px] font-extrabold uppercase tracking-[.18em] text-amber-200">Immutable history</p><h3 id="adjustments-heading" class="mt-1 font-heading text-2xl font-extrabold uppercase text-white">Adjustments & refunds</h3></div><span class="text-xs font-bold tabular-nums text-white/55">${d.adjustments.length} entries</span></div><div class="mt-5 overflow-hidden rounded-xl border border-white/10">${d.adjustments.length?d.adjustments.map(adjustment=>{const increases=adjustment.balanceEffect>0;return `<article class="border-b border-white/[.07] bg-black/15 p-4 last:border-b-0"><div class="grid gap-3 md:grid-cols-[9rem_minmax(0,1fr)_auto]"><div><p class="text-[10px] font-extrabold uppercase tracking-wider ${increases?'text-brand-coral':'text-brand-teal'}">${esc(label(adjustment.type))}</p><p class="mt-1 text-xs tabular-nums text-white/60">${date(adjustment.effectiveDate||adjustment.createdAt)}</p></div><div><p class="text-sm font-semibold text-white">${esc(adjustment.reason)}</p>${adjustment.note?`<p class="mt-2 border-l-2 border-amber-300/35 pl-3 text-xs leading-5 text-white/65"><span class="font-extrabold uppercase tracking-wider text-amber-200">Internal note only</span><span class="mt-1 block">${esc(adjustment.note)}</span></p>`:''}<p class="mt-2 text-xs text-white/55">Recorded by ${esc(adjustment.createdByName||'TVVC admin')}${adjustment.stripeRefundId?` · Stripe ${esc(adjustment.stripeRefundId)}`:''}</p></div><div class="text-right"><p class="font-heading text-xl font-extrabold tabular-nums ${increases?'text-brand-coral':'text-brand-teal'}">${increases?'+':'−'}${money(Math.abs(adjustment.balanceEffect))}</p><p class="mt-1 text-[10px] font-bold uppercase tracking-wider text-white/55">${increases?'Balance increased':'Balance decreased'}</p></div></div>${adjustment.reversible?`