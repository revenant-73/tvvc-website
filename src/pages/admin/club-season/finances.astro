---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCurrentAdminUser } from '../../../lib/admin-auth';

const admin = await getCurrentAdminUser(Astro.request);
---

<BaseLayout title="Club Season Finances" description="Manage TVVC club season balances and payment schedules." noindex={true}>
  <main class="relative min-h-screen overflow-x-clip px-4 pb-28 pt-28 md:px-6 md:pt-32">
    <div aria-hidden="true" class="court-lines pointer-events-none absolute inset-0 opacity-[0.035]"></div>
    <div class="relative mx-auto max-w-[96rem]">
      {!admin ? (
        <section class="mx-auto max-w-lg rounded-3xl border border-white/10 bg-[#11151d] p-7 text-center shadow-2xl md:p-10" aria-labelledby="restricted-title">
          <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-2xl border border-brand-coral/30 bg-brand-coral/10 text-brand-coral">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.28em] text-brand-coral">Restricted area</p>
          <h1 id="restricted-title" class="font-heading text-2xl font-extrabold uppercase tracking-tight text-white">Admin access required</h1>
          <p class="mx-auto mt-3 max-w-sm text-sm leading-6 text-white/55">Sign in with a current TVVC administrator account to manage club-season finances.</p>
          <a href="/portal/login?callbackUrl=/admin/club-season/finances" class="mt-7 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-brand-teal px-5 py-3 text-sm font-bold text-white transition hover:bg-brand-teal-dark focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-brand-charcoal">Sign in</a>
        </section>
      ) : (
        <div data-finance-workspace class="space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <nav aria-label="Breadcrumb">
              <a href="/admin/club-season" class="group inline-flex min-h-11 items-center gap-2 text-xs font-extrabold uppercase tracking-[0.18em] text-white/60 transition hover:text-brand-teal focus:outline-none focus:ring-2 focus:ring-brand-teal">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"></path></svg>
                Season control
              </a>
            </nav>
            <p class="flex items-center gap-2 text-[10px] font-extrabold uppercase tracking-[0.18em] text-white/50"><span class="h-2 w-2 rounded-full bg-brand-teal shadow-glow-teal"></span>Financial workspace</p>
          </div>

          <header class="border-b border-white/10 pb-6 lg:flex lg:items-end lg:justify-between lg:gap-8">
            <div>
              <p class="text-[10px] font-extrabold uppercase tracking-[0.24em] text-brand-teal">2026–2027 club season</p>
              <h1 class="mt-2 font-heading text-4xl font-extrabold uppercase leading-none tracking-[-0.045em] text-white md:text-6xl">Money, <span class="text-brand-teal">at a glance.</span></h1>
              <p class="mt-3 max-w-2xl text-sm leading-6 text-white/50">Balances, payment health, and family-authorized schedule changes—without spreadsheet archaeology.</p>
            </div>
            <dl class="mt-5 grid grid-cols-3 divide-x divide-white/10 overflow-hidden rounded-xl border border-white/10 bg-[#11151d] lg:mt-0 lg:min-w-[33rem]">
              <div class="px-4 py-3"><dt class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-white/60">Season total</dt><dd data-portfolio-total class="mt-1 font-heading text-xl font-extrabold tabular-nums text-white">—</dd></div>
              <div class="px-4 py-3"><dt class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-white/60">Collected</dt><dd data-portfolio-paid class="mt-1 font-heading text-xl font-extrabold tabular-nums text-brand-teal">—</dd></div>
              <div class="px-4 py-3"><dt class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-white/60">Remaining</dt><dd data-portfolio-remaining class="mt-1 font-heading text-xl font-extrabold tabular-nums text-white">—</dd></div>
            </dl>
          </header>

          <nav class="flex flex-col gap-2 rounded-2xl border border-white/10 bg-[#11151d] p-2 sm:flex-row" aria-label="Financial workspace mode">
            <button type="button" data-finance-mode="accounts" aria-pressed="true" class="flex min-h-12 flex-1 items-center justify-between gap-3 rounded-xl bg-brand-teal px-4 text-left text-white transition focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-[#11151d]">
              <span><span class="block text-[10px] font-extrabold uppercase tracking-[0.16em]">Active finance</span><span class="mt-0.5 block text-xs text-white/75">Started payment accounts</span></span>
              <strong data-account-mode-count class="font-heading text-2xl font-extrabold tabular-nums">—</strong>
            </button>
            <button type="button" data-finance-mode="candidates" aria-pressed="false" class="flex min-h-12 flex-1 items-center justify-between gap-3 rounded-xl px-4 text-left text-white/65 transition hover:bg-white/[0.04] focus:outline-none focus:ring-2 focus:ring-amber-300">
              <span><span class="block text-[10px] font-extrabold uppercase tracking-[0.16em] text-amber-300">Awaiting payment</span><span class="mt-0.5 block text-xs">Custom-plan candidates</span></span>
              <strong data-candidate-mode-count class="font-heading text-2xl font-extrabold tabular-nums text-amber-300">—</strong>
            </button>
          </nav>

          <section class="grid gap-3 rounded-2xl border border-white/10 bg-[#11151d] p-4 lg:grid-cols-[minmax(16rem,1.4fr)_minmax(11rem,.7fr)_minmax(11rem,.7fr)_auto] lg:items-end" aria-label="Finance filters">
            <div><label for="finance-search" class="mb-1.5 block text-[10px] font-extrabold uppercase tracking-[0.15em] text-white/55">Search accounts</label><input id="finance-search" data-search type="search" placeholder="Player, parent, email, or team…" class="min-h-11 w-full rounded-xl border border-white/15 bg-[#0b0e14] px-3.5 text-sm text-white outline-none placeholder:text-white/25 focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20" /></div>
            <div><label for="finance-status" class="mb-1.5 block text-[10px] font-extrabold uppercase tracking-[0.15em] text-white/55">Financial status</label><select id="finance-status" data-status-filter class="min-h-11 w-full rounded-xl border border-white/15 bg-[#0b0e14] px-3.5 text-sm font-semibold text-white outline-none focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20"><option value="">All statuses</option></select></div>
            <div><label for="finance-team" class="mb-1.5 block text-[10px] font-extrabold uppercase tracking-[0.15em] text-white/55">Team</label><select id="finance-team" data-team-filter class="min-h-11 w-full rounded-xl border border-white/15 bg-[#0b0e14] px-3.5 text-sm font-semibold text-white outline-none focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20"><option value="">All teams</option></select></div>
            <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-xl border border-white/15 bg-[#0b0e14] px-3.5 text-xs font-extrabold uppercase tracking-[0.1em] text-white/65 hover:border-amber-300/40"><input data-review-filter type="checkbox" class="h-4 w-4 rounded border-white/30 bg-transparent text-amber-300 focus:ring-amber-300 focus:ring-offset-[#0b0e14]" />Needs review</label>
          </section>

          <div data-live-status class="sr-only" role="status" aria-live="polite"></div>
          <div class="grid gap-5 xl:grid-cols-[minmax(22rem,.72fr)_minmax(0,1.45fr)] xl:items-start">
          <section data-ledger-shell class="overflow-hidden rounded-2xl border border-white/10 bg-[#0e1219] xl:sticky xl:top-24 xl:flex xl:max-h-[calc(100vh-7rem)] xl:flex-col" aria-labelledby="accounts-heading">
            <div class="flex items-center justify-between border-b border-white/10 bg-[#11151d] px-4 py-3"><h2 id="accounts-heading" class="font-heading text-sm font-extrabold uppercase tracking-[0.13em] text-white">Account ledger</h2><p class="text-[10px] font-bold uppercase tracking-[0.15em] text-white/40"><span data-visible-count class="tabular-nums">0</span> accounts</p></div>
            <div data-loading class="divide-y divide-white/[0.06]" aria-label="Loading financial accounts">{[0,1,2,3,4].map((i) => <div class="grid animate-pulse grid-cols-[1fr_9rem] gap-6 px-5 py-5" style={`animation-delay:${i*70}ms`}><span class="h-8 rounded bg-white/[0.06]"></span><span class="h-8 rounded bg-white/[0.06]"></span></div>)}</div>
            <div data-error class="hidden px-5 py-14 text-center" role="alert"><p class="font-heading text-xl font-extrabold uppercase text-brand-coral">Couldn’t load the ledger</p><p data-error-copy class="mt-2 text-sm text-white/55">Check the connection and try again.</p><button data-retry type="button" class="mt-5 min-h-11 rounded-xl border border-white/15 px-5 text-xs font-extrabold uppercase tracking-wider text-white hover:border-brand-teal focus:outline-none focus:ring-2 focus:ring-brand-teal">Retry</button></div>
            <div data-empty class="hidden px-5 py-14 text-center"><p class="text-[10px] font-extrabold uppercase tracking-[0.2em] text-brand-teal">Nothing to chase</p><p class="mt-2 font-heading text-xl font-extrabold uppercase text-white">No accounts match this view</p><p class="mt-2 text-sm text-white/50">Try clearing a filter or changing the search.</p></div>
            <div data-account-list class="hidden divide-y divide-white/[0.06] xl:overflow-y-auto"></div>
          </section>

          <section id="finance-account-detail" data-detail-shell class="hidden overflow-hidden rounded-3xl border border-white/10 bg-[#11151d] xl:sticky xl:top-24 xl:max-h-[calc(100vh-7rem)] xl:overflow-y-auto" aria-labelledby="detail-heading">
            <button data-back-to-accounts type="button" class="mx-5 mt-5 inline-flex min-h-11 items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-white/65 hover:text-brand-teal focus:outline-none focus:ring-2 focus:ring-brand-teal xl:hidden">
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"></path></svg>
              Back to accounts
            </button>
            <div data-detail-loading class="hidden p-8 text-sm font-bold text-white/50" role="status">Loading account detail…</div>
            <div data-detail-error class="hidden p-8" role="alert"><p class="font-bold text-brand-coral">Account detail couldn’t be loaded.</p><button data-detail-retry type="button" class="mt-4 min-h-11 rounded-xl border border-white/15 px-4 text-xs font-extrabold uppercase text-white focus:outline-none focus:ring-2 focus:ring-brand-teal">Try again</button></div>
            <div data-detail></div>
          </section>
          </div>
        </div>
      )}
    </div>
  </main>

  {admin && <script>
    type Account = { registrationId:string; planId:string; playerName:string; parentName:string; parentEmail:string; teamName:string; registrationStatus:string; planStatus:string; financialStatus:string; needsReview:boolean; currentVersion:number; paymentOption:string|null; seasonTotal:number; paidAmount:number; remainingBalance:number; pendingRevisionId:string|null };
    type InitialCharge = { dueDate:string; amount:number };
    type InitialProposal = { proposalId:string; versionId:string; termsFingerprint:string; dueNowAmount:number; charges:InitialCharge[]; reason:string; adminNote?:string|null; status:string };
    type Candidate = { registrationId:string; playerName:string; parentName:string; parentEmail:string; teamName:string; seasonTotal:number; standardDeposit:number; pendingInitialPlan:InitialProposal|null };
    type Detail = Account & { billingSimulatorAvailable:boolean; stripePaidAmount:number; offlinePaidAmount:number; creditAmount:number; writeOffAmount:number; refundedAmount:number; netCollectedAmount:number; versions:any[]; installments:any[]; transactions:any[]; attempts:any[]; revisions:any[]; adjustments:any[] };
    const root = document.querySelector<HTMLElement>('[data-finance-workspace]');
    if (root) {
      const endpoint = '/api/admin/club-season-finances';
      const money = (cents:number) => new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(cents/100);
      const date = (value:string) => value ? new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}).format(new Date(`${value.slice(0,10)}T12:00:00Z`)) : '—';
      const localToday=()=>{const now=new Date();return new Date(now.getTime()-now.getTimezoneOffset()*60_000).toISOString().slice(0,10);};
      const esc = (value:unknown) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char] || char));
      const label = (value:string) => value.replaceAll('_',' ').replace(/\b\w/g,(char)=>char.toUpperCase());
      const statusTone = (value:string) => ['past_due','action_required','failed'].includes(value) ? 'coral' : ['current','paid','paid_in_full','succeeded','active'].includes(value) ? 'teal' : ['processing','pending_authorization'].includes(value) ? 'amber' : 'neutral';
      const pill = (value:string) => { const tone=statusTone(value); const cls=tone==='coral'?'border-brand-coral/35 bg-brand-coral/10 text-brand-coral':tone==='teal'?'border-brand-teal/35 bg-brand-teal/10 text-brand-teal':tone==='amber'?'border-amber-300/35 bg-amber-300/10 text-amber-300':'border-white/15 bg-white/5 text-white/65'; return `<span class="inline-flex rounded-md border px-2 py-1 text-[10px] font-extrabold uppercase tracking-[.12em] ${cls}">${esc(label(value))}</span>`; };
      const balanceRail = (a:Account, compact=false) => `<div class="${compact?'mt-3':'mt-5'} grid grid-cols-3 divide-x divide-white/10 overflow-hidden rounded-xl border border-white/10 bg-black/20"><div class="px-3 py-2"><p class="text-[10px] font-bold uppercase tracking-wider text-white/60">Total</p><p class="mt-1 font-heading ${compact?'text-base':'text-xl'} font-extrabold tabular-nums text-white">${money(a.seasonTotal)}</p></div><div class="px-3 py-2"><p class="text-[10px] font-bold uppercase tracking-wider text-white/60">Paid</p><p class="mt-1 font-heading ${compact?'text-base':'text-xl'} font-extrabold tabular-nums text-brand-teal">${money(a.paidAmount)}</p></div><div class="px-3 py-2"><p class="text-[10px] font-bold uppercase tracking-wider text-white/60">Remaining</p><p class="mt-1 font-heading ${compact?'text-base':'text-xl'} font-extrabold tabular-nums text-white">${money(a.remainingBalance)}</p></div></div>`;
      const search=root.querySelector<HTMLInputElement>('[data-search]'); const statusFilter=root.querySelector<HTMLSelectElement>('[data-status-filter]'); const teamFilter=root.querySelector<HTMLSelectElement>('[data-team-filter]'); const reviewFilter=root.querySelector<HTMLInputElement>('[data-review-filter]');
      const list=root.querySelector<HTMLElement>('[data-account-list]'); const loading=root.querySelector<HTMLElement>('[data-loading]'); const error=root.querySelector<HTMLElement>('[data-error]'); const empty=root.querySelector<HTMLElement>('[data-empty]'); const live=root.querySelector<HTMLElement>('[data-live-status]');
      const detailShell=root.querySelector<HTMLElement>('[data-detail-shell]'); const detail=root.querySelector<HTMLElement>('[data-detail]');
      let accounts:Account[]=[]; let candidates:Candidate[]=[]; let mode:'accounts'|'candidates'='accounts'; let selectedId=''; let selectedDetail:Detail|null=null;
      const setText=(selector:string,value:string|number)=>{const el=root.querySelector<HTMLElement>(selector);if(el)el.textContent=String(value)};
      const notify=(tone:'success'|'error',message:string)=>{ const toast=(window as any).toast; toast?.[tone]?.(message); if(live)live.textContent=message; };
      const billingSimulator=(d:Detail)=>d.billingSimulatorAvailable?`<section data-billing-simulator class="border-t border-amber-300/25 bg-amber-300/[.035] p-5 md:p-7" aria-labelledby="billing-simulator-heading"><div class="rounded-2xl border border-amber-300/35 bg-[#11130f] p-4 shadow-[inset_4px_0_0_rgba(253,224,71,.72)] md:p-5"><div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between"><div class="max-w-2xl"><div class="flex flex-wrap items-center gap-2"><p class="text-[10px] font-extrabold uppercase tracking-[.18em] text-amber-200">Controlled pilot · Stripe test mode</p><span class="rounded-md border border-amber-200/60 bg-amber-300 px-2 py-1 text-[10px] font-black uppercase tracking-[.15em] text-[#17170d]">Test mode only</span></div><h3 id="billing-simulator-heading" class="mt-2 font-heading text-2xl font-extrabold uppercase text-white">Billing recovery simulator</h3><p class="mt-2 text-sm leading-6 text-white/70">This mutates <strong class="text-white">${esc(d.playerName)}’s</strong> pilot account and sends the normal test notifications. It never contacts live Stripe.</p></div><p class="max-w-sm border-l-2 border-amber-300 pl-3 text-xs font-semibold leading-5 text-amber-100">Before you click: each run writes a real test attempt to the ledger. Success can also reduce the test balance.</p></div><div class="mt-5 grid gap-2 lg:grid-cols-3"><button data-billing-scenario="card_declined" data-scenario-label="declined card" type="button" class="min-h-[4.5rem] rounded-xl border border-brand-coral/40 bg-brand-coral/[.055] px-4 text-left transition hover:bg-brand-coral/10 focus:outline-none focus:ring-2 focus:ring-brand-coral disabled:cursor-wait disabled:opacity-40"><span class="block text-xs font-extrabold uppercase tracking-wider text-brand-coral">Simulate declined card</span><span class="mt-1 block text-xs leading-5 text-white/65">Schedules the next retry.</span></button><button data-billing-scenario="authentication_required" data-scenario-label="authentication required" type="button" class="min-h-[4.5rem] rounded-xl border border-amber-300/35 bg-amber-300/[.045] px-4 text-left transition hover:bg-amber-300/10 focus:outline-none focus:ring-2 focus:ring-amber-300 disabled:cursor-wait disabled:opacity-40"><span class="block text-xs font-extrabold uppercase tracking-wider text-amber-200">Simulate authentication required</span><span class="mt-1 block text-xs leading-5 text-white/65">Stops retries and flags manual action.</span></button><button data-billing-scenario="payment_succeeded" data-scenario-label="successful recovery" type="button" class="min-h-[4.5rem] rounded-xl border border-brand-teal/40 bg-brand-teal/[.055] px-4 text-left transition hover:bg-brand-teal/10 focus:outline-none focus:ring-2 focus:ring-brand-teal disabled:cursor-wait disabled:opacity-40"><span class="block text-xs font-extrabold uppercase tracking-wider text-brand-teal">Simulate successful recovery</span><span class="mt-1 block text-xs leading-5 text-white/65">Records payment and restores current status when appropriate.</span></button></div><p data-billing-simulator-status class="mt-3 min-h-5 text-sm font-semibold text-white/70" role="status" aria-live="polite"></p></div></section>`:'';
      const filtered=()=>{
        const query=(search?.value||'').trim().toLowerCase();
        const source=mode==='accounts'?accounts:candidates;
        return source.filter(item=>{
          const haystack=`${item.playerName} ${item.parentName} ${item.parentEmail} ${item.teamName}`.toLowerCase();
          if(query&&!haystack.includes(query))return false;
          if(teamFilter?.value&&item.teamName!==teamFilter.value)return false;
          if(mode==='candidates')return true;
          const account=item as Account;
          return (!statusFilter?.value||account.financialStatus===statusFilter.value)&&(!reviewFilter?.checked||account.needsReview||Boolean(account.pendingRevisionId));
        });
      };
      const renderList=()=>{
        if(!list)return;
        const visible=filtered();
        setText('[data-visible-count]',visible.length);
        list.classList.toggle('hidden',visible.length===0);
        empty?.classList.toggle('hidden',visible.length>0);
        list.innerHTML=visible.map(item=>{
          const selected=selectedId===item.registrationId;
          if(mode==='candidates'){
            const candidate=item as Candidate;
            return `<button type="button" data-candidate-id="${esc(candidate.registrationId)}" aria-controls="finance-account-detail" aria-pressed="${selected}" class="group min-h-[7.5rem] w-full border-l-4 px-4 py-4 text-left transition hover:bg-amber-300/[.035] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-amber-300 ${candidate.pendingInitialPlan?'border-l-amber-300':'border-l-transparent'} ${selected?'!border-l-brand-teal bg-brand-teal/[.045]':''}"><div class="flex items-start justify-between gap-4"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><strong class="font-heading text-lg font-extrabold uppercase text-white group-hover:text-amber-200">${esc(candidate.playerName)}</strong>${candidate.pendingInitialPlan?pill('pending_authorization'):''}</div><p class="mt-1 truncate text-xs text-white/60">${esc(candidate.parentName)} · ${esc(candidate.parentEmail)}</p><div class="mt-3 flex flex-wrap items-center gap-3"><span class="text-[10px] font-extrabold uppercase tracking-wider text-white/65">${esc(candidate.teamName)}</span><span class="font-heading text-base font-extrabold tabular-nums text-white">${money(candidate.seasonTotal)}</span></div></div><svg aria-hidden="true" class="mt-1 shrink-0 text-white/35 transition group-hover:translate-x-1 group-hover:text-amber-300" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg></div></button>`;
          }
          const account=item as Account;
          const urgent=['past_due','action_required'].includes(account.financialStatus);
          return `<button type="button" data-account-id="${esc(account.registrationId)}" aria-controls="finance-account-detail" aria-pressed="${selected}" class="group min-h-[7.5rem] w-full border-l-4 px-4 py-4 text-left transition hover:bg-white/[.035] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-brand-teal ${urgent?'border-l-brand-coral bg-brand-coral/[.025]':'border-l-transparent'} ${selected?'!border-l-brand-teal bg-brand-teal/[.045]':''}"><div class="flex items-start justify-between gap-4"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><strong class="font-heading text-lg font-extrabold uppercase text-white group-hover:text-brand-teal">${esc(account.playerName)}</strong>${account.needsReview?'<span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-300">Review</span>':''}</div><p class="mt-1 truncate text-xs text-white/60">${esc(account.parentName)} · ${esc(account.parentEmail)}</p><div class="mt-3 flex flex-wrap items-center gap-2"><span class="text-[10px] font-extrabold uppercase tracking-wider text-white/60">${esc(account.teamName)}</span>${pill(account.financialStatus)}</div></div><svg aria-hidden="true" class="mt-1 shrink-0 text-white/35 transition group-hover:translate-x-1 group-hover:text-brand-teal" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"></path></svg></div>${balanceRail(account,true)}</button>`;
        }).join('');
        list.querySelectorAll<HTMLButtonElement>('[data-account-id]').forEach(button=>button.addEventListener('click',()=>loadDetail(button.dataset.accountId||'')));
        list.querySelectorAll<HTMLButtonElement>('[data-candidate-id]').forEach(button=>button.addEventListener('click',()=>selectCandidate(button.dataset.candidateId||'')));
      };
      const populateFilters=()=>{ const statuses=[...new Set(accounts.map(a=>a.financialStatus))].sort(); const teams=[...new Set([...accounts,...candidates].map(a=>a.teamName))].sort(); if(statusFilter)statusFilter.innerHTML='<option value="">All statuses</option>'+statuses.map(v=>`<option value="${esc(v)}">${esc(label(v))}</option>`).join(''); if(teamFilter)teamFilter.innerHTML='<option value="">All teams</option>'+teams.map(v=>`<option value="${esc(v)}">${esc(v)}</option>`).join(''); };
