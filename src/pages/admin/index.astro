---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db';
import { registrations, registrationItems, events } from '../../db/schema';
import { desc, eq } from 'drizzle-orm';

const ADMIN_PASSCODE = import.meta.env.ADMIN_PASSCODE || 'tvvc2024';
let authenticated = false;
let error = null;
let latestTransactions = [];

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    if (data.get('passcode') === ADMIN_PASSCODE) {
      authenticated = true;
    } else {
      error = "Incorrect passcode.";
    }
  } catch (e) {
    error = "Error processing login.";
  }
}

if (Astro.url.searchParams.get('auth') === 'true') {
  authenticated = true;
}

if (authenticated) {
  try {
    const db = getDb(
      import.meta.env.TURSO_DATABASE_URL || '',
      import.meta.env.TURSO_AUTH_TOKEN || ''
    );
    
    // Get latest 5 paid registrations
    const recentRegistrations = await db.select()
      .from(registrations)
      .where(eq(registrations.status, 'paid'))
      .orderBy(desc(registrations.createdAt))
      .limit(5);

    // For each registration, get its items
    latestTransactions = await Promise.all(recentRegistrations.map(async (reg) => {
      const items = await db.select({
        eventName: events.name,
        type: events.type
      })
      .from(registrationItems)
      .innerJoin(events, eq(registrationItems.eventId, events.id))
      .where(eq(registrationItems.registrationId, reg.id));
      
      return {
        ...reg,
        items
      };
    }));
  } catch (e) {
    console.error("Dashboard Transaction Error:", e);
  }
}

const adminFeatures = [
  {
    title: "Camps & Clinics",
    description: "Manage summer camps and skill clinics registrations.",
    link: "/admin/registrations?stream=camps-clinics&auth=true",
    icon: "calendar",
    color: "brand-teal"
  },
  {
    title: "In-House Training",
    description: "Manage Ignition and Playworks training registrations.",
    link: "/admin/registrations?stream=in-house&auth=true",
    icon: "zap",
    color: "brand-coral"
  },
  {
    title: "Club Teams",
    description: "Manage tryouts and seasonal team registrations.",
    link: "/admin/registrations?stream=club-teams&auth=true",
    icon: "users",
    color: "brand-teal"
  },
  {
    title: "Small Group Training",
    description: "Manage training blocks and view session rosters.",
    link: "/admin/training-manager?auth=true",
    icon: "target",
    color: "brand-teal"
  },
  {
    title: "Feedback Management",
    description: "View and manage feedback from season participants.",
    link: "/admin/feedback?auth=true",
    icon: "message",
    color: "brand-coral"
  }
];
---

<BaseLayout title="Admin Dashboard" noindex={true}>
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-6xl mx-auto">
      {error && (
        <div class="max-w-2xl mx-auto mb-8 bg-brand-coral/10 border border-brand-coral/20 text-brand-coral p-4 rounded-xl text-center text-sm font-bold">
          {error}
        </div>
      )}

      {!authenticated ? (
        <div class="max-w-md mx-auto">
          <div class="glass-card p-8 border-white/10 text-center">
            <h1 class="text-2xl font-heading font-bold text-white mb-6 uppercase tracking-widest">Admin Access</h1>
            <form method="POST" class="space-y-4">
              <input type="password" name="passcode" placeholder="Enter Passcode" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none text-center" required />
              <button type="submit" class="btn btn-primary w-full">Login</button>
            </form>
          </div>
        </div>
      ) : (
        <div class="space-y-12">
          <div class="text-center space-y-4">
            <h1 class="text-4xl md:text-6xl font-heading font-bold text-white uppercase tracking-tighter">Admin <span class="text-brand-teal italic">Dashboard</span></h1>
            <p class="text-white/40 text-xs uppercase tracking-[0.3em] font-bold">Select a module to manage</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {adminFeatures.map(feature => (
              <a href={feature.link} class="group glass-card border-white/10 p-8 hover:border-brand-teal transition-all duration-300">
                <div class="space-y-4">
                  <div class={`w-12 h-12 rounded-xl bg-${feature.color}/10 border border-${feature.color}/20 flex items-center justify-center group-hover:scale-110 transition-transform`}>
                    {feature.icon === 'calendar' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`text-${feature.color}`}><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    )}
                    {feature.icon === 'zap' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`text-${feature.color}`}><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    )}
                    {feature.icon === 'users' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`text-${feature.color}`}><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    )}
                    {feature.icon === 'target' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`text-${feature.color}`}><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                    )}
                    {feature.icon === 'message' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`text-${feature.color}`}><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    )}
                  </div>
                  <div class="space-y-2">
                    <h2 class="text-xl font-heading font-bold text-white uppercase">{feature.title}</h2>
                    <p class="text-white/40 text-xs leading-relaxed">{feature.description}</p>
                  </div>
                  <div class={`text-[10px] font-bold uppercase tracking-widest text-${feature.color} pt-4 flex items-center gap-2`}>
                    Enter Module
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </div>
                </div>
              </a>
            ))}
          </div>

          {authenticated && latestTransactions.length > 0 && (
            <div class="space-y-6 pt-12 border-t border-white/5">
              <div class="flex items-center justify-between">
                <div class="space-y-1">
                  <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-brand-teal">Latest Transactions</h2>
                  <p class="text-white/40 text-[10px] uppercase tracking-widest font-bold">Recent activity across all paid services</p>
                </div>
              </div>

              <div class="glass-card border-white/10 overflow-hidden !p-0">
                <div class="overflow-x-auto">
                  <table class="w-full text-left border-collapse">
                    <thead>
                      <tr class="bg-white/5 border-b border-white/10">
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Parent / Customer</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Services Purchased</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Amount</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Date</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                      {latestTransactions.map(reg => (
                        <tr class="hover:bg-white/[0.02] transition-colors group">
                          <td class="px-6 py-5">
                            <div class="text-xs font-bold text-white uppercase">{reg.parentName}</div>
                            <div class="text-[10px] text-white/40">{reg.parentEmail}</div>
                          </td>
                          <td class="px-6 py-5">
                            <div class="flex flex-wrap gap-1">
                              {reg.items.map((item: any) => (
                                <span class={`px-2 py-0.5 rounded text-[8px] font-bold uppercase tracking-tighter ${
                                  item.type === 'camp' || item.type === 'clinic' ? 'bg-brand-teal/20 text-brand-teal' : 
                                  item.type === 'ignition' || item.type === 'playworks' ? 'bg-brand-coral/20 text-brand-coral' : 
                                  'bg-white/10 text-white/60'
                                }`}>
                                  {item.eventName}
                                </span>
                              ))}
                            </div>
                          </td>
                          <td class="px-6 py-5">
                            <div class="text-xs font-bold text-white tabular-nums">
                              ${(reg.totalAmount / 100).toFixed(2)}
                            </div>
                          </td>
                          <td class="px-6 py-5">
                            <div class="text-[10px] text-white/40 uppercase tracking-widest font-bold">
                              {new Date(reg.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
                            </div>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          )}

          <div class="pt-12 text-center border-t border-white/5">
            <p class="text-[10px] text-white/20 uppercase tracking-[0.2em] font-bold">TVVC Management System v1.0</p>
          </div>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
