---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db';
import { events, athletes, registrations, registrationItems } from '../../../db/schema';
import { eq, and } from 'drizzle-orm';
import { getSession } from 'auth-astro/server';

const { id } = Astro.params;

const session = await getSession(Astro.request);
const user = session?.user as any;
const isAdmin = user?.role === 'admin';
const ADMIN_PASSCODE = import.meta.env.ADMIN_PASSCODE || 'tvvc2024';

let eventData = null;
let roster = [];
let allActiveEvents = [];
let error = null;

const db = getDb(
  import.meta.env.TURSO_DATABASE_URL || '',
  import.meta.env.TURSO_AUTH_TOKEN || ''
);

try {
  const results = await db.select().from(events).where(eq(events.id, id as string));
  eventData = results[0];

  if (isAdmin && eventData) {
    // Join athletes with registrations through registrationItems for this specific event
    roster = await db.select({
      id: athletes.id,
      registrationItemId: registrationItems.id,
      registrationId: registrations.id,
      stripeSessionId: registrations.stripeSessionId,
      firstName: athletes.firstName,
      lastName: athletes.lastName,
      grade: athletes.grade,
      medicalInfo: athletes.medicalInfo,
      parentName: registrations.parentName,
      parentEmail: registrations.parentEmail,
      parentPhone: registrations.parentPhone,
      status: registrations.status,
      createdAt: registrations.createdAt,
    })
    .from(registrationItems)
    .innerJoin(athletes, eq(registrationItems.athleteId, athletes.id))
    .innerJoin(registrations, eq(registrationItems.registrationId, registrations.id))
    .where(and(
      eq(registrationItems.eventId, id as string),
      eq(registrations.status, 'paid') // Only show paid registrations in the roster
    ));

    // Fetch all active events for the transfer selection
    allActiveEvents = await db.select()
      .from(events)
      .where(eq(events.active, true))
      .orderBy(events.type, events.startDate);
  }
} catch (e) {
  console.error(e);
  error = "Database error.";
}

if (eventData && !isAdmin) {
    // Show restricted
} else if (!eventData) {
    return Astro.redirect('/admin/registrations');
}
---

<BaseLayout title={`Roster: ${eventData?.name || 'Event'}`} noindex={true}>
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
        <div>
          <a href="/admin/registrations" class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-teal hover:underline mb-4 inline-block">← Back to Manager</a>
          <h1 class="text-3xl md:text-5xl font-heading font-bold text-white leading-tight uppercase tracking-tighter">
            Event <span class="text-brand-teal italic">Roster</span>
          </h1>
          <p class="text-white/40 text-xs uppercase tracking-[0.3em] font-bold mt-2">{eventData.name}</p>
        </div>

        {isAdmin && (
           <div class="flex flex-wrap gap-3">
             <div class="glass-card px-6 py-3 border-white/5 text-center min-w-[120px]">
               <p class="text-[8px] font-bold uppercase text-white/30 tracking-widest mb-1">Enrolled</p>
               <p class="text-xl font-heading font-bold text-white">{roster.length} / {eventData.capacity}</p>
             </div>
             <button id="addPlayerBtn" class="btn btn-primary !py-3 !px-6 !text-[10px] uppercase tracking-widest flex items-center gap-2 h-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="16" y1="11" x2="22" y2="11"/></svg>
                Add Player
             </button>
             <button id="exportCsv" class="btn btn-secondary !py-3 !px-6 !text-[10px] uppercase tracking-widest flex items-center gap-2 h-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export CSV
             </button>
             <button id="copyEmailsBtn" class="btn border border-white/10 hover:border-brand-teal !py-3 !px-6 !text-[10px] uppercase tracking-widest flex items-center gap-2 h-full">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                Copy Emails
             </button>
           </div>
        )}
      </div>

      {!isAdmin ? (
        <div class="max-w-md mx-auto">
          <div class="glass-card p-8 border-white/10 text-center space-y-6">
            <h1 class="text-2xl font-heading font-bold text-white uppercase tracking-widest">Admin Access Restricted</h1>
            <p class="text-white/40 text-sm">You do not have permission to view this roster. Please sign in with an administrator account.</p>
            <a href="/portal/login?callbackUrl=/admin" class="btn btn-primary w-full">Sign In</a>
          </div>
        </div>
      ) : (
        <div class="space-y-6">
          <div class="glass-card border-white/10 overflow-hidden !p-0">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="bg-white/5 border-b border-white/10">
                    <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Athlete</th>
                    <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Grade</th>
                    <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Parent / Contact</th>
                    <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Details</th>
                    <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40">Registered</th>
                    <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-white/40 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  {roster.map(player => (
                    <tr class="hover:bg-white/[0.02] transition-colors group">
                      <td class="px-6 py-5">
                        <div class="font-heading font-bold text-white uppercase group-hover:text-brand-teal transition-colors">
                          {player.firstName} {player.lastName}
                        </div>
                      </td>
                      <td class="px-6 py-5 text-sm text-white/60">{player.grade}</td>
                      <td class="px-6 py-5">
                        <div class="flex items-center justify-between">
                          <div>
                            <div class="text-xs font-bold text-white uppercase">{player.parentName}</div>
                            <div class="text-[10px] text-white/40">{player.parentEmail}</div>
                            <div class="text-[10px] text-white/40">{player.parentPhone}</div>
                          </div>
                          {player.stripeSessionId && (
                            <a 
                              href={`https://dashboard.stripe.com/checkout-sessions/${player.stripeSessionId}`} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              class="opacity-0 group-hover:opacity-100 transition-opacity text-brand-teal hover:text-white"
                              title="View on Stripe"
                            >
                              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                            </a>
                          )}
                        </div>
                      </td>
                      <td class="px-6 py-5">
                        <div class="space-y-1">
                          {player.medicalInfo ? (
                             <p class="text-[10px] text-brand-coral font-medium max-w-[200px] line-clamp-2 mt-1" title={player.medicalInfo}>
                               ⚠️ {player.medicalInfo}
                             </p>
                          ) : (
                             <span class="text-[9px] font-bold uppercase text-white/20">No Medical Alerts</span>
                          )}
                        </div>
                      </td>
                      <td class="px-6 py-5 text-[11px] text-white/40 tabular-nums">
                        {new Date(player.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </td>
                      <td class="px-6 py-5 text-right">
                        <div class="flex flex-col items-end gap-1">
                          <button 
                            class="transfer-btn text-[9px] font-bold uppercase tracking-widest text-brand-teal hover:text-white transition-colors p-1"
                            data-item-id={player.registrationItemId}
                            data-player-name={`${player.firstName} ${player.lastName}`}
                          >
                            Transfer Event
                          </button>
                          <button 
                            class="remove-item-btn text-[9px] font-bold uppercase tracking-widest text-white/40 hover:text-brand-teal transition-colors p-1"
                            data-item-id={player.registrationItemId}
                            data-player-name={`${player.firstName} ${player.lastName}`}
                          >
                            Remove from Event
                          </button>
                          <button 
                            class="cancel-btn text-[8px] font-bold uppercase tracking-widest text-white/20 hover:text-brand-coral transition-colors p-1"
                            data-registration-id={player.registrationId}
                            data-player-name={`${player.firstName} ${player.lastName}`}
                          >
                            Cancel Full Order
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                  
                  {roster.length === 0 && (
                    <tr>
                      <td colspan="5" class="px-6 py-20 text-center">
                        <p class="text-white/20 uppercase tracking-widest font-bold text-xs">No paid registrations yet.</p>
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Manual Add Player Modal -->
    <div id="addPlayerModal" class="fixed inset-0 z-[100] hidden items-center justify-center px-4 bg-brand-charcoal/80 backdrop-blur-md">
      <div class="glass-card border-white/10 w-full max-w-2xl max-h-[90vh] overflow-y-auto p-8 md:p-12 relative animate-in fade-in zoom-in duration-300">
        <button id="closeModalBtn" class="absolute top-6 right-6 text-white/40 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

        <div class="mb-8">
          <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-tight">Manual <span class="text-brand-teal italic">Player Entry</span></h2>
          <p class="text-white/40 text-[10px] uppercase tracking-widest font-bold mt-2">Add athlete to {eventData.name}</p>
        </div>

        <form id="addPlayerForm" class="space-y-8">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">First Name</label>
              <input type="text" name="firstName" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none" />
            </div>
            <div class="space-y-2">
              <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Last Name</label>
              <input type="text" name="lastName" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none" />
            </div>
            <div class="space-y-2">
              <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Grade</label>
              <input type="text" name="grade" required placeholder="e.g. 7th" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none" />
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Parent Info (Optional)</label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <input type="text" name="parentName" placeholder="Parent Name" class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-white text-xs focus:border-brand-teal outline-none" />
              <input type="email" name="parentEmail" placeholder="Parent Email" class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-white text-xs focus:border-brand-teal outline-none" />
              <input type="tel" name="parentPhone" placeholder="Parent Phone" class="w-full bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-white text-xs focus:border-brand-teal outline-none" />
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Medical Info</label>
            <textarea name="medicalInfo" placeholder="Allergies, etc." class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none min-h-[80px]"></textarea>
          </div>

          <div class="pt-4 flex gap-4">
             <button type="button" id="cancelBtn" class="flex-1 py-4 border border-white/10 rounded-xl text-white/60 text-[10px] font-bold uppercase tracking-widest hover:bg-white/5 transition-all">Cancel</button>
             <button type="submit" id="submitManualBtn" class="flex-[2] btn btn-primary py-4 text-[10px] uppercase tracking-widest font-bold">Add to Roster</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Transfer Registration Modal -->
    <div id="transferModal" class="fixed inset-0 z-[100] hidden items-center justify-center px-4 bg-brand-charcoal/80 backdrop-blur-md">
      <div class="glass-card border-white/10 w-full max-w-xl p-8 relative animate-in fade-in zoom-in duration-300">
        <button id="closeTransferModalBtn" class="absolute top-6 right-6 text-white/40 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

        <div class="mb-8">
          <h2 class="text-2xl font-heading font-bold text-white uppercase tracking-tight">Transfer <span class="text-brand-teal italic">Registration</span></h2>
          <p id="transferPlayerName" class="text-white/40 text-[10px] uppercase tracking-widest font-bold mt-2"></p>
        </div>

        <div class="space-y-6">
          <div class="space-y-2">
            <label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Select New Event</label>
            <select id="newEventSelect" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none appearance-none cursor-pointer">
              <option value="" class="bg-brand-charcoal">-- Select Event --</option>
              {Object.entries(
                allActiveEvents.reduce((acc, event) => {
                  if (!acc[event.type]) acc[event.type] = [];
                  acc[event.type].push(event);
                  return acc;
                }, {} as Record<string, typeof allActiveEvents>)
              ).map(([type, typeEvents]) => (
                <optgroup label={type.toUpperCase()} class="bg-brand-charcoal text-white font-bold">
                  {typeEvents.filter(e => e.id !== id).map(e => (
                    <option value={e.id} class="bg-brand-charcoal text-white/80" disabled={e.spotsFilled >= e.capacity}>
                      {e.name} ({e.dateInfo}) {e.spotsFilled >= e.capacity ? '- FULL' : ''} - ${e.price / 100}
                    </option>
                  ))}
                </optgroup>
              ))}
            </select>
          </div>

          <div class="p-4 bg-brand-teal/5 border border-brand-teal/10 rounded-xl">
            <p class="text-[10px] text-white/60 leading-relaxed">
              <strong>Note:</strong> Transferring will update the roster and adjust available spots. If prices differ, additional charges or refunds must be handled manually in Stripe.
            </p>
          </div>

          <div class="pt-4 flex gap-4">
             <button type="button" id="cancelTransferBtn" class="flex-1 py-4 border border-white/10 rounded-xl text-white/60 text-[10px] font-bold uppercase tracking-widest hover:bg-white/5 transition-all">Cancel</button>
             <button type="button" id="submitTransferBtn" class="flex-[2] btn btn-primary py-4 text-[10px] uppercase tracking-widest font-bold">Transfer Player</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline define:vars={{ roster, eventName: eventData?.name, eventId: id, ADMIN_PASSCODE }}>
  // Modal Logic
  const modal = document.getElementById('addPlayerModal');
  const addBtn = document.getElementById('addPlayerBtn');
  const closeBtn = document.getElementById('closeModalBtn');
  const cancelBtn = document.getElementById('cancelBtn');
  const addForm = document.getElementById('addPlayerForm');

  const transferModal = document.getElementById('transferModal');
  const closeTransferBtn = document.getElementById('closeTransferModalBtn');
  const cancelTransferBtn = document.getElementById('cancelTransferBtn');
  const submitTransferBtn = document.getElementById('submitTransferBtn');
  const newEventSelect = document.getElementById('newEventSelect');
  const transferPlayerNameEl = document.getElementById('transferPlayerName');
  
  let currentTransferItemId = null;

  const openModal = () => {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
    addForm.reset();
  };

  const openTransferModal = (itemId, playerName) => {
    currentTransferItemId = itemId;
    transferPlayerNameEl.innerText = `Transferring ${playerName} to a different event`;
    transferModal.classList.remove('hidden');
    transferModal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeTransferModal = () => {
    transferModal.classList.add('hidden');
    transferModal.classList.remove('flex');
    document.body.style.overflow = 'auto';
    currentTransferItemId = null;
    newEventSelect.value = '';
  };

  addBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);

  closeTransferBtn?.addEventListener('click', closeTransferModal);
  cancelTransferBtn?.addEventListener('click', closeTransferModal);

  // Transfer Logic
  document.querySelectorAll('.transfer-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const itemId = btn.getAttribute('data-item-id');
      const playerName = btn.getAttribute('data-player-name');
      openTransferModal(itemId, playerName);
    });
  });

  submitTransferBtn?.addEventListener('click', async () => {
    const newEventId = newEventSelect.value;
    if (!newEventId) {
      window.toast.error('Please select a new event.');
      return;
    }

    submitTransferBtn.disabled = true;
    submitTransferBtn.innerText = 'Transferring...';

    try {
      const response = await fetch('/api/admin/transfer-registration', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          passcode: ADMIN_PASSCODE,
          itemId: parseInt(currentTransferItemId),
          newEventId
        }),
      });

      const result = await response.json();
      if (result.success) {
        window.location.reload();
      } else {
        window.toast.error(result.error || 'Failed to transfer registration');
        submitTransferBtn.disabled = false;
        submitTransferBtn.innerText = 'Transfer Player';
      }
    } catch (err) {
      window.toast.error('Network error');
      submitTransferBtn.disabled = false;
      submitTransferBtn.innerText = 'Transfer Player';
    }
  });

  // Form Submission
  addForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('submitManualBtn');
    submitBtn.disabled = true;
    submitBtn.innerText = 'Processing...';

    const formData = new FormData(addForm);
    const athlete = {
      firstName: formData.get('firstName'),
      lastName: formData.get('lastName'),
      grade: formData.get('grade'),
      parentName: formData.get('parentName'),
      parentEmail: formData.get('parentEmail'),
      parentPhone: formData.get('parentPhone'),
      medicalInfo: formData.get('medicalInfo'),
    };

    try {
      const response = await fetch('/api/admin/manual-register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          passcode: ADMIN_PASSCODE,
          athlete,
          eventId
        }),
      });

      const result = await response.json();
      if (result.success) {
        window.location.reload();
      } else {
        window.toast.error(result.error || 'Failed to add player');
        submitBtn.disabled = false;
        submitBtn.innerText = 'Add to Roster';
      }
    } catch (err) {
      window.toast.error('Network error');
      submitBtn.disabled = false;
      submitBtn.innerText = 'Add to Roster';
    }
  });

  // Remove Single Item Logic
  document.querySelectorAll('.remove-item-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const itemId = btn.getAttribute('data-item-id');
      const playerName = btn.getAttribute('data-player-name');
      
      if (confirm(`Remove ${playerName} from THIS event only?`)) {
        try {
          const response = await fetch('/api/admin/remove-item', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              passcode: ADMIN_PASSCODE,
              itemId: parseInt(itemId)
            }),
          });

          const result = await response.json();
          if (result.success) {
            window.location.reload();
          } else {
            window.toast.error(result.error || 'Failed to remove player');
          }
        } catch (err) {
          window.toast.error('Network error');
        }
      }
    });
  });

  // Cancel Registration Logic
  document.querySelectorAll('.cancel-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const registrationId = btn.getAttribute('data-registration-id');
      const playerName = btn.getAttribute('data-player-name');
      
      if (confirm(`Are you sure you want to cancel the registration for ${playerName}? This will remove them from ALL events in this registration and free up the spots.`)) {
        try {
          const response = await fetch('/api/admin/cancel-registration', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              passcode: ADMIN_PASSCODE,
              registrationId
            }),
          });

          const result = await response.json();
          if (result.success) {
            window.location.reload();
          } else {
            window.toast.error(result.error || 'Failed to cancel registration');
          }
        } catch (err) {
          window.toast.error('Network error');
        }
      }
    });
  });

  // CSV Export Logic
  document.getElementById('exportCsv')?.addEventListener('click', () => {
    if (!roster || roster.length === 0) return;
    
    const headers = ['First Name', 'Last Name', 'Grade', 'Parent Name', 'Parent Email', 'Parent Phone', 'Medical Info', 'Registered At'];
    const csvRows = [
      headers.join(','),
      ...roster.map(row => [
        row.firstName,
        row.lastName,
        row.grade,
        row.parentName,
        row.parentEmail,
        row.parentPhone,
        row.medicalInfo || 'None',
        row.createdAt
      ].map(val => {
        const escaped = ('' + val).replace(/"/g, '""');
        return `"${escaped}"`;
      }).join(','))
    ];
    
    const csvContent = csvRows.join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `roster_${eventName.toLowerCase().replace(/\s+/g, '_')}_${new Date().toISOString().split('T')[0]}.csv`);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Copy Emails Logic
  document.getElementById('copyEmailsBtn')?.addEventListener('click', () => {
    if (!roster || roster.length === 0) {
      window.toast.error('No emails to copy.');
      return;
    }
    
    const emails = [...new Set(roster.map(player => player.parentEmail))].join(', ');
    navigator.clipboard.writeText(emails).then(() => {
      const btn = document.getElementById('copyEmailsBtn');
      const originalContent = btn.innerHTML;
      btn.innerText = 'Copied!';
      btn.classList.add('!text-brand-teal');
      setTimeout(() => {
        btn.innerHTML = originalContent;
        btn.classList.remove('!text-brand-teal');
      }, 2000);
    }).catch(err => {
      console.error('Failed to copy emails: ', err);
      window.toast.error('Failed to copy to clipboard.');
    });
  });
</script>
