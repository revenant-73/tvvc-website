---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db';
import { feedback } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { getSession } from 'auth-astro/server';

const { id } = Astro.params;
const session = await getSession(Astro.request);
const user = session?.user as any;
const isAdmin = user?.role === 'admin';

let response = null;
let error = null;

if (isAdmin && Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = data.get('action');

  if (action === 'toggle-star') {
    try {
      const db = getDb(
        import.meta.env.TURSO_DATABASE_URL || '',
        import.meta.env.TURSO_AUTH_TOKEN || ''
      );
      const current = await db.select().from(feedback).where(eq(feedback.id, parseInt(id as string)));
      if (current[0]) {
        await db.update(feedback)
          .set({ starred: !current[0].starred })
          .where(eq(feedback.id, parseInt(id as string)));
      }
    } catch (e) {
      console.error(e);
    }
  } else if (action === 'delete') {
    try {
      const db = getDb(
        import.meta.env.TURSO_DATABASE_URL || '',
        import.meta.env.TURSO_AUTH_TOKEN || ''
      );
      await db.delete(feedback).where(eq(feedback.id, parseInt(id as string)));
      return Astro.redirect('/admin/feedback');
    } catch (e) {
      console.error(e);
      error = "Error deleting response.";
    }
  }
}

if (isAdmin) {
  try {
    const db = getDb(
      import.meta.env.TURSO_DATABASE_URL || '',
      import.meta.env.TURSO_AUTH_TOKEN || ''
    );
    const results = await db.select().from(feedback).where(eq(feedback.id, parseInt(id as string)));
    response = results[0];
    
    if (!response) {
      error = "Response not found.";
    }
  } catch (e) {
    console.error(e);
    error = "Error loading response.";
  }
}

const ratingClass = (val) => val >= 4 ? 'text-brand-teal' : (val <= 2 ? 'text-brand-coral' : 'text-white/60');

const sections = [
  {
    title: "Overall Experience",
    color: "brand-coral",
    fields: [
      { key: 'overallRating', label: 'Overall Rating', type: 'rating' },
      { key: 'bestParts', label: 'Best Parts', type: 'text' },
      { key: 'frustratingParts', label: 'Frustrating Parts', type: 'text' },
      { key: 'keepDoing', label: 'Keep Doing', type: 'text' },
      { key: 'considerChanging', label: 'Consider Changing', type: 'text' },
    ]
  },
  {
    title: "Coaching & Team",
    color: "brand-teal",
    fields: [
      { key: 'coachingPositive', label: 'Positive Env', type: 'rating' },
      { key: 'coachingGrowth', label: 'Growth', type: 'rating' },
      { key: 'practicesUseful', label: 'Practices', type: 'rating' },
      { key: 'encouragedProblemSolving', label: 'Prob Solving', type: 'rating' },
      { key: 'coachingWell', label: 'What Went Well', type: 'text' },
      { key: 'coachingImprove', label: 'Areas to Improve', type: 'text' },
      { key: 'teamEnvironment', label: 'Team Environment', type: 'text' },
    ]
  },
  {
    title: "Communication",
    color: "brand-coral",
    fields: [
      { key: 'clubCommunication', label: 'Club Comm', type: 'rating' },
      { key: 'teamCommunication', label: 'Team Comm', type: 'rating' },
      { key: 'easyToUnderstand', label: 'Logistics Clear', type: 'rating' },
      { key: 'communicationWell', label: 'Comm Well', type: 'text' },
      { key: 'communicationImprove', label: 'Comm Improve', type: 'text' },
      { key: 'confusionMoments', label: 'Moments of Confusion', type: 'text' },
    ]
  },
  {
    title: "Cost & Value",
    color: "brand-teal",
    fields: [
      { key: 'goodValue', label: 'Good Value', type: 'rating' },
      { key: 'timeCommitment', label: 'Time Commitment', type: 'rating' },
      { key: 'tournamentSchedule', label: 'Tournament Schedule', type: 'rating' },
      { key: 'betterValue', label: 'Better Value', type: 'text' },
      { key: 'unclearLogistics', label: 'Unclear Logistics', type: 'text' },
    ]
  },
  {
    title: "Player Growth",
    color: "brand-coral",
    fields: [
      { key: 'volleyballGrowth', label: 'VB Growth', type: 'rating' },
      { key: 'personalGrowth', label: 'Personal Growth', type: 'rating' },
      { key: 'noticeableGrowth', label: 'Noticeable Growth', type: 'text' },
      { key: 'supportNeeded', label: 'Support Needed', type: 'text' },
    ]
  },
  {
    title: "Future Direction",
    color: "brand-teal",
    fields: [
      { key: 'returnLikelihood', label: 'Return Likelihood', type: 'rating' },
      { key: 'returnIncentive', label: 'Return Incentive', type: 'text' },
      { key: 'additionalOpportunities', label: 'Opps Desired', type: 'special' },
      { key: 'importantOpportunities', label: 'Most Important Opps', type: 'text' },
      { key: 'futureHope', label: 'Future Hope', type: 'text' },
    ]
  },
  {
    title: "Final Thoughts",
    color: "white",
    fields: [
      { key: 'leadershipUnderstanding', label: 'Leadership Advice', type: 'text' },
      { key: 'appreciation', label: 'Appreciation', type: 'text' },
      { key: 'advice', label: 'One Piece of Advice', type: 'text' },
      { key: 'anythingElse', label: 'Anything Else', type: 'text' },
    ]
  }
];
---

<BaseLayout title="Feedback Detail" noindex={true}>
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-4xl mx-auto">
      <a href="/admin/feedback" class="inline-flex items-center gap-2 text-white/40 hover:text-brand-teal transition-colors mb-8 uppercase tracking-widest text-[10px] font-bold">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to List
      </a>

      {!isAdmin ? (
        <div class="max-w-md mx-auto">
          <div class="glass-card p-8 border-white/10 text-center space-y-6">
            <h1 class="text-2xl font-heading font-bold text-white uppercase tracking-widest">Admin Access Restricted</h1>
            <p class="text-white/40 text-sm">You do not have permission to view this page. Please sign in with an administrator account.</p>
            <a href="/portal/login?callbackUrl=/admin/feedback" class="btn btn-primary w-full">Sign In</a>
          </div>
        </div>
      ) : response ? (
        <div class="space-y-12">
          {/* Header */}
          <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-white/5 pb-8">
            <div class="space-y-2">
              <div class="flex items-center gap-4">
                <p class="text-brand-teal font-bold uppercase tracking-[0.3em] text-[10px]">Feedback Response</p>
                <form method="POST">
                   <input type="hidden" name="action" value="toggle-star" />
                   <button type="submit" class={`text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full border transition-all flex items-center gap-2 ${response.starred ? 'bg-brand-teal text-brand-charcoal border-brand-teal' : 'text-white/40 border-white/10 hover:border-brand-teal hover:text-brand-teal'}`}>
                     <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill={response.starred ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                     {response.starred ? 'Starred for Marketing' : 'Star for Marketing'}
                   </button>
                </form>
                <form method="POST" onsubmit="return confirm('Are you sure you want to delete this feedback? This action cannot be undone.')">
                   <input type="hidden" name="action" value="delete" />
                   <button type="submit" class="text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full border border-brand-coral/20 text-brand-coral/60 hover:bg-brand-coral/10 hover:text-brand-coral transition-all flex items-center gap-2">
                     <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                     Delete
                   </button>
                </form>
              </div>
              <h1 class="text-4xl font-heading font-bold text-white uppercase tracking-tighter">
                {response.anonymous === 'Yes' ? 'Anonymous' : (response.name || 'Anonymous')}
              </h1>
              <div class="flex gap-3 text-xs text-white/40 uppercase tracking-widest font-bold">
                <span>{response.team}</span>
                <span>•</span>
                <span>{response.userType}</span>
              </div>
            </div>
            <div class="text-left md:text-right">
              <p class="text-[10px] text-white/20 uppercase font-bold tracking-widest mb-1">Date Submitted</p>
              <p class="text-white font-medium">
                {new Date(response.createdAt).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
              </p>
            </div>
          </div>

          <div class="space-y-16">
            {sections.map(section => {
              const visibleFields = section.fields.filter(field => {
                const val = response[field.key];
                if (field.type === 'rating') return val !== null && val !== undefined;
                if (field.type === 'special' && field.key === 'additionalOpportunities') {
                  try {
                    return val && JSON.parse(val).length > 0;
                  } catch { return false; }
                }
                return val && val.trim().length > 0;
              });

              if (visibleFields.length === 0) return null;

              const ratings = visibleFields.filter(f => f.type === 'rating');
              const texts = visibleFields.filter(f => f.type === 'text');
              const specials = visibleFields.filter(f => f.type === 'special');

              return (
                <section class="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
                  <h2 class={`text-xl font-heading font-bold text-white uppercase tracking-widest italic border-l-4 border-${section.color} pl-4`}>
                    {section.title}
                  </h2>
                  
                  {ratings.length > 0 && (
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                      {ratings.map(f => (
                        <div class="text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
                          <p class="text-[9px] uppercase font-bold text-white/30 mb-2 tracking-widest leading-tight h-8 flex items-center justify-center">{f.label}</p>
                          <p class={`text-3xl font-heading font-bold ${ratingClass(response[f.key])}`}>{response[f.key]}<span class="text-xs text-white/10 ml-1">/5</span></p>
                        </div>
                      ))}
                    </div>
                  )}

                  {texts.length > 0 && (
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                      {texts.map(f => (
                        <div class="space-y-2">
                          <p class={`text-[10px] uppercase font-bold text-${section.color}/60 tracking-widest`}>{f.label}</p>
                          <p class="text-white/80 leading-relaxed bg-white/5 p-4 rounded-xl border border-white/5 min-h-[100px] whitespace-pre-wrap">{response[f.key]}</p>
                        </div>
                      ))}
                    </div>
                  )}

                  {specials.map(f => {
                    if (f.key === 'additionalOpportunities') {
                      const opts = JSON.parse(response[f.key]);
                      return (
                        <div class="space-y-2">
                          <p class={`text-[10px] uppercase font-bold text-${section.color}/60 tracking-widest`}>{f.label}</p>
                          <div class="bg-white/5 p-4 rounded-xl border border-white/5">
                            <div class="flex flex-wrap gap-2">
                              {opts.map(opt => (
                                <span class="text-[10px] px-2 py-1 bg-brand-teal/10 text-brand-teal rounded border border-brand-teal/20 uppercase font-bold tracking-tighter">{opt}</span>
                              ))}
                            </div>
                          </div>
                        </div>
                      );
                    }
                    return null;
                  })}
                </section>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="text-brand-coral font-bold uppercase tracking-widest">{error || "Something went wrong."}</p>
          <a href="/admin/feedback" class="btn btn-secondary mt-8">Back to List</a>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
