---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db';
import { feedback } from '../../db/schema';
import { desc } from 'drizzle-orm';

const ADMIN_PASSCODE = import.meta.env.ADMIN_PASSCODE || 'tvvc2024';
let authenticated = false;
let responses = [];
let error = null;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    if (data.get('passcode') === ADMIN_PASSCODE) {
      authenticated = true;
    } else {
      error = "Incorrect passcode.";
    }
  } catch (e) {
    error = "Error processing login.";
  }
}

if (authenticated || Astro.url.searchParams.get('auth') === 'true') {
  authenticated = true;
  try {
    const db = getDb(
      import.meta.env.TURSO_DATABASE_URL || '',
      import.meta.env.TURSO_AUTH_TOKEN || ''
    );
    
    if (!import.meta.env.TURSO_DATABASE_URL) {
      throw new Error("Database configuration missing.");
    }

    responses = await db.select().from(feedback).orderBy(desc(feedback.createdAt));
  } catch (e) {
    console.error("Dashboard Database Error:", e);
    error = "Could not load responses. Check database connection and environment variables.";
  }
}

const stats = {
  total: responses.length,
  avgRating: responses.length > 0 
    ? (responses.reduce((acc, curr) => acc + curr.overallRating, 0) / responses.length).toFixed(1)
    : 0
};
---

<BaseLayout title="Feedback Admin" noindex={true}>
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-7xl mx-auto">
      {error && (
        <div class="max-w-2xl mx-auto mb-8 bg-brand-coral/10 border border-brand-coral/20 text-brand-coral p-4 rounded-xl text-center text-sm font-bold">
          {error}
        </div>
      )}

      {!authenticated ? (
        <div class="max-w-md mx-auto">
          <div class="glass-card p-8 border-white/10 text-center">
            <h1 class="text-2xl font-heading font-bold text-white mb-6 uppercase tracking-widest">Admin Access</h1>
            <form method="POST" class="space-y-4">
              <input 
                type="password" 
                name="passcode" 
                placeholder="Enter Passcode" 
                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none text-center"
                required 
              />
              <button type="submit" class="btn btn-primary w-full">Login</button>
            </form>
          </div>
        </div>
      ) : (
        <div class="space-y-8">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
              <h1 class="text-4xl font-heading font-bold text-white uppercase tracking-tighter">Season <span class="text-brand-teal italic">Feedback</span></h1>
              <p class="text-white/40 text-sm uppercase tracking-widest mt-2">Dashboard</p>
            </div>
            <div class="flex gap-4">
              <div class="glass-card px-6 py-4 border-white/5 flex flex-col items-center min-w-[120px]">
                <span class="text-[10px] font-bold uppercase text-brand-teal tracking-widest mb-1">Total Responses</span>
                <span class="text-3xl font-heading font-bold text-white">{stats.total}</span>
              </div>
              <div class="glass-card px-6 py-4 border-white/5 flex flex-col items-center min-w-[120px]">
                <span class="text-[10px] font-bold uppercase text-brand-coral tracking-widest mb-1">Avg Rating</span>
                <span class="text-3xl font-heading font-bold text-white">{stats.avgRating}</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-4">
            {responses.map((res) => (
              <a href={`/admin/feedback/${res.id}`} class="glass-card border-white/10 p-4 md:p-6 hover:border-brand-teal/50 hover:bg-white/[0.02] transition-all group">
                <div class="flex items-center justify-between gap-4">
                  <div class="flex items-center gap-4 md:gap-8">
                    <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/5 flex items-center justify-center text-brand-teal font-heading font-bold border border-white/5 group-hover:border-brand-teal/30 transition-colors">
                      {res.overallRating}
                    </div>
                    <div class="space-y-1">
                      <h3 class="text-sm md:text-lg font-heading font-bold text-white uppercase tracking-tight">
                        {res.anonymous === 'Yes' ? 'Anonymous' : (res.name || 'Anonymous')}
                      </h3>
                      <p class="text-[10px] md:text-xs text-white/40 uppercase tracking-widest font-bold">
                        {res.team} • {res.userType}
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-6">
                    <div class="hidden md:block text-right">
                      <p class="text-[10px] text-white/20 uppercase font-bold tracking-widest">Submitted</p>
                      <p class="text-xs text-white/60 font-medium">
                        {new Date(res.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                      </p>
                    </div>
                    <div class="text-white/20 group-hover:text-brand-teal transition-colors">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </div>
                  </div>
                </div>
              </a>
            ))}
            
            {responses.length === 0 && (
              <div class="glass-card p-20 text-center border-white/5">
                <p class="text-white/30 uppercase tracking-[0.2em] font-bold">No responses found yet.</p>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
