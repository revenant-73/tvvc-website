---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../db';
import { events } from '../../../db/schema';
import { eq } from 'drizzle-orm';
import { getSession } from 'auth-astro/server';

const { id } = Astro.params;

const session = await getSession(Astro.request);
const user = session?.user as any;
const isAdmin = user?.role === 'admin';

let eventData = null;
let error = null;
let success = null;

const db = getDb(
  import.meta.env.TURSO_DATABASE_URL || '',
  import.meta.env.TURSO_AUTH_TOKEN || ''
);

if (isAdmin && Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const newCapacity = parseInt(data.get('capacity') as string);
    const newSpotsFilled = parseInt(data.get('spotsFilled') as string);
    const emailDetails = data.get('emailDetails') as string;
    const waitlistEnabled = data.get('waitlistEnabled') === 'on';
    
    if (!isNaN(newCapacity) && !isNaN(newSpotsFilled)) {
      await db.update(events)
        .set({ 
          capacity: newCapacity,
          spotsFilled: newSpotsFilled,
          waitlistEnabled,
          emailDetails: emailDetails
        })
        .where(eq(events.id, id as string));
      success = "Event updated successfully.";
    }
  } catch (e) {
    error = "Error processing update.";
  }
}

try {
  const results = await db.select().from(events).where(eq(events.id, id as string));
  eventData = results[0];
} catch (e) {
  error = "Could not load event data.";
}

if (!isAdmin && !eventData) return Astro.redirect('/admin/registrations');
if (eventData && !isAdmin) {
    // We allow loading the page but will show restricted message
} else if (!eventData) {
    return Astro.redirect('/admin/registrations');
}
---

<BaseLayout title={`Edit ${eventData?.name || 'Event'}`} noindex={true}>
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-2xl mx-auto">
      <a href="/admin/registrations" class="text-xs font-bold uppercase tracking-widest text-brand-teal hover:underline mb-8 inline-block">← Back to Dashboard</a>

      {error && (
        <div class="mb-8 bg-brand-coral/10 border border-brand-coral/20 text-brand-coral p-4 rounded-xl text-center text-sm font-bold">
          {error}
        </div>
      )}
      
      {success && (
        <div class="mb-8 bg-brand-teal/10 border border-brand-teal/20 text-brand-teal p-4 rounded-xl text-center text-sm font-bold">
          {success}
        </div>
      )}

      {!isAdmin ? (
        <div class="glass-card p-8 border-white/10 text-center space-y-6">
          <h1 class="text-2xl font-heading font-bold text-white uppercase tracking-widest">Admin Access Restricted</h1>
          <p class="text-white/40 text-sm">You do not have permission to edit this event. Please sign in with an administrator account.</p>
          <a href="/portal/login?callbackUrl=/admin/registrations" class="btn btn-primary w-full">Sign In</a>
        </div>
      ) : (
        <div class="glass-card p-8 md:p-12 border-white/10">
          <span class="text-[10px] font-bold text-white/40 uppercase tracking-[0.2em] mb-4 block">Manage Event</span>
          <h1 class="text-3xl font-heading font-bold text-white mb-2 leading-tight">{eventData.name}</h1>
          <p class="text-xs text-white/40 uppercase tracking-widest font-bold mb-8">{eventData.dateInfo} • {eventData.timeInfo}</p>

          <form method="POST" class="space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-3">
              <label class="text-[10px] font-bold uppercase tracking-widest text-white/50">Maximum Capacity</label>
              <input 
                type="number" 
                name="capacity" 
                value={eventData.capacity} 
                min="0"
                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 text-2xl font-heading font-bold text-white focus:border-brand-teal outline-none" 
                required 
              />
            </div>

            <div class="space-y-3">
              <label class="text-[10px] font-bold uppercase tracking-widest text-white/50">Current Enrollment</label>
              <input 
                type="number" 
                name="spotsFilled" 
                value={eventData.spotsFilled} 
                min="0"
                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 text-2xl font-heading font-bold text-brand-teal focus:border-brand-teal outline-none" 
                required 
              />
            </div>
          </div>

          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5">
            <label class="flex cursor-pointer items-start gap-4">
              <input
                type="checkbox"
                name="waitlistEnabled"
                checked={eventData.waitlistEnabled}
                class="mt-1 h-5 w-5 rounded border-white/20 bg-brand-charcoal text-brand-teal focus:ring-brand-teal"
              />
              <span>
                <span class="block text-[10px] font-bold uppercase tracking-widest text-brand-teal">Enable waitlist</span>
                <span class="mt-1 block text-sm leading-6 text-white/55">
                  When this event is full, families can join the waitlist instead of being blocked completely. They are not charged when joining.
                </span>
              </span>
            </label>
          </div>

          <div class="space-y-3">
            <label class="text-[10px] font-bold uppercase tracking-widest text-white/50">Email Confirmation Details (HTML supported)</label>
            <textarea 
              name="emailDetails" 
              rows="6"
              placeholder="Add specific instructions, location details, or equipment needs for this event..."
              class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none min-h-[150px]"
            >{eventData.emailDetails}</textarea>
            <p class="text-[9px] text-white/30 uppercase tracking-widest">These details will be included in the automated registration confirmation email.</p>
          </div>

          <button type="submit" class="btn btn-primary w-full py-4 text-sm uppercase tracking-widest font-bold">Update Event Details</button>
        </form>
      </div>
    )}
    </div>
  </main>
</BaseLayout>
