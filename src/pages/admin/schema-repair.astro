---
export const prerender = false;

import { createClient } from '@libsql/client';
import { eq } from 'drizzle-orm';
import { getSession } from 'auth-astro/server';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db';
import { users } from '../../db/schema';
import { rejectCrossOriginRequest } from '../../lib/request-security';
import {
  auditProductionSchema,
  deleteOrphanedManualRegistration,
  repairProductionSchema,
} from '../../lib/production-schema-repair';

const databaseUrl = import.meta.env.TURSO_DATABASE_URL || process.env.TURSO_DATABASE_URL || '';
const authToken = import.meta.env.TURSO_AUTH_TOKEN || process.env.TURSO_AUTH_TOKEN || '';
const session = await getSession(Astro.request);
const sessionUserId = (session?.user as { id?: string } | undefined)?.id;
const db = databaseUrl ? getDb(databaseUrl, authToken) : null;
const [adminUser] = db && sessionUserId
  ? await db.select({ role: users.role }).from(users).where(eq(users.id, sessionUserId)).limit(1)
  : [];
const isAdmin = adminUser?.role === 'admin';

let error = '';
let success = '';
let report = null;

if (isAdmin && databaseUrl) {
  const client = createClient({ url: databaseUrl, authToken: authToken || undefined });
  try {
    if (Astro.request.method === 'POST') {
      const originRejection = rejectCrossOriginRequest(Astro.request);
      if (originRejection) return originRejection;

      const form = await Astro.request.formData();
      const action = String(form.get('action') || '');
      const confirmation = String(form.get('confirmation') || '');

      if (action === 'repair-schema') {
        if (confirmation !== 'APPLY') throw new Error('Schema repair confirmation was invalid.');
        const repair = await repairProductionSchema(client);
        success = repair.after.missingSteps.length === 0
          ? `Schema repaired successfully. Backup: ${repair.backupTable}`
          : `Repair completed, but steps remain: ${repair.after.missingSteps.join(', ')}`;
      } else if (action === 'delete-orphan') {
        const registrationId = String(form.get('registrationId') || '');
        if (confirmation !== 'DELETE') throw new Error('Orphan deletion confirmation was invalid.');
        const deleted = await deleteOrphanedManualRegistration(client, registrationId);
        success = deleted
          ? `Deleted orphaned registration ${registrationId} after backing it up.`
          : 'Registration was not deleted because it was not a safe orphan candidate.';
      }
    }

    report = await auditProductionSchema(client);
  } catch (caught) {
    console.error('Production schema repair error:', caught);
    error = caught instanceof Error ? caught.message : 'Schema repair failed.';
  } finally {
    client.close();
  }
}
---

<BaseLayout title="Production Schema Repair" noindex={true}>
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-4xl mx-auto space-y-8">
      <a href="/admin" class="text-xs font-bold uppercase tracking-widest text-brand-teal hover:underline">← Admin</a>
      <h1 class="text-4xl font-heading font-bold text-white uppercase">Production Schema Repair</h1>

      {!isAdmin ? (
        <div class="glass-card border-white/10 p-8">
          <p class="text-brand-coral font-bold">Administrator access required.</p>
        </div>
      ) : !databaseUrl ? (
        <div class="glass-card border-white/10 p-8">
          <p class="text-brand-coral font-bold">Database configuration missing.</p>
        </div>
      ) : (
        <>
          {error && <div class="glass-card border-brand-coral/30 p-6 text-brand-coral">{error}</div>}
          {success && <div class="glass-card border-brand-teal/30 p-6 text-brand-teal">{success}</div>}

          <section class="glass-card border-white/10 p-8 space-y-5">
            <h2 class="text-xl font-heading font-bold text-white uppercase">Schema audit</h2>
            <dl class="grid sm:grid-cols-2 gap-3 text-sm">
              <dt class="text-white/50">player_profiles table</dt><dd>{report?.playerProfilesTable ? 'Present' : 'Missing'}</dd>
              <dt class="text-white/50">athletes.profile_id</dt><dd>{report?.athletesProfileId ? 'Present' : 'Missing'}</dd>
              <dt class="text-white/50">Profile lifecycle columns</dt><dd>{report?.playerProfilesArchivedAt && report?.playerProfilesMergedIntoProfileId ? 'Present' : 'Missing'}</dd>
              <dt class="text-white/50">household_guardians table</dt><dd>{report?.householdGuardiansTable ? 'Present' : 'Missing'}</dd>
            </dl>

            {report && report.missingSteps.length > 0 ? (
              <div class="space-y-4 pt-4 border-t border-white/10">
                <p class="text-brand-coral text-sm font-bold">Missing: {report.missingSteps.join(', ')}</p>
                <form method="POST" class="flex flex-wrap items-end gap-3">
                  <input type="hidden" name="action" value="repair-schema" />
                  <label class="space-y-1">
                    <span class="block text-[10px] uppercase tracking-widest text-white/40">Type APPLY</span>
                    <input name="confirmation" required class="bg-white/5 border border-white/10 rounded-xl px-4 py-3" />
                  </label>
                  <button class="btn btn-primary" type="submit">Back Up & Repair</button>
                </form>
              </div>
            ) : (
              <p class="text-brand-teal text-sm font-bold pt-4 border-t border-white/10">Schema is current.</p>
            )}
          </section>

          <section class="glass-card border-white/10 p-8 space-y-5">
            <h2 class="text-xl font-heading font-bold text-white uppercase">Manual registrations</h2>
            {report && report.manualRegistrations.length > 0 ? (
              <div class="space-y-3">
                {report.manualRegistrations.map((registration) => (
                  <div class="border border-white/10 rounded-xl p-4 flex flex-wrap items-center justify-between gap-4">
                    <div class="text-xs">
                      <p class="font-mono text-white">{registration.id}</p>
                      <p class="text-white/40">Status: {registration.status} · Athletes: {registration.athleteCount} · Items: {registration.itemCount}</p>
                    </div>
                    {registration.athleteCount === 0 && registration.itemCount === 0 && (
                      <form method="POST" class="flex items-end gap-2">
                        <input type="hidden" name="action" value="delete-orphan" />
                        <input type="hidden" name="registrationId" value={registration.id} />
                        <label class="space-y-1">
                          <span class="block text-[9px] uppercase tracking-widest text-white/40">Type DELETE</span>
                          <input name="confirmation" required class="w-28 bg-white/5 border border-white/10 rounded-lg px-3 py-2 text-xs" />
                        </label>
                        <button class="btn btn-secondary !py-2 !px-3 !text-[9px]" type="submit">Back Up & Delete</button>
                      </form>
                    )}
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-white/40 text-sm">No manual registrations found.</p>
            )}
          </section>
        </>
      )}
    </div>
  </main>
</BaseLayout>
