---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../db';
import { events } from '../../db/schema';
import { desc, asc, eq } from 'drizzle-orm';

const ADMIN_PASSCODE = import.meta.env.ADMIN_PASSCODE || 'tvvc2024';
let authenticated = false;
let allEvents = [];
let error = null;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    if (data.get('passcode') === ADMIN_PASSCODE) {
      authenticated = true;
    } else {
      error = "Incorrect passcode.";
    }
  } catch (e) {
    error = "Error processing login.";
  }
}

if (authenticated || Astro.url.searchParams.get('auth') === 'true') {
  authenticated = true;
  try {
    const db = getDb(
      import.meta.env.TURSO_DATABASE_URL || '',
      import.meta.env.TURSO_AUTH_TOKEN || ''
    );
    
    allEvents = await db.select().from(events).orderBy(asc(events.type), asc(events.dateInfo));
  } catch (e) {
    console.error("Dashboard Database Error:", e);
    error = "Database error. Check connection.";
  }
}

const camps = allEvents.filter(e => e.type === 'camp');
const clinics = allEvents.filter(e => e.type === 'clinic');

// Chronological sorting for clinics
const sortedClinics = [...clinics].sort((a, b) => {
  const months = { 'May': 5, 'June': 6, 'July': 7, 'August': 8 };
  const getMonthDay = (info: string) => {
    const match = info.match(/(May|June|July|August)\s+(\d+)/);
    if (!match) return 0;
    return months[match[1] as keyof typeof months] * 100 + parseInt(match[2]);
  };
  return getMonthDay(a.dateInfo) - getMonthDay(b.dateInfo);
});

// Group clinics by date
const groupedClinics = sortedClinics.reduce((acc, clinic) => {
  const date = clinic.dateInfo;
  if (!acc[date]) acc[date] = [];
  acc[date].push(clinic);
  return acc;
}, {} as Record<string, typeof clinics>);
---

<BaseLayout title="Registration Admin" noindex={true}>
  <main class="pt-32 pb-24 px-4 md:px-6">
    <div class="max-w-7xl mx-auto">
      {error && (
        <div class="max-w-2xl mx-auto mb-8 bg-brand-coral/10 border border-brand-coral/20 text-brand-coral p-4 rounded-xl text-center text-sm font-bold">
          {error}
        </div>
      )}

      {!authenticated ? (
        <div class="max-w-md mx-auto">
          <div class="glass-card p-8 border-white/10 text-center">
            <h1 class="text-2xl font-heading font-bold text-white mb-6 uppercase tracking-widest">Admin Access</h1>
            <form method="POST" class="space-y-4">
              <input type="password" name="passcode" placeholder="Enter Passcode" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:border-brand-teal outline-none text-center" required />
              <button type="submit" class="btn btn-primary w-full">Login</button>
            </form>
          </div>
        </div>
      ) : (
        <div class="space-y-12">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
            <div class="space-y-2">
              <h1 class="text-4xl md:text-5xl font-heading font-bold text-white uppercase tracking-tighter">Event <span class="text-brand-teal italic">Manager</span></h1>
              <p class="text-white/40 text-xs uppercase tracking-[0.3em] font-bold">Summer 2026 Registration</p>
            </div>
          </div>

          <!-- Camps -->
          <section>
            <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-brand-teal mb-6">Summer Camps</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {camps.map(event => (
                <div class="glass-card border-white/10 p-6 space-y-4">
                  <div>
                    <h3 class="font-heading font-bold text-lg text-white leading-tight">{event.name}</h3>
                    <p class="text-[10px] text-white/40 uppercase tracking-widest font-bold mt-1">{event.dateInfo} • {event.timeInfo}</p>
                  </div>
                  
                  <div class="flex items-center justify-between py-4 border-y border-white/5">
                    <div>
                      <p class="text-[8px] font-bold uppercase text-white/30 tracking-widest mb-1">Enrolled</p>
                      <p class="text-2xl font-heading font-bold text-white">{event.spotsFilled} / <span class="text-white/40 text-lg">{event.capacity}</span></p>
                    </div>
                    <div class="h-1.5 w-24 bg-white/5 rounded-full overflow-hidden">
                      <div class={`h-full ${event.spotsFilled >= event.capacity ? 'bg-brand-coral' : 'bg-brand-teal'} rounded-full`} style={`width: ${Math.min((event.spotsFilled / event.capacity) * 100, 100)}%`}></div>
                    </div>
                  </div>

                  <div class="flex gap-2">
                    <a href={`/admin/roster/${event.id}?auth=true`} class="btn btn-secondary !py-2 !px-4 !text-[10px] flex-1 text-center">Roster</a>
                    <a href={`/admin/events/${event.id}?auth=true`} class="btn border border-white/10 hover:border-brand-teal transition-colors !py-2 !px-4 !text-[10px] text-center">Edit Cap</a>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Clinics -->
          <section>
            <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-brand-coral mb-6">Summer Clinics (Grouped by Date)</h2>
            <div class="space-y-8">
              {Object.entries(groupedClinics).map(([date, clinicsForDate]) => (
                <div class="space-y-4">
                  <h3 class="text-[10px] font-bold uppercase tracking-widest text-white/40 border-b border-white/5 pb-2">{date}</h3>
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    {clinicsForDate.map(event => (
                      <div class="glass-card border-white/10 p-5 space-y-4">
                        <div>
                          <h3 class="font-heading font-bold text-sm text-white leading-tight">{event.name}</h3>
                          <p class="text-[9px] text-white/40 uppercase tracking-widest font-bold mt-1">{event.timeInfo}</p>
                        </div>
                        
                        <div class="flex items-center justify-between">
                          <p class="text-lg font-heading font-bold text-white">{event.spotsFilled} / <span class="text-white/40 text-sm">{event.capacity}</span></p>
                          <div class="h-1 w-16 bg-white/5 rounded-full overflow-hidden">
                            <div class={`h-full ${event.spotsFilled >= event.capacity ? 'bg-brand-coral' : 'bg-brand-coral/50'} rounded-full`} style={`width: ${Math.min((event.spotsFilled / event.capacity) * 100, 100)}%`}></div>
                          </div>
                        </div>

                        <div class="flex gap-2 pt-2">
                          <a href={`/admin/roster/${event.id}?auth=true`} class="text-[9px] font-bold uppercase tracking-widest text-brand-teal hover:underline">Roster</a>
                          <span class="text-white/10">•</span>
                          <a href={`/admin/events/${event.id}?auth=true`} class="text-[9px] font-bold uppercase tracking-widest text-white/40 hover:text-white transition-colors">Edit</a>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
