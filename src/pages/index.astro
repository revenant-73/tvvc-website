---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import KineticMarquee from '../components/KineticMarquee.astro';
import LiquidBlobs from '../components/LiquidBlobs.astro';
import { Image, getImage } from 'astro:assets';
import heroImage from '../assets/images/hero-volleyball-action.jpg';
import teamTealImage from '../assets/images/14 Teal.jpg';
import teamWhiteImage from '../assets/images/14 White.jpeg';
import playersActionImage from '../assets/images/16 teeal 2.jpeg';

const optimizedHero = await getImage({ src: heroImage, format: 'webp', width: 1920 });

const valueGroups = [
  {
    category: 'The Mindset',
    tagline: 'How we think about growth',
    accent: 'brand-teal',
    values: [
      { icon: '🤔', title: 'Curiosity Over Certainty', description: 'We embrace questions, exploration, and learning through experience—because growth comes from the unknown.', size: 'large' },
      { icon: '🔄', title: 'Adaptability in Action', description: 'Thrive in dynamic, unpredictable game situations.', size: 'small' },
      { icon: '🎯', title: 'Athlete Ownership', description: 'Players are active participants in their learning journey.', size: 'small' }
    ]
  },
  {
    category: 'The Training',
    tagline: 'Our approach on the court',
    accent: 'brand-coral',
    values: [
      { icon: '🏐', title: 'Play with Purpose', description: 'Every activity is rooted in the context of the game, helping athletes connect movement with intention.', size: 'large' },
      { icon: '💪', title: 'Resilience Through Challenge', description: "Struggle isn't failure—it's feedback for growth.", size: 'small' },
      { icon: '🚀', title: 'Freedom to Explore', description: 'We encourage athletes to test, adjust, and discover their own solutions through active play.', size: 'small' }
    ]
  },
  {
    category: 'The Culture',
    tagline: 'How we build community',
    accent: 'white',
    values: [
      { icon: '🤝', title: 'Connection Before Correction', description: 'We build trust first—because meaningful change only happens in safe relationships.', size: 'medium' },
      { icon: '✨', title: 'Authenticity Always', description: "Coaches and players show up real. No faking perfection.", size: 'small' },
      { icon: '🎉', title: 'Joy in the Process', description: 'Learning is fueled by laughter and shared excitement.', size: 'small' },
      { icon: '🛡️', title: 'Support with Standards', description: 'High expectations met with empathy and guidance.', size: 'medium' }
    ]
  }
];
---

<BaseLayout title="Home">
  <link rel="preload" as="image" href={optimizedHero.src} fetchpriority="high" slot="head" />
  <main class="relative overflow-hidden pt-32">
    <!-- Hero Section -->
    <section class="min-h-[90vh] flex items-center justify-center px-6 py-20 relative overflow-hidden">
      <!-- Hero Image with Filter & Overlay -->
      <div class="absolute inset-0 z-0">
        <Image 
          src={heroImage} 
          alt="Volleyball net in focus" 
          class="w-full h-full object-cover mix-blend-luminosity opacity-40 grayscale contrast-125"
          loading="eager"
          fetchpriority="high"
          width={1920}
          height={1080}
        />
        <div class="absolute inset-0 bg-gradient-to-b from-brand-charcoal/90 via-brand-charcoal/40 to-brand-charcoal"></div>
        <div class="absolute inset-0 bg-brand-teal/20 mix-blend-overlay"></div>
        
        <!-- Animated Blobs - Intensified -->
        <div class="absolute top-1/4 -left-20 w-[600px] h-[600px] bg-brand-teal/40 rounded-full blur-[140px] animate-pulse"></div>
        <div class="absolute -bottom-20 -right-20 w-[600px] h-[600px] bg-brand-coral/30 rounded-full blur-[140px] animate-pulse" style="animation-delay: 2s;"></div>
      </div>

      <div class="max-w-6xl mx-auto text-center relative z-10">
        <ScrollReveal>
          <span class="inline-block px-4 py-1.5 rounded-full border border-brand-teal/30 bg-brand-teal/10 text-[10px] font-bold uppercase tracking-[0.2em] mb-8 text-brand-teal shadow-[0_0_20px_rgba(0,150,149,0.2)]">
            Tualatin Valley Volleyball Club
          </span>
        </ScrollReveal>
        
        <ScrollReveal delay={0.2}>
          <h1 class="text-6xl md:text-[12.5rem] font-syne font-extrabold mb-8 leading-[0.82] tracking-tighter text-white uppercase break-words drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative inline-block">
            Play with <br class="hidden md:block" /> <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-teal via-brand-teal to-[#00f2ff] italic relative">
              Purpose
              <svg class="absolute -bottom-2 md:-bottom-8 left-0 w-full h-4 md:h-12 text-brand-teal/40 -z-10 overflow-visible" viewBox="0 0 400 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 30C50 15 150 5 395 25" stroke="currentColor" stroke-width="8" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
        </ScrollReveal>

        <ScrollReveal delay={0.4}>
          <p class="text-lg md:text-xl text-white/60 mb-12 max-w-2xl mx-auto leading-relaxed">
            Developing resilient, kind, and adaptable athletes through the game of volleyball.
          </p>
        </ScrollReveal>

        <ScrollReveal delay={0.6}>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/summer-camps-clinics" class="btn btn-primary px-10">Summer Camps</a>
            <a href="/teams" class="btn btn-secondary px-10">Explore club teams</a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <!-- Programs Bento Grid -->
    <section class="max-w-7xl mx-auto px-6 py-24 relative">
      <LiquidBlobs className="top-1/4 -right-20" color="bg-brand-teal" />
      <LiquidBlobs className="bottom-0 -left-20" color="bg-brand-coral" />
      
      <div class="absolute -top-32 -left-1/4 w-full h-full -z-10 opacity-20 pointer-events-none">
        <KineticMarquee text="THE GAME IS THE TEACHER" speed={0.2} outline={true} />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-4 lg:sticky lg:top-32 z-20">
          <ScrollReveal>
            <div class="mb-16">
              <h2 class="text-6xl md:text-8xl font-syne font-bold mb-6 text-white uppercase tracking-tighter leading-[0.8]">Our <br/><span class="text-brand-teal">Programs</span></h2>
              <p class="text-white/40 max-w-xs uppercase tracking-widest text-[10px] font-bold">From introductory play to competitive club teams, we have a path for every athlete.</p>
            </div>
          </ScrollReveal>
        </div>

        <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-4 h-full relative">
          <!-- Club Teams - Large & Offset -->
          <div class="md:col-span-2 glass-card flex flex-col justify-between group overflow-hidden border-brand-teal/20 p-0 md:-mt-12 md:ml-12 relative z-10 shadow-2xl">
            <ScrollReveal direction="left" className="h-full flex flex-col md:flex-row">
              <div class="relative h-64 md:h-auto md:w-1/2 overflow-hidden">
                <Image 
                  src={teamTealImage} 
                  alt="14 Teal team in action" 
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 opacity-60 mix-blend-luminosity hover:mix-blend-normal hover:opacity-100 transition-all"
                  loading="lazy"
                  width={800}
                  height={600}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal via-brand-charcoal/20 to-transparent"></div>
              </div>
              <div class="p-8 md:p-12 md:w-1/2 flex flex-col justify-between bg-brand-charcoal/40 backdrop-blur-xl">
                <div>
                  <span class="text-[10px] font-bold bg-brand-teal/10 text-brand-teal px-3 py-1 rounded-full uppercase tracking-wider mb-6 inline-block">Ages 11-18</span>
                  <h3 class="text-4xl font-heading mb-4 text-white uppercase tracking-tighter">Club Teams</h3>
                  <p class="text-white/60 mb-8 max-w-sm leading-relaxed">Competitive age-group teams with full season training, regional tournaments, and a focus on intentional development.</p>
                </div>
                <a href="/teams" class="flex items-center gap-2 text-sm font-bold text-brand-teal group-hover:gap-4 transition-all uppercase tracking-widest">
                  Explore Teams <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </ScrollReveal>
            
            <!-- Floating Text Overlay -->
            <div class="absolute -bottom-4 -right-4 bg-brand-teal text-white font-syne font-black text-6xl opacity-10 pointer-events-none select-none uppercase -rotate-12 z-20">COMPETE</div>
          </div>

          <!-- Ignition -->
          <div class="glass-card flex flex-col justify-between border-brand-coral/20 md:rotate-1 relative z-20">
            <ScrollReveal delay={0.2}>
              <div class="relative">
                <span class="text-[10px] font-bold bg-brand-coral/10 text-brand-coral px-3 py-1 rounded-full uppercase tracking-wider mb-4 inline-block">Ages 9-12</span>
                <h3 class="text-2xl font-heading mb-2 text-white uppercase italic">Ignition</h3>
                <p class="text-sm text-white/50 mb-6">Introductory program for 4th-6th graders to fall in love with the game.</p>
                <a href="/programs#ignition" class="text-xs font-bold text-brand-coral hover:text-white transition-colors uppercase tracking-widest">Learn More →</a>
              </div>
            </ScrollReveal>
          </div>

          <!-- PlayWorks -->
          <div class="glass-card flex flex-col justify-between md:-translate-y-8 md:-ml-4 relative z-0">
            <ScrollReveal delay={0.4}>
              <div>
                <span class="text-[10px] font-bold bg-white/5 text-white/50 px-3 py-1 rounded-full uppercase tracking-wider mb-4 inline-block">Ages 11-16</span>
                <h3 class="text-2xl font-heading mb-2 text-white uppercase italic">PlayWorks</h3>
                <p class="text-sm text-white/50 mb-6">Skill-focused exploratory program. Game-based learning.</p>
                <a href="/programs#playworks" class="text-xs font-bold text-brand-teal hover:text-white transition-colors uppercase tracking-widest">Learn More →</a>
              </div>
            </ScrollReveal>
          </div>

          <!-- Training Blocks -->
          <div class="glass-card flex flex-col justify-between border-brand-teal/20 md:ml-8 relative z-10">
            <ScrollReveal delay={0.5}>
              <div>
                <span class="text-[10px] font-bold bg-brand-teal/10 text-brand-teal px-3 py-1 rounded-full uppercase tracking-wider mb-4 inline-block">Any Age</span>
                <h3 class="text-2xl font-heading mb-2 text-white uppercase italic">Training Blocks</h3>
                <p class="text-sm text-white/50 mb-6">Small group training built around reading & decisions.</p>
                <a href="/training" class="text-xs font-bold text-brand-teal hover:text-white transition-colors uppercase tracking-widest">Learn More →</a>
              </div>
            </ScrollReveal>
          </div>

          <!-- Summer Camps -->
          <div class="glass-card flex flex-col justify-between relative overflow-hidden bg-brand-teal/20 border-brand-teal/40 md:-mt-4 md:rotate-[-1deg]">
            <ScrollReveal delay={0.3}>
              <div class="absolute -top-10 -right-10 w-48 h-48 bg-brand-teal/40 rounded-full blur-3xl"></div>
              <div>
                <span class="text-[10px] font-bold bg-white text-brand-teal px-3 py-1 rounded-full uppercase tracking-wider mb-4 inline-block shadow-[0_0_20px_rgba(255,255,255,0.4)]">Registration Open</span>
                <h3 class="text-2xl font-heading mb-2 text-white uppercase">Summer 2026</h3>
                <p class="text-sm text-white/70 max-w-xs mb-6">High-quality summer training in Hillsboro. Secure your spot today.</p>
              </div>
              <a href="/register" class="text-sm font-extrabold text-white bg-brand-teal px-6 py-3 rounded-sm text-center hover:bg-brand-teal-dark transition-colors shadow-lg shadow-brand-teal/20 uppercase tracking-widest">Register Now</a>
            </ScrollReveal>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="max-w-7xl mx-auto px-6 py-48 relative">
       <LiquidBlobs className="top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 scale-150" color="bg-brand-teal" />
       
       <div class="relative z-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-7 relative z-20">
              <ScrollReveal direction="left">
                <div class="relative">
                  <h2 class="text-7xl md:text-[10rem] font-syne font-bold text-white leading-[0.75] uppercase tracking-tighter mb-12">
                    About <br /> <span class="text-brand-teal italic">TVVC</span>
                  </h2>
                  <div class="glass p-8 md:p-12 border-white/10 max-w-2xl md:-mt-16 md:ml-24 relative overflow-hidden group shadow-2xl">
                    <div class="absolute inset-0 opacity-[0.03] pointer-events-none noise-bg mix-blend-overlay"></div>
                    <p class="text-white/80 text-xl md:text-2xl leading-relaxed mb-8 font-medium">
                      <strong class="text-white">Tualatin Valley Volleyball Club</strong> was founded in 2024 to make high-quality volleyball accessible and joyful—centered on what matters most: the growth of the athlete.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                      <div class="border-l-2 border-brand-teal pl-4 py-2">
                        <span class="block text-brand-teal font-black text-xs uppercase tracking-[0.2em] mb-1">Value</span>
                        <p class="text-white font-bold text-sm uppercase">Affordability</p>
                      </div>
                      <div class="border-l-2 border-brand-coral pl-4 py-2">
                        <span class="block text-brand-coral font-black text-xs uppercase tracking-[0.2em] mb-1">Value</span>
                        <p class="text-white font-bold text-sm uppercase">Balance</p>
                      </div>
                      <div class="border-l-2 border-white/40 pl-4 py-2">
                        <span class="block text-white/40 font-black text-xs uppercase tracking-[0.2em] mb-1">Value</span>
                        <p class="text-white font-bold text-sm uppercase">Joyful</p>
                      </div>
                    </div>
                  </div>
                </div>
              </ScrollReveal>
            </div>
            
            <div class="lg:col-span-5 relative">
              <ScrollReveal direction="right">
                <div class="relative group p-4 bg-white/5 border border-white/10 rounded-sm rotate-6 hover:rotate-0 transition-transform duration-700 lg:-ml-20 shadow-2xl" data-parallax="0.08">
                  {/* Tape Effect */}
                  <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-32 h-10 bg-white/20 backdrop-blur-md -rotate-3 z-30 pointer-events-none shadow-sm"></div>
                  <div class="absolute -bottom-6 left-1/4 w-24 h-10 bg-brand-teal/30 backdrop-blur-md rotate-12 z-30 pointer-events-none"></div>
                  
                  <div class="p-3 bg-white shadow-2xl relative transition-all duration-500 overflow-hidden">
                    <div class="absolute inset-0 opacity-20 pointer-events-none mix-blend-multiply bg-[url('/assets/textures/paper-grain.jpg')] bg-cover"></div>
                    <Image 
                      src={teamWhiteImage} 
                      alt="TVVC athletes huddle" 
                      class="w-full h-auto object-cover grayscale opacity-95 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-1000"
                      loading="lazy"
                      width={600}
                      height={400}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-8 left-8 right-8">
                       <p class="text-2xl font-heading text-white leading-tight italic mb-3 drop-shadow-xl font-bold">
                         "Building confident, <br />adaptable players."
                       </p>
                       <span class="text-[10px] font-bold text-brand-teal uppercase tracking-[0.3em] bg-black/60 px-3 py-1.5 inline-block backdrop-blur-sm">Culture in Action</span>
                    </div>
                  </div>
                  <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-brand-teal/20 rounded-full blur-3xl -z-10 group-hover:bg-brand-teal/40 transition-all duration-1000"></div>
                </div>
              </ScrollReveal>
              
              <!-- Decorative Offset Card -->
              <div class="absolute -bottom-20 -left-10 w-40 h-40 border border-brand-teal/20 rotate-12 -z-10 hidden lg:block opacity-40"></div>
            </div>
          </div>
       </div>
    </section>

    <!-- Section Break Image -->
    <section class="relative h-64 md:h-[500px] overflow-hidden mt-12 group bg-brand-charcoal">
      <div class="absolute inset-0 z-0">
        <Image 
          src={playersActionImage} 
          alt="TVVC players in action" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-[3000ms] opacity-60 grayscale contrast-125"
          loading="lazy"
          width={1200}
          height={600}
        />
      </div>
      
      <!-- Torn Edge Overlays -->
      <div class="absolute top-0 left-0 w-full h-12 bg-brand-charcoal z-10" style="clip-path: polygon(0 0, 100% 0, 100% 30%, 95% 70%, 90% 40%, 85% 80%, 80% 30%, 75% 60%, 70% 20%, 65% 90%, 60% 40%, 55% 70%, 50% 30%, 45% 80%, 40% 40%, 35% 60%, 30% 20%, 25% 90%, 20% 40%, 15% 70%, 10% 30%, 5% 80%, 0 30%);"></div>
      <div class="absolute bottom-0 left-0 w-full h-12 bg-brand-charcoal z-10 rotate-180" style="clip-path: polygon(0 0, 100% 0, 100% 30%, 95% 70%, 90% 40%, 85% 80%, 80% 30%, 75% 60%, 70% 20%, 65% 90%, 60% 40%, 55% 70%, 50% 30%, 45% 80%, 40% 40%, 35% 60%, 30% 20%, 25% 90%, 20% 40%, 15% 70%, 10% 30%, 5% 80%, 0 30%);"></div>

      <div class="absolute inset-0 bg-gradient-to-b from-brand-charcoal via-transparent to-brand-charcoal opacity-80"></div>
      <div class="absolute inset-0 flex items-center justify-center">
         <div class="text-center px-6">
            <ScrollReveal>
              <h3 class="text-3xl md:text-6xl font-syne font-extrabold text-white italic drop-shadow-[0_10px_30px_rgba(0,0,0,0.8)] uppercase tracking-tighter leading-none">
                The heartbeat of TVVC <br class="md:hidden" /> is our <span class="text-brand-teal">Athletes</span>.
              </h3>
            </ScrollReveal>
         </div>
      </div>
    </section>

    <div class="py-8 overflow-hidden">
      <KineticMarquee text="CONNECTION BEFORE CORRECTION" speed={-0.3} className="opacity-10" />
    </div>

    <!-- Core Values Bento -->
    <section class="bg-brand-charcoal pt-24 pb-48 relative overflow-hidden" id="core-values">
      <div class="absolute inset-0 bg-gradient-to-b from-brand-charcoal via-black to-brand-charcoal opacity-50"></div>
      
      {/* Decorative Texture Layer */}
      <div class="absolute inset-0 opacity-[0.02] pointer-events-none noise-bg mix-blend-overlay scale-150 rotate-12"></div>
      
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-brand-teal/50 to-transparent"></div>
      
      <div class="max-w-6xl mx-auto px-6">
        <ScrollReveal>
          <div class="mb-20 text-center md:text-left">
            <h2 class="text-4xl md:text-8xl font-syne font-extrabold mb-4 text-white uppercase tracking-tighter drop-shadow-[0_10px_30px_rgba(0,150,149,0.3)]">Our Core <br class="hidden md:block" /> <span class="text-brand-teal italic">Principles</span></h2>
            <p class="text-white/60 max-w-xl uppercase tracking-[0.2em] text-[10px] font-bold">A deeper look at the philosophy that drives every practice and match at TVVC.</p>
          </div>
        </ScrollReveal>

        <div class="space-y-20">
          {valueGroups.map((group) => (
            <div>
              <ScrollReveal>
                <div class="flex items-baseline gap-4 mb-8">
                  <h3 class={`text-3xl font-syne font-bold uppercase tracking-tighter ${group.accent === 'brand-teal' ? 'text-brand-teal drop-shadow-[0_0_15px_rgba(0,150,149,0.5)]' : group.accent === 'brand-coral' ? 'text-brand-coral drop-shadow-[0_0_15px_rgba(232,93,78,0.5)]' : 'text-white'}`}>
                    {group.category}
                  </h3>
                  <span class="text-white/20 text-xs uppercase tracking-[0.3em] font-bold">/ {group.tagline}</span>
                </div>
              </ScrollReveal>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                {group.values.map((v, i) => (
                  <ScrollReveal delay={i * 0.1} direction="up" className={`glass-card relative overflow-hidden group border-white/5 hover:border-${group.accent}/40 transition-all ${v.size === 'large' ? 'md:col-span-2' : v.size === 'medium' ? 'md:col-span-1.5' : 'md:col-span-1'}`}>
                    {/* Paper Texture Overlay */}
                    <div class="absolute inset-0 opacity-[0.03] pointer-events-none noise-bg mix-blend-overlay"></div>
                    
                    <div class={`absolute -top-10 -right-10 w-32 h-32 opacity-20 blur-3xl transition-opacity group-hover:opacity-40 ${group.accent === 'brand-teal' ? 'bg-brand-teal' : group.accent === 'brand-coral' ? 'bg-brand-coral' : 'bg-white'}`}></div>
                    <span class="text-3xl mb-6 block drop-shadow-lg">{v.icon}</span>
                    <h4 class="text-xl font-heading font-bold mb-3 text-white group-hover:text-white transition-colors">{v.title}</h4>
                    <p class="text-sm text-white/50 leading-relaxed max-w-sm group-hover:text-white/70 transition-colors">{v.description}</p>
                  </ScrollReveal>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Final Thank You Message -->
    <section class="max-w-4xl mx-auto px-6 py-32 text-center">
       <ScrollReveal>
         <div class="glass p-8 md:p-16 rounded-[2rem] border-brand-teal/20 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-brand-teal/50 to-transparent"></div>
            
            <h2 class="text-3xl md:text-5xl font-heading mb-10 text-brand-teal leading-tight">
              Thank You for a Season of <span class="text-white italic">Growth</span>, Connection, and Competition
            </h2>
            
            <div class="space-y-8 text-white/80 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto">
              <p>
                This season, our athletes played, learned, adapted, competed, and grew. None of that happens without the support of families who believe in what we are building.
              </p>
              
              <p>
                <strong>To every player:</strong> thank you for your effort, your courage, your care for each other, and your willingness to keep showing up.
              </p>
              
              <p>
                <strong>To every family:</strong> thank you for your trust, your flexibility, your patience, and your support throughout the season.
              </p>
              
              <p class="text-white font-bold">
                We are deeply grateful for the chance to coach, support, and grow alongside your athletes.
              </p>
              
              <p class="text-brand-teal italic font-heading text-2xl pt-4">
                Wherever the game takes you next, we hope this season leaves you with confidence, connection, and memories worth carrying forward.
              </p>
            </div>
         </div>
       </ScrollReveal>
    </section>
  </main>

  <script>
    function initParallax() {
      const parallaxElements = document.querySelectorAll('[data-parallax]');
      let ticking = false;
      
      window.addEventListener('scroll', () => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        
        if (!ticking) {
          window.requestAnimationFrame(() => {
            const scrollY = window.scrollY;
            
            parallaxElements.forEach(el => {
              const speed = parseFloat(el.getAttribute('data-parallax') || '0.1');
              const rect = el.getBoundingClientRect();
              
              // Only animate if in viewport
              if (rect.top < window.innerHeight && rect.bottom > 0) {
                const offset = (window.innerHeight / 2) - (rect.top + rect.height / 2);
                const yPos = offset * speed;
                (el as HTMLElement).style.transform = `translateY(${yPos}px) ${el.classList.contains('rotate-6') ? 'rotate(6deg)' : el.classList.contains('rotate-2') ? 'rotate(2deg)' : ''}`;
              }
            });
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }

    // Run on initial load
    initParallax();

    // Run on Astro page load
    document.addEventListener('astro:page-load', initParallax);
  </script>
</BaseLayout>
