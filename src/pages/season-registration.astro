---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getSession } from 'auth-astro/server';
import { getOwnedClubSeasonOffers, getPublishedClubSeasonAgreements } from '../lib/club-season-access';
import { parseClubSeasonDraftData } from '../lib/club-season-draft';
import { isClubSeasonRegistrationEnabled } from '../lib/club-season-feature';
import { getClubDate } from '../lib/event-eligibility';
import { getClubSeasonRegistrationWindowState } from '../lib/club-season-settings';
import {
  CLUB_SEASON_AUTOPAY_AUTHORIZATION,
  buildClubSeasonPaymentTerms,
  hashClubSeasonPaymentTerms,
} from '../lib/club-season-payment';

const session = await getSession(Astro.request);
const isSignedIn = Boolean(session?.user);
const featureEnabled = isClubSeasonRegistrationEnabled();
const ownedOffers = featureEnabled && isSignedIn
  ? (await getOwnedClubSeasonOffers(Astro.request)).filter((item) => item.season.publicRegistrationEnabled)
  : [];
const clubDate = getClubDate();
const paymentRedirectState = Astro.url.searchParams.get('payment');
const seasonIdsWithDrafts = [...new Set(ownedOffers.filter(({ draft }) => Boolean(draft)).map(({ season }) => season.id))];
const agreementsBySeason = new Map(await Promise.all(
  seasonIdsWithDrafts.map(async (seasonId) => [seasonId, await getPublishedClubSeasonAgreements(seasonId)] as const)
));
const paymentTermsByOffer = new Map(await Promise.all(
  ownedOffers
    .filter(({ draft }) => draft?.status === 'awaiting_payment')
    .map(async ({ offer, season, team, pricingTier }) => {
      const sharedInput = {
        registrationDate: clubDate,
        firstInstallmentDate: season.firstInstallmentDate,
        billingDay: team.billingDayOverride || season.defaultBillingDay,
        pricing: {
          totalAmount: pricingTier.totalAmount,
          depositAmount: pricingTier.depositAmount,
          installmentAmount: pricingTier.installmentAmount,
          installmentCount: season.standardInstallmentCount,
        },
      };
      const payInFull = buildClubSeasonPaymentTerms({ ...sharedInput, paymentOption: 'pay_in_full' });
      const standardPlan = buildClubSeasonPaymentTerms({ ...sharedInput, paymentOption: 'standard_plan' });
      return [offer.id, {
        payInFull: { terms: payInFull, fingerprint: await hashClubSeasonPaymentTerms(payInFull) },
        standardPlan: { terms: standardPlan, fingerprint: await hashClubSeasonPaymentTerms(standardPlan) },
      }] as const;
    })
));

const money = (cents: number) => new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
}).format(cents / 100);

const displayDate = (value?: string | null) => {
  if (!value) return 'Contact TVVC for your response date';
  return new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${value}T12:00:00Z`));
};

const displayScheduleDate = (value: string) => new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${value}T12:00:00Z`));

const displayPacificDateTime = (value?: string | null) => value
  ? new Intl.DateTimeFormat('en-US', {
      month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit',
      timeZone: 'America/Los_Angeles', timeZoneName: 'short',
    }).format(new Date(value))
  : 'a date set by TVVC';

const firstName = (value: string) => value.trim().split(/\s+/)[0] || value;
const offerState = (status: string, deadline?: string | null) => {
  if (status === 'offered' && deadline && deadline < clubDate) return 'expired';
  return status;
};

const installmentMonths = [
  { month: 'January', due: 'Due Jan 5' },
  { month: 'February', due: 'Due Feb 5' },
  { month: 'March', due: 'Due Mar 5' },
  { month: 'April', due: 'Due Apr 5' },
  { month: 'May', due: 'Due May 5' },
];

const sizeOptions = ['YS', 'YM', 'YL', 'YXL', 'AS', 'AM', 'AL', 'AXL', 'A2XL', 'A3XL'];
const humanizeResponse = (value: string) => value
  .replace(/[_-]+/g, ' ')
  .replace(/\b\w/g, (letter) => letter.toUpperCase());
const parseAllowedResponses = (value?: string | null): string[] => {
  if (!value) return [];
  try {
    const parsed = JSON.parse(value);
    return Array.isArray(parsed) ? parsed.filter((item): item is string => typeof item === 'string') : [];
  } catch {
    return [];
  }
};
const fieldClass = 'min-h-12 w-full rounded-xl border border-white/15 bg-[#0b0e14] px-3.5 text-sm text-white outline-none placeholder:text-white/25 focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 disabled:cursor-not-allowed disabled:opacity-60';
const textareaClass = `${fieldClass} min-h-28 resize-y py-3 leading-6`;
const labelClass = 'mb-1.5 block text-xs font-extrabold uppercase tracking-[0.12em] text-white/65';
---

<BaseLayout
  title="Club Season Invitation"
  description="Review your private TVVC club season invitation."
  noindex={true}
>
  <main class="relative min-h-screen px-4 pb-24 pt-28 md:px-6 md:pb-32 md:pt-36">
    <div aria-hidden="true" class="offer-court pointer-events-none absolute inset-x-0 top-20 mx-auto h-[34rem] max-w-7xl opacity-[0.055]"></div>
    <div class="relative mx-auto max-w-6xl">
      {!isSignedIn ? (
        <section class="mx-auto max-w-xl overflow-hidden rounded-3xl border border-white/10 bg-[#11151d] shadow-2xl" aria-labelledby="invitation-title">
          <div class="h-1.5 bg-brand-teal"></div>
          <div class="p-7 text-center md:p-11">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-teal/25 bg-brand-teal/10 text-brand-teal">
              <svg aria-hidden="true" width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z"></path><path d="m4 7 8 6 8-6"></path></svg>
            </div>
            <p class="mt-6 text-xs font-extrabold uppercase tracking-[0.16em] text-brand-teal">Private club season link</p>
            <h1 id="invitation-title" class="mt-2 font-heading text-3xl font-extrabold uppercase leading-tight tracking-[-0.035em] text-white md:text-5xl">Open your invitation</h1>
            <p class="mx-auto mt-4 max-w-md text-sm leading-6 text-white/55">Sign in with the email used for tryout registration. We’ll show only invitations connected to your family’s verified account.</p>
            <a href="/portal/login?callbackUrl=%2Fseason-registration" class="mt-7 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-brand-teal px-6 text-sm font-extrabold uppercase tracking-[0.11em] text-white transition hover:bg-brand-teal-dark focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-[#11151d]">
              Sign in securely
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"></path></svg>
            </a>
            <p class="mt-5 text-xs leading-5 text-white/55">This shared page does not expose invitation details before sign-in.</p>
          </div>
        </section>
      ) : ownedOffers.length === 0 ? (
        <section class="mx-auto max-w-xl rounded-3xl border border-white/10 bg-[#11151d] p-7 text-center shadow-2xl md:p-11" aria-labelledby="no-offer-title">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-white/10 bg-white/[0.04] text-white/45">
            <svg aria-hidden="true" width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5"></path><path d="M12 17h.01"></path></svg>
          </div>
          <p class="mt-6 text-xs font-extrabold uppercase tracking-[0.16em] text-white/60">Club season registration</p>
          <h1 id="no-offer-title" class="mt-2 font-heading text-3xl font-extrabold uppercase tracking-[-0.03em] text-white">No active offer found</h1>
          <p class="mx-auto mt-4 max-w-md text-sm leading-6 text-white/55">If you expected an invitation, confirm that you signed in with the email used at tryouts. TVVC can help check the record without changing your account ownership.</p>
          <a href="mailto:info@tualatinvalleyvb.com?subject=Club%20season%20offer%20help" class="mt-7 inline-flex min-h-11 items-center justify-center rounded-xl border border-white/15 px-5 text-xs font-extrabold uppercase tracking-[0.12em] text-white transition hover:border-brand-teal/50 hover:text-brand-teal focus:outline-none focus:ring-2 focus:ring-brand-teal">Contact TVVC</a>
        </section>
      ) : (
        <div class="space-y-10">
          <h1 class="sr-only">Your TVVC club season invitations</h1>
          {ownedOffers.map((item, index) => {
            const state = offerState(item.offer.status, item.offer.acceptanceDeadline);
            const playerName = `${item.athlete.firstName} ${item.athlete.lastName}`;
            const started = state === 'registration_started' || (state === 'offered' && Boolean(item.draft));
            const canRespond = state === 'offered' && !started;
            const registrationWindowState = getClubSeasonRegistrationWindowState(item.season);
            const canStartRegistration = registrationWindowState === 'open';
            const editableDraft = started && item.draft?.status === 'draft';
            const awaitingPayment = started && item.draft?.status === 'awaiting_payment';
            const savedDraftData = parseClubSeasonDraftData(item.draft?.draftData) || {
              schemaVersion: 1 as const,
              family: {
                addressLine1: '', addressLine2: '', city: '', state: '', postalCode: '',
                emergencyContactName: '', emergencyContactRelationship: '',
                emergencyContactPhone: item.sourceRegistration.emergencyPhone || '',
                communicationPreference: '' as const, informationConfirmed: false,
              },
              player: {
                preferredName: item.athlete.preferredName || '', jerseySize: (item.athlete.jerseySize || '') as '', apparelSize: '' as const,
                jerseyNumberPreferences: [] as number[], medicalInfo: item.athlete.medicalInfo || '',
                medicalInformationConfirmed: false, cevaMembershipStatus: '' as const,
                cevaMembershipNumber: '', medicalReleaseStatus: '' as const, seasonConflicts: '',
              },
            };
            const currentStep = Math.min(3, Math.max(1, item.draft?.currentStep || 1));
            const agreements = agreementsBySeason.get(item.season.id) || [];
            const paymentChoices = paymentTermsByOffer.get(item.offer.id);
            const customPaymentTerms = (item as typeof item & { customPaymentTerms?: any }).customPaymentTerms;
            const customFutureCharges = customPaymentTerms?.charges?.slice(1) || [];
            const stateCopy = state === 'revoked'
              ? { eyebrow: 'Invitation updated', title: 'This offer is no longer active', body: 'TVVC has withdrawn this invitation. Contact the club if you believe this was unexpected.', tone: 'coral' }
              : state === 'declined'
                ? { eyebrow: 'Response received', title: 'You declined this offer', body: 'Your response has been saved. If your plans change, contact TVVC to ask whether the spot is still available.', tone: 'quiet' }
                : state === 'expired'
                  ? { eyebrow: 'Response window closed', title: 'This offer has expired', body: 'The response deadline has passed. Contact TVVC before making any plans; the roster spot may have been reassigned.', tone: 'coral' }
                  : awaitingPayment
                    ? { eyebrow: 'Information complete', title: 'Ready for the payment handoff', body: 'Your registration details and agreement acknowledgements are recorded. The roster spot is not final until the deposit is paid.', tone: 'teal' }
                    : started
                      ? { eyebrow: 'Draft started', title: 'Your registration is underway', body: 'Complete the three short sections below. Your work saves as you go, and the roster spot is not final until the deposit is paid.', tone: 'teal' }
                    : state === 'accepted'
                      ? { eyebrow: 'Welcome to TVVC', title: 'Your spot is confirmed', body: 'This registration has been accepted and recorded. TVVC will share the next team details with your family.', tone: 'teal' }
                      : registrationWindowState === 'not_open'
                        ? { eyebrow: 'Invitation received', title: 'Registration opens soon', body: `This invitation is ready. Registration opens ${displayPacificDateTime(item.season.registrationOpensAt)}; return then to begin.`, tone: 'quiet' }
                        : registrationWindowState === 'closed'
                          ? { eyebrow: 'Registration window closed', title: 'Contact TVVC about this offer', body: 'The season registration window has closed. TVVC can review the invitation and advise whether registration can be reopened.', tone: 'coral' }
                          : registrationWindowState === 'not_configured'
                            ? { eyebrow: 'Invitation received', title: 'Registration timing is being finalized', body: 'TVVC has not opened the season registration window yet. Your invitation remains private and linked to this account.', tone: 'quiet' }
                            : { eyebrow: 'You’re invited', title: `${firstName(item.athlete.firstName)}, this spot is yours to claim.`, body: `TVVC is offering ${playerName} a place on ${item.team.name} for the ${item.season.name}.`, tone: 'teal' };
            return (
              <article class:list={[editableDraft ? 'overflow-visible' : 'overflow-hidden', 'rounded-[1.75rem] border border-white/10 bg-[#11151d] shadow-2xl']} data-parent-offer data-offer-id={item.offer.id} style={`animation-delay:${index * 100}ms`}>
                <div class:list={[
                  'h-1.5 rounded-t-[1.75rem]',
                  stateCopy.tone === 'coral' ? 'bg-brand-coral' : stateCopy.tone === 'teal' ? 'bg-brand-teal' : 'bg-white/20',
                ]}></div>
                <div class:list={[editableDraft ? 'overflow-visible' : 'overflow-hidden', 'relative px-6 pb-7 pt-7 md:px-10 md:pb-10 md:pt-10']}>
                  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden rounded-[1.7rem]">
                    <div class="absolute -right-20 -top-24 h-72 w-72 rounded-full border border-white/[0.05]"></div>
                    <div class="absolute -right-8 -top-12 h-52 w-52 rounded-full border border-white/[0.05]"></div>
                  </div>

                  <header class="relative grid gap-7 border-b border-white/10 pb-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
                    <div>
                      <div class="flex flex-wrap items-center gap-3">
                        <p class:list={[
                          'text-xs font-extrabold uppercase tracking-[0.16em]',
                          stateCopy.tone === 'coral' ? 'text-brand-coral' : stateCopy.tone === 'teal' ? 'text-brand-teal' : 'text-white/40',
                        ]}>{stateCopy.eyebrow}</p>
                        <span class="h-px w-10 bg-white/15" aria-hidden="true"></span>
                        <p class="text-xs font-bold uppercase tracking-[0.14em] text-white/55">{item.ageGroup.label}</p>
                      </div>
                      <h2 class="mt-3 max-w-3xl font-heading text-3xl font-extrabold uppercase leading-[0.98] tracking-[-0.04em] text-white md:text-5xl lg:text-6xl">{stateCopy.title}</h2>
                      <p class="mt-4 max-w-2xl text-sm leading-6 text-white/60 md:text-base">{stateCopy.body}</p>
                    </div>
                    <div class="min-w-52 border-l-2 border-brand-teal pl-4">
                      <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-white/55">Player</p>
                      <p class="mt-1 font-heading text-lg font-extrabold uppercase tracking-tight text-white">{playerName}</p>
                      <p class="mt-3 text-xs font-extrabold uppercase tracking-[0.14em] text-white/55">Team assignment</p>
                      <p class="mt-1 font-heading text-2xl font-extrabold uppercase tracking-tight text-white">{item.team.name}</p>
                      <p class="mt-1 text-xs font-semibold text-brand-teal">{item.ageGroup.label} · {item.season.name}</p>
                    </div>
                  </header>

                  {canRespond && (
                    <div class="relative mt-8 grid gap-6 xl:grid-cols-[minmax(0,1.25fr)_minmax(20rem,.75fr)]">
                      <section aria-labelledby={`payment-heading-${item.offer.id}`}>
                        <div class="flex flex-wrap items-end justify-between gap-3">
                          <div>
                            <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-brand-teal">Choose later during registration</p>
                            <h2 id={`payment-heading-${item.offer.id}`} class="mt-1 font-heading text-2xl font-extrabold uppercase tracking-tight text-white">Two payment options</h2>
                          </div>
                          <p class="text-xs text-white/55">Automatic card setup comes in the payment step.</p>
                        </div>

                        <div class="mt-4 overflow-hidden rounded-2xl border border-white/10">
                          <div class="grid gap-4 border-b border-white/10 bg-black/15 p-5 sm:grid-cols-[1fr_auto] sm:items-center">
                            <div>
                              <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-white/60">Option 01 · Pay in full</p>
                              <p class="mt-1 text-sm text-white/55">One card payment during the final registration step.</p>
                            </div>
                            <p class="font-heading text-4xl font-extrabold tabular-nums tracking-[-0.05em] text-white">{money(item.pricingTier.totalAmount)}</p>
                          </div>
                          <div class="bg-[#0d1118] p-5">
                            <div class="flex flex-wrap items-end justify-between gap-3">
                              <div>
                                <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-brand-teal">Option 02 · Standard plan</p>
                                <p class="mt-1 text-sm text-white/55"><strong class="font-bold text-white">{money(item.pricingTier.depositAmount)}</strong> deposit in November, then five payments of <strong class="font-bold text-white">{money(item.pricingTier.installmentAmount)}</strong>.</p>
                              </div>
                              <p class="text-xs font-bold uppercase tracking-[0.12em] text-white/55">Total {money(item.pricingTier.totalAmount)}</p>
                            </div>
                            <ol class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-4 lg:grid-cols-7" aria-label="Standard payment schedule">
                              <li class="bg-[#11151d] p-3">
                                <p class="text-xs font-extrabold uppercase tracking-[0.11em] text-white/60">November</p>
                                <p class="mt-2 text-sm font-extrabold text-white">{money(item.pricingTier.depositAmount)}</p>
                                <p class="mt-0.5 text-xs text-white/55">Deposit due</p>
                              </li>
                              <li class="border-x border-brand-teal/20 bg-brand-teal/[0.08] p-3">
                                <p class="text-xs font-extrabold uppercase tracking-[0.11em] text-white/60">December</p>
                                <p class="mt-2 text-sm font-extrabold text-brand-teal">No charge</p>
                                <p class="mt-0.5 text-xs text-white/55">Holiday pause</p>
                              </li>
                              {installmentMonths.map((installment) => (
                                <li class="bg-[#11151d] p-3">
                                  <p class="text-xs font-extrabold uppercase tracking-[0.11em] text-white/60">{installment.month}</p>
                                  <p class="mt-2 text-sm font-extrabold text-white">{money(item.pricingTier.installmentAmount)}</p>
                                  <p class="mt-0.5 text-xs font-semibold text-white/60">{installment.due}</p>
                                </li>
                              ))}
                            </ol>
                          </div>
                        </div>
                        <p class="mt-3 text-xs leading-5 text-white/60">Need a different arrangement? Contact TVVC before the deadline. Individual plans can be discussed and documented separately.</p>
                      </section>

                      <aside class="self-start rounded-2xl border border-brand-teal/25 bg-brand-teal/[0.06] p-5 md:p-6" aria-labelledby={`next-heading-${item.offer.id}`}>
                        <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-brand-teal">Your next serve</p>
                        <h2 id={`next-heading-${item.offer.id}`} class="mt-1 font-heading text-2xl font-extrabold uppercase text-white">{canStartRegistration ? 'Start the draft' : 'Invitation window'}</h2>
                        <p class="mt-3 text-sm leading-6 text-white/55">{canStartRegistration ? 'This opens the secure registration process. Starting does not accept the offer or reserve the roster spot by itself.' : registrationWindowState === 'not_open' ? `Registration opens ${displayPacificDateTime(item.season.registrationOpensAt)}.` : 'Registration cannot be started online right now. Contact TVVC if you need help with this invitation.'}</p>
                        <div class="mt-5 border-y border-white/10 py-4">
                          <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-white/55">Reply by</p>
                          <p class="mt-1 font-heading text-lg font-extrabold text-white">{displayDate(item.offer.acceptanceDeadline)}</p>
                        </div>
                        <button type="button" data-start-registration disabled={!canStartRegistration} class="mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-brand-teal px-5 text-xs font-extrabold uppercase tracking-[0.12em] text-white transition hover:bg-brand-teal-dark focus:outline-none focus:ring-2 focus:ring-brand-teal focus:ring-offset-2 focus:ring-offset-[#11151d] disabled:cursor-not-allowed disabled:opacity-40">
                          <span data-action-label>{canStartRegistration ? 'Start registration' : registrationWindowState === 'not_open' ? 'Registration opens soon' : 'Registration unavailable'}</span>
                          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"></path></svg>
                        </button>
                        <button type="button" data-open-decline class="mt-2 min-h-10 w-full text-xs font-extrabold uppercase tracking-[0.12em] text-white/60 transition hover:text-brand-coral focus:outline-none focus:ring-2 focus:ring-brand-coral">Decline this offer</button>
                        <p class="mt-3 text-center text-xs leading-5 text-white/55">The spot is finalized only after the later deposit is paid.</p>
                      </aside>
                    </div>
                  )}

                  {editableDraft && item.draft && (
                    <form
                      class="relative mt-8"
                      data-registration-draft
                      data-offer-id={item.offer.id}
                      data-version={item.draft.version}
                      data-current-step={currentStep}
                      data-draft-data={JSON.stringify(savedDraftData)}
                      data-has-agreements={agreements.length > 0 ? 'true' : 'false'}
                      novalidate
                    >
                      <div class="grid gap-6 lg:grid-cols-[13rem_minmax(0,1fr)]">
                        <nav aria-label="Registration progress" class="lg:sticky lg:top-28 lg:self-start">
                          <div class="rotation-clipboard rounded-2xl border border-white/12 bg-[#0d1118] p-3 lg:p-4">
                            <div class="clipboard-clip" aria-hidden="true"></div>
                            <div class="mb-3 flex items-end justify-between gap-3 px-1 lg:mb-4">
                              <div>
                                <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-brand-teal">Rotation card</p>
                                <p class="mt-0.5 text-xs text-white/55">Three touches, then payment</p>
                              </div>
                              <span class="font-heading text-lg font-extrabold text-white/20">TVVC</span>
                            </div>
                            <ol class="rotation-court relative grid grid-cols-3 lg:block">
                              <svg class="rotation-path" aria-hidden="true" viewBox="0 0 180 260" preserveAspectRatio="none">
                                <path d="M38 42 L142 130 L38 218 L145 246" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="5 5"></path>
                                <path d="m136 238 9 8-11 4" fill="none" stroke="currentColor" stroke-width="2"></path>
                              </svg>
                            {[
                              ['01', 'Family', 'Contact & address'],
                              ['02', 'Player', 'Gear & readiness'],
                              ['03', 'Commit', 'Review & agreements'],
                            ].map(([number, title, detail], stepIndex) => (
                              <li class={`rotation-position rotation-position-${stepIndex + 1} relative`} data-progress-step={stepIndex + 1}>
                                <div class="flex min-h-[4.75rem] items-center justify-center gap-2 px-1 py-2 lg:min-h-0 lg:justify-start lg:p-0">
                                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-white/15 bg-[#11151d] font-heading text-sm font-extrabold text-white/50" data-progress-number>{number}</span>
                                  <span class="min-w-0">
                                    <span class="block text-xs font-extrabold uppercase tracking-[0.1em] text-white/70">{title}</span>
                                    <span class="mt-0.5 hidden text-xs leading-4 text-white/55 lg:block">{detail}</span>
                                  </span>
                                </div>
                              </li>
                            ))}
                              <li class="payment-handoff hidden lg:flex" aria-hidden="true">
                                <span class="h-2.5 w-2.5 rounded-full bg-brand-coral"></span>
                                <span class="text-xs font-extrabold uppercase tracking-[0.1em] text-white/65">Payment handoff</span>
                              </li>
                            </ol>
                          </div>
                          <div class="mt-3 flex min-h-11 items-center gap-2 rounded-xl border border-white/10 bg-black/20 px-3 text-xs text-white/60" aria-live="polite" data-save-status>
