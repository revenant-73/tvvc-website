  {ownedOffers.length > 0 && (
    <script>
      type ToastWindow = Window & { toast?: { success?: (message: string) => void; error?: (message: string) => void } };
      const endpoint = '/api/club-season/respond';
      const notify = (type: 'success' | 'error', message: string) => (window as ToastWindow).toast?.[type]?.(message);

      document.querySelectorAll<HTMLElement>('[data-parent-offer]').forEach((card) => {
        const offerId = card.dataset.offerId || '';
        const startButton = card.querySelector<HTMLButtonElement>('[data-start-registration]');
        const startLabel = card.querySelector<HTMLElement>('[data-action-label]');
        const openDecline = card.querySelector<HTMLButtonElement>('[data-open-decline]');
        const dialog = card.querySelector<HTMLDialogElement>('[data-decline-dialog]');
        const confirmDecline = card.querySelector<HTMLButtonElement>('[data-confirm-decline]');
        const declineLabel = card.querySelector<HTMLElement>('[data-decline-label]');
        const declineReason = card.querySelector<HTMLSelectElement>('[data-decline-reason]');
        const declineDetails = card.querySelector<HTMLTextAreaElement>('[data-decline-details]');
        const paymentForm = card.querySelector<HTMLFormElement>('[data-payment-form]');
        const paymentOptions = [...card.querySelectorAll<HTMLInputElement>('[data-payment-option]')];
        const standardDetails = card.querySelector<HTMLElement>('[data-standard-plan-details]');
        const customDetails = card.querySelector<HTMLElement>('[data-custom-plan-details]');
        const autopayName = card.querySelector<HTMLInputElement>('[data-autopay-name]');
        const autopayAuthorized = card.querySelector<HTMLInputElement>('[data-autopay-authorized]');
        const customAutopayName = card.querySelector<HTMLInputElement>('[data-custom-autopay-name]');
        const customAutopayAuthorized = card.querySelector<HTMLInputElement>('[data-custom-autopay-authorized]');
        const dueNowDisplay = card.querySelector<HTMLElement>('[data-due-now-display]');
        const paymentSubmit = card.querySelector<HTMLButtonElement>('[data-payment-submit]');
        const paymentSubmitLabel = card.querySelector<HTMLElement>('[data-payment-submit-label]');
        const paymentError = card.querySelector<HTMLElement>('[data-payment-error]');

        const respond = async (payload: Record<string, unknown>) => {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ offerId, ...payload }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'Your response could not be saved.');
          return data;
        };

        startButton?.addEventListener('click', async () => {
          startButton.disabled = true;
          if (startLabel) startLabel.textContent = 'Starting…';
          try {
            await respond({ action: 'start' });
            notify('success', 'Registration draft started');
            window.location.reload();
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Registration could not be started.';
            notify('error', message);
            startButton.disabled = false;
            if (startLabel) startLabel.textContent = 'Start registration';
          }
        });

        openDecline?.addEventListener('click', () => {
          dialog?.showModal();
          dialog?.querySelector<HTMLSelectElement>('[data-decline-reason]')?.focus();
        });
        dialog?.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close('cancel');
        });
        confirmDecline?.addEventListener('click', async () => {
          confirmDecline.disabled = true;
          if (declineLabel) declineLabel.textContent = 'Saving…';
          try {
            await respond({
              action: 'decline',
              declineReason: declineReason?.value || undefined,
              declineDetails: declineDetails?.value.trim() || undefined,
            });
            dialog?.close('confirmed');
            notify('success', 'Your response has been saved');
            window.location.reload();
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Your response could not be saved.';
            notify('error', message);
            confirmDecline.disabled = false;
            if (declineLabel) declineLabel.textContent = 'Confirm decline';
          }
        });

        const selectedPaymentOption = () => paymentOptions.find((option) => option.checked);
        const formatPaymentAmount = (cents: number) => new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD',
          maximumFractionDigits: 0,
        }).format(cents / 100);
        const updatePaymentChoice = () => {
          const selected = selectedPaymentOption();
          const standardSelected = selected?.value === 'standard_plan';
          const customSelected = selected?.value === 'custom_plan';
          standardDetails?.classList.toggle('hidden', !standardSelected);
          customDetails?.classList.toggle('hidden', !customSelected);
          if (autopayName) autopayName.required = standardSelected;
          if (autopayAuthorized) autopayAuthorized.required = standardSelected;
          if (customAutopayName) customAutopayName.required = customSelected;
          if (customAutopayAuthorized) customAutopayAuthorized.required = customSelected;
          if (dueNowDisplay && selected) dueNowDisplay.textContent = formatPaymentAmount(Number(selected.dataset.dueNowAmount || 0));
          paymentError?.classList.add('hidden');
        };

        paymentOptions.forEach((option) => option.addEventListener('change', updatePaymentChoice));
        updatePaymentChoice();

        paymentForm?.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (paymentSubmit?.disabled) return;
          const selected = selectedPaymentOption();
          if (!selected) {
            paymentOptions[0]?.focus();
            return;
          }
          if (!paymentForm.checkValidity()) {
            paymentForm.reportValidity();
            return;
          }

          paymentError?.classList.add('hidden');
          if (paymentSubmit) paymentSubmit.disabled = true;
          if (paymentSubmitLabel) paymentSubmitLabel.textContent = 'Opening Stripe…';
          try {
            const isStandardPlan = selected.value === 'standard_plan';
            const isCustomPlan = selected.value === 'custom_plan';
            const requiresAutopayAuthorization = isStandardPlan || isCustomPlan;
            const response = await fetch('/api/club-season/checkout', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                offerId,
                paymentOption: selected.value,
                termsFingerprint: selected.dataset.termsFingerprint || '',
                ...(requiresAutopayAuthorization ? {
                  authorizedName: (isCustomPlan ? customAutopayName : autopayName)?.value.trim() || '',
                  autopayAuthorized: Boolean((isCustomPlan ? customAutopayAuthorized : autopayAuthorized)?.checked),
                } : {}),
              }),
            });
            const responseData = await response.json().catch(() => ({}));
            if (!response.ok || typeof responseData.url !== 'string') {
              throw new Error(responseData.error || 'Secure checkout could not be started. Please try again.');
            }
            window.location.assign(responseData.url);
          } catch (error) {
            const message = error instanceof Error ? error.message : 'Secure checkout could not be started. Please try again.';
            if (paymentError) {
              paymentError.textContent = message;
              paymentError.classList.remove('hidden');
              paymentError.focus();
            }
            if (paymentSubmit) paymentSubmit.disabled = false;
            if (paymentSubmitLabel) paymentSubmitLabel.textContent = 'Continue to secure payment';
          }
        });
      });

      document.querySelectorAll<HTMLFormElement>('[data-registration-draft]').forEach((form) => {
        const draftEndpoint = '/api/club-season/draft';
        const agreementEndpoint = '/api/club-season/agreements';
        const offerId = form.dataset.offerId || '';
        let version = Number(form.dataset.version || 1);
        let currentStep = Number(form.dataset.currentStep || 1);
        let dirty = false;
        let saveBlocked = false;
        let savePromise: Promise<boolean> | null = null;
        let saveTimer: number | undefined;

        const panels = [...form.querySelectorAll<HTMLElement>('[data-draft-step]')];
        const progressItems = [...form.querySelectorAll<HTMLElement>('[data-progress-step]')];
        const saveStatus = form.querySelector<HTMLElement>('[data-save-status]');
        const saveLabel = form.querySelector<HTMLElement>('[data-save-label]');
        const saveDot = form.querySelector<HTMLElement>('[data-save-dot]');
        const saveCallout = form.querySelector<HTMLElement>('[data-save-callout]');
        const saveError = form.querySelector<HTMLElement>('[data-save-error]');
        const retrySave = form.querySelector<HTMLButtonElement>('[data-retry-save]');
        const reloadDraft = form.querySelector<HTMLButtonElement>('[data-reload-draft]');
        const backButton = form.querySelector<HTMLButtonElement>('[data-back-step]');
        const nextButton = form.querySelector<HTMLButtonElement>('[data-next-step]');
        const nextLabel = form.querySelector<HTMLElement>('[data-next-label]');
        const stepCounter = form.querySelector<HTMLElement>('[data-step-counter]');
        const submitError = form.querySelector<HTMLElement>('[data-submit-error]');
        const submitErrorMessage = form.querySelector<HTMLElement>('[data-submit-error-message]');
        const missingFieldsList = form.querySelector<HTMLElement>('[data-missing-fields]');
        const missingStepButton = form.querySelector<HTMLButtonElement>('[data-missing-step]');
        const hasAgreements = form.dataset.hasAgreements === 'true';

        const named = <T extends HTMLElement>(name: string) => form.elements.namedItem(name) as T | null;
        const valueOf = (name: string) => named<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(name)?.value.trim() || '';
        const checked = (name: string) => Boolean(named<HTMLInputElement>(name)?.checked);
        const inlineErrors = new Map<string, HTMLElement>();
        const cevaStatus = named<HTMLSelectElement>('cevaMembershipStatus');
        const cevaNumber = named<HTMLInputElement>('cevaMembershipNumber');

        const validationKey = (control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) =>
          control.type === 'radio' ? `radio-${control.name}` : control.name || control.id;

        const validationMessage = (control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
          if (control.validity.customError) return control.validationMessage;
          if (control.validity.patternMismatch && control.name === 'state') return 'Use the two-letter state abbreviation.';
          if (control.validity.patternMismatch && control.name === 'postalCode') return 'Enter a five-digit ZIP code, with an optional four-digit extension.';
          if (control.type === 'radio') return 'Choose one response before continuing.';
          if (control.type === 'checkbox') return 'Confirm this item before continuing.';
          if (control instanceof HTMLSelectElement) return 'Choose an option before continuing.';
          return 'Complete this field before continuing.';
        };

        const ensureInlineError = (control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
          const key = validationKey(control);
          let error = inlineErrors.get(key);
          if (!error) {
            error = document.createElement('p');
            error.id = `draft-error-${offerId.slice(0, 8)}-${key.replace(/[^a-zA-Z0-9_-]/g, '-')}`;
            error.className = 'mt-1.5 hidden text-xs font-semibold leading-5 text-brand-coral';
            error.setAttribute('role', 'alert');
            const anchor = control.type === 'radio'
              ? control.closest('fieldset')
              : control.type === 'checkbox' ? control.closest('label') : control;
            anchor?.insertAdjacentElement('afterend', error);
            inlineErrors.set(key, error);
          }
          const describedBy = new Set((control.getAttribute('aria-describedby') || '').split(/\s+/).filter(Boolean));
          describedBy.add(error.id);
          control.setAttribute('aria-describedby', [...describedBy].join(' '));
          return error;
        };

        const controlsForKey = (key: string) => [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')]
          .filter((control) => validationKey(control) === key);

        const setInlineError = (control: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, visible: boolean) => {
          const key = validationKey(control);
          const error = ensureInlineError(control);
          error.textContent = visible ? validationMessage(control) : '';
          error.classList.toggle('hidden', !visible);
          controlsForKey(key).forEach((related) => {
            related.toggleAttribute('aria-invalid', visible);
            related.dataset.validationAttempted = visible ? 'true' : related.dataset.validationAttempted;
          });
        };

        const syncConditionalRequirements = () => {
          if (cevaNumber) cevaNumber.required = cevaStatus?.value === 'complete';
        };

        syncConditionalRequirements();
        [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input[required], select[required], textarea[required]')]
          .forEach(ensureInlineError);
        if (cevaNumber) ensureInlineError(cevaNumber);
        form.querySelectorAll<HTMLInputElement>('[data-jersey-number]').forEach((control) => {
          control.setAttribute('aria-describedby', `${control.getAttribute('aria-describedby') || ''} ${form.querySelector<HTMLElement>('[data-jersey-error]')?.id || ''}`.trim());
        });

        const serializeDraft = () => {
          const jerseyNumberPreferences = [...form.querySelectorAll<HTMLInputElement>('[data-jersey-number]')]
            .map((input) => input.value.trim())
            .filter(Boolean)
            .map(Number);
          return {
            schemaVersion: 1,
            family: {
              addressLine1: valueOf('addressLine1'),
              addressLine2: valueOf('addressLine2'),
              city: valueOf('city'),
              state: valueOf('state').toUpperCase(),
              postalCode: valueOf('postalCode'),
              emergencyContactName: valueOf('emergencyContactName'),
              emergencyContactRelationship: valueOf('emergencyContactRelationship'),
              emergencyContactPhone: valueOf('emergencyContactPhone'),
              communicationPreference: valueOf('communicationPreference'),
              informationConfirmed: checked('informationConfirmed'),
            },
            player: {
              preferredName: valueOf('preferredName'),
              jerseySize: valueOf('jerseySize'),
              apparelSize: valueOf('apparelSize'),
              jerseyNumberPreferences,
              medicalInfo: valueOf('medicalInfo'),
              medicalInformationConfirmed: checked('medicalInformationConfirmed'),
              cevaMembershipStatus: valueOf('cevaMembershipStatus'),
              cevaMembershipNumber: valueOf('cevaMembershipNumber'),
              medicalReleaseStatus: valueOf('medicalReleaseStatus'),
              seasonConflicts: valueOf('seasonConflicts'),
            },
          };
        };

        const setSaveState = (state: 'saved' | 'dirty' | 'saving' | 'error' | 'conflict', detail?: string) => {
          if (!saveLabel || !saveDot || !saveStatus) return;
          saveStatus.dataset.state = state;
          saveDot.className = `h-2 w-2 rounded-full ${state === 'saved' ? 'bg-brand-teal' : state === 'dirty' || state === 'saving' ? 'bg-amber-300' : 'bg-brand-coral'}`;
          saveLabel.textContent = state === 'saved'
            ? `Saved ${detail || ''}`.trim()
            : state === 'dirty' ? 'Unsaved changes'
              : state === 'saving' ? 'Saving…'
                : state === 'conflict' ? 'Save conflict'
                  : 'Save failed';
        };

        const showSaveError = (message: string, conflict = false) => {
          saveCallout?.classList.remove('hidden');
          if (saveError) saveError.textContent = message;
          retrySave?.classList.toggle('hidden', conflict);
          reloadDraft?.classList.toggle('hidden', !conflict);
          setSaveState(conflict ? 'conflict' : 'error');
        };

        const clearSaveError = () => {
          saveCallout?.classList.add('hidden');
          retrySave?.classList.add('hidden');
          reloadDraft?.classList.add('hidden');
        };

        const performSave = async (): Promise<boolean> => {
          if (!dirty || saveBlocked) return !dirty;
          dirty = false;
          setSaveState('saving');
          try {
            const response = await fetch(draftEndpoint, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ offerId, version, currentStep, data: serializeDraft() }),
            });
            const responseData = await response.json().catch(() => ({}));
            if (response.status === 409) {
              saveBlocked = true;
              dirty = true;
              showSaveError(responseData.error || 'This registration changed in another tab. Reload before continuing.', true);
              return false;
            }
            if (!response.ok) {
              dirty = true;
              showSaveError(responseData.error || 'We could not save your changes. Your entries are still in this browser.');
              return false;
            }
            version = Number(responseData.draft?.version || version);
            form.dataset.version = String(version);
            clearSaveError();
            const savedTime = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit' }).format(new Date());
            setSaveState('saved', savedTime);
            return true;
          } catch {
            dirty = true;
            showSaveError('We could not reach TVVC to save. Your entries are still in this browser; retry when the connection returns.');
            return false;
          }
        };

        const flushSave = async (): Promise<boolean> => {
          window.clearTimeout(saveTimer);
          if (savePromise) {
            await savePromise;
            if (dirty && !saveBlocked) return flushSave();
            return !dirty;
          }
          if (!dirty || saveBlocked) return !dirty;
          savePromise = performSave();
          const result = await savePromise;
          savePromise = null;
          if (result && dirty && !saveBlocked) return flushSave();
          return result;
        };

        const scheduleSave = () => {
          if (saveBlocked) return;
          dirty = true;
          setSaveState('dirty');
          window.clearTimeout(saveTimer);
          saveTimer = window.setTimeout(() => void flushSave(), 900);
          updateReview();
        };

        const updateReview = () => {
          const data = serializeDraft();
          const address = [data.family.addressLine1, data.family.addressLine2, data.family.city, data.family.state, data.family.postalCode].filter(Boolean).join(', ');
          const emergency = [data.family.emergencyContactName, data.family.emergencyContactRelationship, data.family.emergencyContactPhone].filter(Boolean).join(' · ');
          const readiness = [
            data.player.jerseySize && `Jersey ${data.player.jerseySize}`,
            data.player.apparelSize && `Apparel ${data.player.apparelSize}`,
            data.player.cevaMembershipStatus && `CEVA ${data.player.cevaMembershipStatus.replace('_', ' ')}`,
          ].filter(Boolean).join(' · ');
          const addressTarget = form.querySelector<HTMLElement>('[data-review-address]');
          const emergencyTarget = form.querySelector<HTMLElement>('[data-review-emergency]');
          const readinessTarget = form.querySelector<HTMLElement>('[data-review-readiness]');
          if (addressTarget) addressTarget.textContent = address || 'Complete step one';
          if (emergencyTarget) emergencyTarget.textContent = emergency || 'Complete step one';
          if (readinessTarget) readinessTarget.textContent = readiness || 'Complete step two';
        };

        const renderStep = () => {
          panels.forEach((panel) => { panel.hidden = Number(panel.dataset.draftStep) !== currentStep; });
          progressItems.forEach((item) => {
            const step = Number(item.dataset.progressStep);
            const number = item.querySelector<HTMLElement>('[data-progress-number]');
            item.dataset.active = step === currentStep ? 'true' : 'false';
            item.dataset.complete = step < currentStep ? 'true' : 'false';
            number?.classList.toggle('border-brand-teal', step <= currentStep);
            number?.classList.toggle('bg-brand-teal', step === currentStep);
            number?.classList.toggle('text-white', step <= currentStep);
          });
          if (backButton) backButton.classList.toggle('invisible', currentStep === 1);
          if (stepCounter) stepCounter.textContent = `Step ${currentStep} of 3`;
          if (nextLabel) nextLabel.textContent = currentStep === 3 ? 'Save agreements & continue' : 'Save & continue';
          if (nextButton) nextButton.disabled = currentStep === 3 && !hasAgreements;
          updateReview();
          panels.find((panel) => Number(panel.dataset.draftStep) === currentStep)?.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
        };

        const validateStep = (step: number): boolean => {
          const panel = panels.find((candidate) => Number(candidate.dataset.draftStep) === step);
          if (!panel) return true;
          syncConditionalRequirements();
          if (step === 2 && cevaNumber) {
            cevaNumber.setCustomValidity(cevaStatus?.value === 'complete' && !cevaNumber.value.trim() ? 'Enter the CEVA membership number.' : '');
          }
          const numberInputs = [...form.querySelectorAll<HTMLInputElement>('[data-jersey-number]')];
          const numberValues = numberInputs.map((input) => input.value.trim()).filter(Boolean);
          const duplicateNumbers = numberValues.length !== new Set(numberValues).size;
          numberInputs.forEach((input) => input.setCustomValidity(duplicateNumbers ? 'Choose different jersey numbers.' : ''));
          const jerseyError = form.querySelector<HTMLElement>('[data-jersey-error]');
          jerseyError?.classList.toggle('hidden', !duplicateNumbers);
          numberInputs.forEach((input) => input.toggleAttribute('aria-invalid', duplicateNumbers));

          const panelControls = [...panel.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')];
          const invalidControls = panelControls.filter((control) => !control.checkValidity());
          panelControls.filter((control) => control.required || inlineErrors.has(validationKey(control)))
            .forEach((control) => setInlineError(control, !control.checkValidity()));
          const invalid = invalidControls[0];
          if (invalid) {
            invalid.focus();
            invalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
          }
          return true;
        };

        const moveToStep = async (targetStep: number) => {
          if (targetStep > currentStep && !validateStep(currentStep)) return;
          const previousStep = currentStep;
          currentStep = targetStep;
          dirty = true;
          setSaveState('dirty');
          const saved = await flushSave();
          if (!saved) {
            currentStep = previousStep;
            return;
          }
          renderStep();
          form.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        };

        const showSubmitError = (message: string, missingFields: string[] = []) => {
          submitError?.classList.remove('hidden');
          if (submitErrorMessage) submitErrorMessage.textContent = message;
          if (missingFieldsList) {
            missingFieldsList.replaceChildren(...missingFields.map((field) => {
              const item = document.createElement('li');
              item.textContent = field;
              return item;
            }));
          }
          if (missingStepButton) {
            const familyTerms = ['address', 'city', 'state', 'zip', 'emergency', 'communication', 'family'];
            const targetStep = missingFields.some((field) => familyTerms.some((term) => field.toLowerCase().includes(term))) ? 1 : 2;
            missingStepButton.dataset.targetStep = String(targetStep);
            missingStepButton.textContent = targetStep === 1 ? 'Go to family & contact' : 'Go to player & readiness';
            missingStepButton.classList.toggle('hidden', missingFields.length === 0);
          }
          submitError?.focus();
        };

        const submitAgreements = async () => {
          if (!hasAgreements || !validateStep(3)) return;
          submitError?.classList.add('hidden');
          const saved = await flushSave();
          if (!saved || !nextButton) return;
          nextButton.disabled = true;
          if (nextLabel) nextLabel.textContent = 'Recording…';

          const responses = [...form.querySelectorAll<HTMLElement>('[data-agreement]')].flatMap((agreement) => {
            const agreementVersionId = agreement.dataset.agreementId || '';
            if (agreement.dataset.responseType === 'choice') {
              const response = agreement.querySelector<HTMLInputElement>('input[type="radio"]:checked')?.value;
              return response ? [{ agreementVersionId, response }] : [];
            }
            const accepted = agreement.querySelector<HTMLInputElement>('[data-agreement-ack]')?.checked;
            return accepted ? [{ agreementVersionId, response: 'accepted' }] : [];
          });
          const acceptedName = form.querySelector<HTMLInputElement>('[data-accepted-name]')?.value.trim() || '';

          try {
            const response = await fetch(agreementEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ offerId, version, acceptedName, responses }),
            });
            const responseData = await response.json().catch(() => ({}));
            if (!response.ok) {
              if (response.status === 409) {
                saveBlocked = true;
                showSaveError(responseData.error || 'This registration changed in another tab. Reload before continuing.', true);
              }
              const missing = Array.isArray(responseData.missingFields) ? responseData.missingFields.filter((field: unknown): field is string => typeof field === 'string') : [];
              showSubmitError(responseData.error || 'The agreements could not be recorded.', missing);
              return;
            }
            window.location.reload();
          } catch {
            showSubmitError('We could not reach TVVC to record the agreements. Your form entries are still here; please try again.');
          } finally {
            if (!saveBlocked) nextButton.disabled = false;
            if (nextLabel) nextLabel.textContent = 'Save agreements & continue';
          }
        };

        panels.slice(0, 2).forEach((panel) => {
          panel.addEventListener('input', scheduleSave);
          panel.addEventListener('change', scheduleSave);
        });
        form.addEventListener('input', (event) => {
          const control = event.target;
          if (!(control instanceof HTMLInputElement || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement)) return;
          if (control === cevaStatus) syncConditionalRequirements();
          const key = validationKey(control);
          const error = inlineErrors.get(key);
          if (error && (!error.classList.contains('hidden') || control.dataset.validationAttempted === 'true')) {
            if (control === cevaNumber) {
              control.setCustomValidity(cevaStatus?.value === 'complete' && !control.value.trim() ? 'Enter the CEVA membership number.' : '');
            }
            setInlineError(control, !control.checkValidity());
          }
          if (control.matches('[data-jersey-number]')) {
            const numberInputs = [...form.querySelectorAll<HTMLInputElement>('[data-jersey-number]')];
            const numberValues = numberInputs.map((input) => input.value.trim()).filter(Boolean);
            const duplicateNumbers = numberValues.length !== new Set(numberValues).size;
            numberInputs.forEach((input) => {
              input.setCustomValidity(duplicateNumbers ? 'Choose different jersey numbers.' : '');
              input.toggleAttribute('aria-invalid', duplicateNumbers);
            });
            form.querySelector<HTMLElement>('[data-jersey-error]')?.classList.toggle('hidden', !duplicateNumbers);
          }
        });
        retrySave?.addEventListener('click', () => void flushSave());
        reloadDraft?.addEventListener('click', () => window.location.reload());
        backButton?.addEventListener('click', () => { if (currentStep > 1) void moveToStep(currentStep - 1); });
        nextButton?.addEventListener('click', () => {
          if (currentStep < 3) void moveToStep(currentStep + 1);
          else void submitAgreements();
        });
        missingStepButton?.addEventListener('click', () => {
          const targetStep = Number(missingStepButton.dataset.targetStep || 2);
          void moveToStep(targetStep);
        });
        window.addEventListener('beforeunload', (event) => {
          if (!dirty && !savePromise) return;
          event.preventDefault();
        });

        updateReview();
        renderStep();
        setSaveState('saved');
      });
    </script>
  )}

  <style>
    .offer-court {
      background-image:
        linear-gradient(90deg, transparent calc(50% - .5px), white 50%, transparent calc(50% + .5px)),
        linear-gradient(0deg, transparent calc(50% - .5px), white 50%, transparent calc(50% + .5px)),
        linear-gradient(90deg, transparent 8%, white 8%, white calc(8% + 1px), transparent calc(8% + 1px), transparent 92%, white 92%, white calc(92% + 1px), transparent calc(92% + 1px));
      background-size: 100% 100%;
      background-repeat: no-repeat;
    }

    [data-parent-offer] {
      animation: offer-in 480ms ease-out both;
    }

    @keyframes offer-in {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    dialog[open] {
      animation: dialog-in 180ms ease-out both;
    }

    .rotation-clipboard {
      position: relative;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.025), 0 18px 40px rgba(0,0,0,.18);
    }

    .clipboard-clip {
      position: absolute;
      left: 50%;
      top: -0.45rem;
      width: 4.75rem;
      height: 0.8rem;
      transform: translateX(-50%);
      border: 1px solid rgba(255,255,255,.16);
      border-radius: 0.25rem;
      background: #202630;
    }

    .rotation-court {
      border: 1px solid rgba(0,150,149,.24);
      border-radius: .75rem;
    }

    .rotation-court::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 1px;
      background: rgba(0,150,149,.18);
    }

    .rotation-position + .rotation-position {
      border-left: 1px solid rgba(255,255,255,.08);
    }

    .rotation-path {
      display: none;
      color: rgba(0,150,149,.52);
      pointer-events: none;
    }

    [data-progress-step][data-active='true'] [data-progress-number] {
      box-shadow: 0 0 0 5px rgba(0,150,149,.13);
    }

    [data-progress-step][data-complete='true'] [data-progress-number]::after {
      content: '✓';
      margin-left: 0.15rem;
