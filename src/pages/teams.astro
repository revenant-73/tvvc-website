---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Teams & Tryouts" description="TVVC's competitive age-group teams, girls volleyball club in Hillsboro, OR. 12U-18U development-first focus.">
  <main class="pt-32">
    <!-- Hero Section -->
    <section class="px-6 py-20 relative">
      <div class="max-w-6xl mx-auto">
        <span class="text-brand-teal font-bold uppercase tracking-widest text-xs mb-4 block">Competitive Excellence</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold mb-6 leading-tight">
          Competitive Teams.<br/>
          <span class="text-white/40">Development First.</span>
        </h1>
        <p class="text-lg text-white/60 max-w-2xl leading-relaxed mb-10">
          Four age-group levels with a focus on skill development, game understanding, and the love of volleyball. Join a team where growth matters more than outcomes.
        </p>
      </div>
    </section>

    <!-- Age Groups Bento -->
    <section class="max-w-6xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card border-brand-teal/20">
          <span class="text-3xl mb-6 block">✨</span>
          <span class="text-[10px] font-bold text-brand-teal uppercase tracking-widest mb-2 block">Introductory Phase</span>
          <h3 class="text-xl font-heading mb-4">12U — Start With Joy and Confidence</h3>
          <p class="text-sm text-white/50 leading-relaxed">A fun, supportive entry point for young athletes to explore the game, build basic skills, and grow confidence through play-based learning and positive team experiences.</p>
        </div>

        <div class="glass-card border-white/10">
          <span class="text-3xl mb-6 block">🌱</span>
          <span class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-2 block">Foundation Phase</span>
          <h3 class="text-xl font-heading mb-4">13U–14U — Build the Foundation</h3>
          <p class="text-sm text-white/50 leading-relaxed">Developing core technical skills while fostering a love for the game. We focus on establishing strong movement patterns and basic game understanding.</p>
        </div>

        <div class="glass-card border-brand-coral/20">
          <span class="text-3xl mb-6 block">📈</span>
          <span class="text-[10px] font-bold text-brand-coral uppercase tracking-widest mb-2 block">Development Phase</span>
          <h3 class="text-xl font-heading mb-4">15U–16U — Grow Through the Game</h3>
          <p class="text-sm text-white/50 leading-relaxed">Developing skills while learning to read the game in real-time. We focus on decision-making and communication.</p>
        </div>

        <div class="glass-card border-white/5">
          <span class="text-3xl mb-6 block">🏆</span>
          <span class="text-[10px] font-bold text-white/30 uppercase tracking-widest mb-2 block">Competitive Phase</span>
          <h3 class="text-xl font-heading mb-4">17U–18U — Lead with Confidence</h3>
          <p class="text-sm text-white/50 leading-relaxed">A competitive space for athletes to elevate skills and leadership, focusing on meaningful training and personal growth.</p>
        </div>
      </div>
    </section>

    <!-- Season Logistics -->
    <section class="max-w-6xl mx-auto px-6 py-24">
       <div class="glass-card !p-0 overflow-hidden grid grid-cols-1 md:grid-cols-2">
         <div class="p-8 md:p-12 bg-brand-teal/5">
            <h2 class="text-3xl font-heading mb-8">Season <span class="text-brand-teal">Logistics</span></h2>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-teal/10 flex items-center justify-center text-brand-teal">📅</div>
                <div>
                  <h4 class="font-bold text-sm uppercase tracking-wider mb-1">Season Dates</h4>
                  <p class="text-white/60">December 2025 – May 2026</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-teal/10 flex items-center justify-center text-brand-teal">⏰</div>
                <div>
                  <h4 class="font-bold text-sm uppercase tracking-wider mb-1">Practice Schedule</h4>
                  <p class="text-white/60">2x per week (2 hours each)</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-teal/10 flex items-center justify-center text-brand-teal">🏐</div>
                <div>
                  <h4 class="font-bold text-sm uppercase tracking-wider mb-1">Tournaments</h4>
                  <p class="text-white/60">6–7 per season (CEVA Region)</p>
                </div>
              </div>
            </div>
         </div>

         <div class="p-8 md:p-12 flex flex-col justify-center">
            <div class="mb-8">
              <span class="text-[10px] font-bold text-white/40 uppercase tracking-[0.2em] mb-2 block">Investment</span>
              <div class="flex items-baseline gap-2">
                <span class="text-5xl font-heading font-extrabold">$1,150</span>
                <span class="text-white/40 text-sm italic">/ season</span>
              </div>
            </div>
            
            <ul class="space-y-3 mb-10">
              {['2 Jerseys & Practice Gear', 'All Tournament Fees', 'All Practices & Training', 'Financial Assistance Available'].map(item => (
                <li class="flex items-center gap-3 text-sm text-white/70">
                  <svg class="text-brand-teal" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {item}
                </li>
              ))}
            </ul>

            <a href="mailto:info@tualatinvalleyvb.com" class="btn btn-primary w-full">Contact for Financial Aid</a>
         </div>
       </div>
    </section>

    <!-- Schedule Tables -->
    <section class="max-w-4xl mx-auto px-6 py-24" id="tournament-schedule">
      <h2 class="text-3xl font-heading mb-4 text-center">2026 Tournament <span class="text-brand-coral">Schedule</span></h2>
      <p class="text-white/40 text-center mb-12 max-w-md mx-auto section-subtitle">Competitive matches and regional qualifiers for the 2026 season.</p>
      
      <div class="glass rounded-[2rem] border-white/10 overflow-hidden shadow-2xl">
        <!-- Tab Navigation -->
        <div class="flex flex-wrap border-b border-white/10 bg-white/5">
          <button class="flex-1 py-4 px-6 text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-white/5 schedule-tab active" data-tab="12u">12U Division</button>
          <button class="flex-1 py-4 px-6 text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-white/5 schedule-tab" data-tab="14u">14U Division</button>
          <button class="flex-1 py-4 px-6 text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-white/5 schedule-tab" data-tab="16u">16U Division</button>
          <button class="flex-1 py-4 px-6 text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-white/5 schedule-tab" data-tab="18u">18U Division</button>
        </div>

        <div class="p-4 md:p-8">
          <!-- 12U Content -->
          <div class="schedule-content active" id="schedule-12u">
            <div class="p-12 text-center">
              <span class="text-4xl mb-6 block">✨</span>
              <p class="text-brand-teal font-heading italic text-2xl mb-2">Coming October 2026</p>
              <p class="text-white/40 text-sm max-w-xs mx-auto">Registration and schedule details for our new 12U program will be announced soon.</p>
            </div>
          </div>

          <!-- 14U Content -->
          <div class="schedule-content hidden" id="schedule-14u">
            <div class="overflow-x-auto schedule-container">
              <table class="w-full text-left text-sm schedule-table">
                <thead class="text-white/40 uppercase text-[10px] tracking-widest font-bold">
                  <tr>
                    <th class="px-6 py-4 text-brand-teal">Date</th>
                    <th class="px-6 py-4">Event</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-white/70">
                  {[
                    { date: '1/11/26', event: 'Power League Qualifier Day 1' },
                    { date: '1/25/26', event: 'Power League Qualifier Day 2' },
                    { date: '2/22/26', event: 'Power League #1' },
                    { date: '3/8/26', event: 'Power League #2' },
                    { date: '4/11/26', event: 'Power League #3' },
                    { date: '5/2/26', event: 'CEVA Regional Tournament', qualifier: '(IF QUALIFIED)', highlight: true },
                  ].map(row => (
                    <tr class={row.highlight ? "bg-brand-teal/5 text-brand-teal schedule-regional" : "hover:bg-white/5 transition-colors"}>
                      <td class="px-6 py-4 font-mono whitespace-nowrap schedule-date">{row.date}</td>
                      <td class="px-6 py-4 font-medium">
                        {row.event} {row.qualifier && <span class="text-[10px] opacity-60 ml-1 schedule-qualifier font-bold italic">{row.qualifier}</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- 16U Content -->
          <div class="schedule-content hidden" id="schedule-16u">
            <div class="overflow-x-auto schedule-container">
              <table class="w-full text-left text-sm schedule-table">
                <thead class="text-white/40 uppercase text-[10px] tracking-widest font-bold">
                  <tr>
                    <th class="px-6 py-4 text-brand-coral">Date</th>
                    <th class="px-6 py-4">Event</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-white/70">
                  {[
                    { date: '1/4/26', event: 'Power League Qualifier Day 1' },
                    { date: '2/1/26', event: 'Power League Qualifier Day 2' },
                    { date: '2/21/26', event: 'Power League #1' },
                    { date: '3/15/26', event: 'Power League #2' },
                    { date: '4/18/26', event: 'Power League #3' },
                    { date: '4/25/26', event: 'CEVA Regional Tournament', qualifier: '(IF QUALIFIED)', highlight: true },
                  ].map(row => (
                    <tr class={row.highlight ? "bg-brand-coral/5 text-brand-coral schedule-regional" : "hover:bg-white/5 transition-colors"}>
                      <td class="px-6 py-4 font-mono whitespace-nowrap schedule-date">{row.date}</td>
                      <td class="px-6 py-4 font-medium">
                        {row.event} {row.qualifier && <span class="text-[10px] opacity-60 ml-1 schedule-qualifier font-bold italic">{row.qualifier}</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- 18U Content -->
          <div class="schedule-content hidden" id="schedule-18u">
            <div class="overflow-x-auto schedule-container">
              <table class="w-full text-left text-sm schedule-table">
                <thead class="text-white/40 uppercase text-[10px] tracking-widest font-bold">
                  <tr>
                    <th class="px-6 py-4 text-white">Date</th>
                    <th class="px-6 py-4">Event</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-white/70">
                  {[
                    { date: '1/3/26', event: 'Power League Qualifier' },
                    { date: '1/31/26', event: 'Power League #1' },
                    { date: '3/1/26', event: 'Cabin Fever (18s)' },
                    { date: '3/7/26', event: 'Mid-Season Block Party (17s)' },
                    { date: '3/14/26', event: 'Power League #2' },
                    { date: '4/4/26', event: 'Power League #3' },
                    { date: '4/25/26', event: 'CEVA Regional Tournament', qualifier: '(IF QUALIFIED)', highlight: true },
                  ].map(row => (
                    <tr class={row.highlight ? "bg-white/10 text-white schedule-regional" : "hover:bg-white/5 transition-colors"}>
                      <td class="px-6 py-4 font-mono whitespace-nowrap schedule-date">{row.date}</td>
                      <td class="px-6 py-4 font-medium">
                        {row.event} {row.qualifier && <span class="text-[10px] opacity-60 ml-1 schedule-qualifier font-bold italic">{row.qualifier}</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <style>
      .schedule-tab.active {
        @apply bg-brand-teal text-white;
      }
      .schedule-content.active {
        display: block;
        animation: fadeIn 0.3s ease-out;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>

    <script>
      function setupTabs() {
        const tabs = document.querySelectorAll('.schedule-tab');
        const contents = document.querySelectorAll('.schedule-content');

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const target = tab.getAttribute('data-tab');

            // Update tabs
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');

            // Update content
            contents.forEach(content => {
              if (content.id === `schedule-${target}`) {
                content.classList.remove('hidden');
                content.classList.add('active');
              } else {
                content.classList.add('hidden');
                content.classList.remove('active');
              }
            });
          });
        });
      }

      setupTabs();
      document.addEventListener('astro:after-swap', setupTabs);
    </script>
  </main>
</BaseLayout>
