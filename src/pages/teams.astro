---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Teams & Tryouts" description="TVVC's competitive age-group teams, girls volleyball club in Hillsboro, OR. 12U-18U development-first focus.">
  <main class="pt-32">
    <!-- Hero Section -->
    <section class="px-6 py-20 relative">
      <div class="max-w-6xl mx-auto">
        <span class="text-brand-teal font-bold uppercase tracking-widest text-xs mb-4 block">Competitive Excellence</span>
        <h1 class="text-4xl md:text-7xl font-heading font-extrabold mb-6 leading-tight">
          Competitive Teams.<br/>
          <span class="text-white/40">Development First.</span>
        </h1>
        <p class="text-lg text-white/60 max-w-2xl leading-relaxed mb-10">
          Four age-group levels with a focus on skill development, game understanding, and the love of volleyball. Join a team where growth matters more than outcomes.
        </p>
      </div>
    </section>

    <!-- Age Groups Bento -->
    <section class="max-w-6xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card border-brand-teal/20">
          <span class="text-3xl mb-6 block">✨</span>
          <span class="text-[10px] font-bold text-brand-teal uppercase tracking-widest mb-2 block">Introductory Phase</span>
          <h3 class="text-xl font-heading mb-4">12U — Start With Joy and Confidence</h3>
          <p class="text-sm text-white/50 leading-relaxed mb-6">A fun, supportive entry point for young athletes to explore the game, build basic skills, and grow confidence through play-based learning and positive team experiences.</p>
          <div class="pt-4 border-t border-white/5">
            <p class="text-[10px] font-bold text-brand-teal uppercase tracking-widest mb-1">Tryouts</p>
            <p class="text-sm font-bold text-white/90">Nov 8, 2026</p>
            <p class="text-[10px] text-white/40 uppercase tracking-widest">Time: TBD</p>
          </div>
        </div>

        <div class="glass-card border-white/10">
          <span class="text-3xl mb-6 block">🌱</span>
          <span class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-2 block">Foundation Phase</span>
          <h3 class="text-xl font-heading mb-4">13U–14U — Build the Foundation</h3>
          <p class="text-sm text-white/50 leading-relaxed mb-6">Developing core technical skills while fostering a love for the game. We focus on establishing strong movement patterns and basic game understanding.</p>
          <div class="pt-4 border-t border-white/5">
            <p class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-1">Tryouts</p>
            <p class="text-sm font-bold text-white/90">Nov 8, 2026</p>
            <p class="text-[10px] text-white/40 uppercase tracking-widest">Time: TBD</p>
          </div>
        </div>

        <div class="glass-card border-brand-coral/20">
          <span class="text-3xl mb-6 block">📈</span>
          <span class="text-[10px] font-bold text-brand-coral uppercase tracking-widest mb-2 block">Development Phase</span>
          <h3 class="text-xl font-heading mb-4">15U–16U — Grow Through the Game</h3>
          <p class="text-sm text-white/50 leading-relaxed mb-6">Developing skills while learning to read the game in real-time. We focus on decision-making and communication.</p>
          <div class="pt-4 border-t border-white/5">
            <p class="text-[10px] font-bold text-brand-coral uppercase tracking-widest mb-1">Tryouts</p>
            <p class="text-sm font-bold text-white/90">Nov 15, 2026</p>
            <p class="text-[10px] text-white/40 uppercase tracking-widest">Time: TBD</p>
          </div>
        </div>

        <div class="glass-card border-white/5">
          <span class="text-3xl mb-6 block">🏆</span>
          <span class="text-[10px] font-bold text-white/30 uppercase tracking-widest mb-2 block">Competitive Phase</span>
          <h3 class="text-xl font-heading mb-4">17U–18U — Lead with Confidence</h3>
          <p class="text-sm text-white/50 leading-relaxed mb-6">A competitive space for athletes to elevate skills and leadership, focusing on meaningful training and personal growth.</p>
          <div class="pt-4 border-t border-white/5">
            <p class="text-[10px] font-bold text-white/30 uppercase tracking-widest mb-1">Tryouts</p>
            <p class="text-sm font-bold text-white/90">Nov 15, 2026</p>
            <p class="text-[10px] text-white/40 uppercase tracking-widest">Time: TBD</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Age Eligibility Info -->
    <section class="max-w-6xl mx-auto px-6 mb-12">
      <div class="relative group">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-brand-teal to-brand-coral rounded-[2rem] blur opacity-20 group-hover:opacity-40 transition duration-1000"></div>
        <div class="relative glass-card border-white/20 bg-black/40 p-8 flex flex-col md:flex-row items-center gap-8 shadow-2xl">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-brand-teal/20 to-brand-coral/20 flex items-center justify-center text-3xl shrink-0 shadow-inner">📅</div>
          <div>
            <h4 class="text-xs font-bold uppercase tracking-[0.3em] text-transparent bg-clip-text bg-gradient-to-r from-brand-teal to-brand-coral mb-3">Critical Age Eligibility Rule</h4>
            <p class="text-base text-white/80 leading-relaxed">
              For the 2026–2027 season, players are grouped by their age as of <span class="text-brand-teal font-bold underline decoration-brand-teal/30 underline-offset-4">June 30, 2027</span>. Athletes may play in their designated age division or older, but <span class="text-brand-coral font-bold italic">never younger</span>. For example, a player who turns 16 by June 30, 2027, is eligible for 16U or higher.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Season Logistics -->
    <section class="max-w-6xl mx-auto px-6 py-24">
       <div class="glass-card !p-0 overflow-hidden grid grid-cols-1 md:grid-cols-2">
         <div class="p-8 md:p-12 bg-brand-teal/5">
            <h2 class="text-3xl font-heading mb-8">Season <span class="text-brand-teal">Logistics</span></h2>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-teal/10 flex items-center justify-center text-brand-teal">📅</div>
                <div>
                  <h4 class="font-bold text-sm uppercase tracking-wider mb-1">Season Dates</h4>
                  <p class="text-white/60">December 2026 – May 2027</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-teal/10 flex items-center justify-center text-brand-teal">⏰</div>
                <div>
                  <h4 class="font-bold text-sm uppercase tracking-wider mb-1">Practice Schedule</h4>
                  <p class="text-white/60">2x per week</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-full bg-brand-teal/10 flex items-center justify-center text-brand-teal">🏐</div>
                <div>
                  <h4 class="font-bold text-sm uppercase tracking-wider mb-1">Tournaments</h4>
                  <p class="text-white/60">6–7 per season (CEVA Region)</p>
                </div>
              </div>
            </div>
         </div>

         <div class="p-8 md:p-12 flex flex-col justify-center">
            <div class="mb-8">
              <span class="text-[10px] font-bold text-white/40 uppercase tracking-[0.2em] mb-2 block">Investment</span>
              <div class="flex items-baseline gap-2">
                <span class="text-5xl font-heading font-extrabold">$1,500</span>
                <span class="text-white/40 text-sm italic">/ season</span>
              </div>
              <p class="mt-4 text-xs text-white/50 leading-relaxed">
                <strong class="text-brand-teal">Payment Plan:</strong> $400 deposit due in November, followed by 5 monthly payments of $220 paid January through May.
              </p>
            </div>
            
            <ul class="space-y-3 mb-10">
              {[
                '2 Jerseys, Practice Shirt, Spandex, & Fleece Sweatshirt',
                'All Tournament Fees',
                'All Practices & Training',
                'Free private or group training',
                'Free in season clinics'
              ].map(item => (
                <li class="flex items-center gap-3 text-sm text-white/70">
                  <svg class="text-brand-teal" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {item}
                </li>
              ))}
            </ul>
         </div>
       </div>
    </section>

    <!-- Financial Assistance -->
    <section class="max-w-6xl mx-auto px-6 -mt-16 mb-24 relative z-10">
      <div class="glass-card border-brand-coral/30 bg-brand-coral/5 p-8 md:p-12 text-center">
        <h2 class="text-2xl font-heading mb-4 text-brand-coral">Financial Assistance</h2>
        <p class="text-white/80 max-w-3xl mx-auto leading-relaxed">
          Our prices have gone up to allow us to afford rising costs of the facility we are in, and we are working to secure some business sponsors to help mitigate this cost increase. Anyone in need of financial assistance should contact Loren directly at <a href="mailto:loren@tualatinvalleyvb.com" class="text-brand-coral hover:underline font-bold">loren@tualatinvalleyvb.com</a>.
        </p>
      </div>
    </section>

    <!-- Schedule Tables -->
    <section class="max-w-4xl mx-auto px-6 py-24" id="tournament-schedule">
      <h2 class="text-3xl font-heading mb-4 text-center">2026 Tournament <span class="text-brand-coral">Schedule</span></h2>
      <p class="text-white/40 text-center mb-12 max-w-md mx-auto section-subtitle">Competitive matches and regional qualifiers for the 2026 season.</p>
      
      <div class="glass rounded-[2rem] border-white/10 overflow-hidden shadow-2xl">
        <!-- Tab Navigation -->
        <div class="flex flex-wrap border-b border-white/10 bg-white/5">
          <button class="flex-1 py-4 px-6 text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-white/5 schedule-tab active" data-tab="12u">11 & 12U</button>
          <button class="flex-1 py-4 px-6 text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-white/5 schedule-tab" data-tab="14u">13 & 14U</button>
          <button class="flex-1 py-4 px-6 text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-white/5 schedule-tab" data-tab="16u">15 & 16U</button>
          <button class="flex-1 py-4 px-6 text-[10px] font-bold uppercase tracking-widest transition-all hover:bg-white/5 schedule-tab" data-tab="18u">17 & 18U</button>
        </div>

        <div class="p-4 md:p-8">
          <!-- 11 & 12U Content -->
          <div class="schedule-content active" id="schedule-12u">
            <div class="p-12 text-center">
              <span class="text-4xl mb-6 block">✨</span>
              <p class="text-brand-teal font-heading italic text-2xl mb-2">Coming October 2026</p>
              <p class="text-white/40 text-sm max-w-xs mx-auto">Registration and schedule details for our 11 & 12U programs will be announced soon.</p>
            </div>
          </div>

          <!-- 13 & 14U Content -->
          <div class="schedule-content hidden" id="schedule-14u">
            <div class="p-12 text-center">
              <span class="text-4xl mb-6 block">🌱</span>
              <p class="text-brand-teal font-heading italic text-2xl mb-2">Coming October 2026</p>
              <p class="text-white/40 text-sm max-w-xs mx-auto">Registration and schedule details for our 13 & 14U programs will be announced soon.</p>
            </div>
          </div>

          <!-- 15 & 16U Content -->
          <div class="schedule-content hidden" id="schedule-16u">
            <div class="p-12 text-center">
              <span class="text-4xl mb-6 block">📈</span>
              <p class="text-brand-coral font-heading italic text-2xl mb-2">Coming October 2026</p>
              <p class="text-white/40 text-sm max-w-xs mx-auto">Registration and schedule details for our 15 & 16U programs will be announced soon.</p>
            </div>
          </div>

          <!-- 17 & 18U Content -->
          <div class="schedule-content hidden" id="schedule-18u">
            <div class="p-12 text-center">
              <span class="text-4xl mb-6 block">🏆</span>
              <p class="text-white font-heading italic text-2xl mb-2">Coming October 2026</p>
              <p class="text-white/40 text-sm max-w-xs mx-auto">Registration and schedule details for our 17 & 18U programs will be announced soon.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <style>
      .schedule-tab.active {
        @apply bg-brand-teal text-white;
      }
      .schedule-content.active {
        display: block;
        animation: fadeIn 0.3s ease-out;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>

    <script>
      function setupTabs() {
        const tabs = document.querySelectorAll('.schedule-tab');
        const contents = document.querySelectorAll('.schedule-content');

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const target = tab.getAttribute('data-tab');

            // Update tabs
            tabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');

            // Update content
            contents.forEach(content => {
              if (content.id === `schedule-${target}`) {
                content.classList.remove('hidden');
                content.classList.add('active');
              } else {
                content.classList.add('hidden');
                content.classList.remove('active');
              }
            });
          });
        });
      }

      setupTabs();
      document.addEventListener('astro:after-swap', setupTabs);
    </script>
  </main>
</BaseLayout>
