---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/700.css';
import '@fontsource/outfit/800.css';
import '@fontsource/syne/400.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LoadingBar from '../components/LoadingBar.astro';
import FormPersistence from '../components/FormPersistence.astro';
import Toaster from '../components/Toaster';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  og?: {
    title: string;
    description: string;
    badge?: string;
  };
}

const defaultDescription = "Tualatin Valley Volleyball Club. High-quality, affordable volleyball club in Hillsboro, OR. Smarter training, not just more reps.";

const { 
  title, 
  description = defaultDescription,
  image: propImage,
  noindex = false,
  structuredData,
  og
} = Astro.props;

const siteURL = Astro.site || 'https://tualatinvalleyvb.com';

// Generate OG image URL
let image = propImage || "/assets/images/og-image.jpg";
if (og) {
  const ogUrl = new URL('/api/og.png', siteURL);
  ogUrl.searchParams.set('title', og.title);
  ogUrl.searchParams.set('description', og.description);
  if (og.badge) ogUrl.searchParams.set('badge', og.badge);
  image = ogUrl.toString();
}

function cleanCanonicalPath(pathname: string) {
  const withoutIndex = pathname.replace(/\/index\.html$/, '/');
  const withoutExtension = withoutIndex.replace(/\.html$/, '');
  return withoutExtension || '/';
}

const canonicalURL = new URL(cleanCanonicalPath(Astro.url.pathname), siteURL);
const absoluteImageURL = new URL(image, canonicalURL);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'SportsOrganization'],
  '@id': new URL('/#organization', siteURL).toString(),
  name: 'Tualatin Valley Volleyball Club',
  alternateName: 'TVVC',
  url: new URL('/', siteURL).toString(),
  logo: new URL('/assets/images/tvvc-logo.png', siteURL).toString(),
  image: new URL('/assets/images/og-image.jpg', siteURL).toString(),
  description: defaultDescription,
  telephone: '+1-503-389-0760',
  email: 'info@tualatinvalleyvb.com',
  sport: 'Volleyball',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2820 SE 58th Court',
    addressLocality: 'Hillsboro',
    addressRegion: 'OR',
    postalCode: '97123',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 45.4988613,
    longitude: -122.9224053,
  },
  areaServed: [
    { '@type': 'City', name: 'Hillsboro' },
    { '@type': 'City', name: 'Beaverton' },
    { '@type': 'AdministrativeArea', name: 'Washington County, Oregon' },
    { '@type': 'Place', name: 'Tualatin Valley' },
  ],
};
const providedStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const pageStructuredData = noindex
  ? providedStructuredData
  : [organizationSchema, ...providedStructuredData];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/assets/images/tvvc-logo.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#009695" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/assets/images/tvvc-logo.png" />
    
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Primary Meta Tags -->
    <title>{title} — TVVC</title>
    <meta name="title" content={`${title} — TVVC`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} — TVVC`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} — TVVC`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteImageURL} />

    {pageStructuredData.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <slot name="head" />
  </head>
  <body class="bg-brand-charcoal text-white selection:bg-brand-teal/30 antialiased font-body relative">
    <Toaster client:idle />
    <LoadingBar />
    <FormPersistence />
    
    <Header />

    <slot />

    <Footer />
    <script is:inline>
      window.toast = {
        success: (message) => window.dispatchEvent(new CustomEvent('app:toast', { detail: { message, type: 'success' } })),
        error: (message) => window.dispatchEvent(new CustomEvent('app:toast', { detail: { message, type: 'error' } }))
      };
    </script>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(err => {
            console.log('ServiceWorker registration failed: ', err);
          });
        });
      }
    </script>
  </body>
</html>
