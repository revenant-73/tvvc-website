---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/700.css';
import '@fontsource/outfit/800.css';
import '@fontsource/syne/400.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LoadingBar from '../components/LoadingBar.astro';
import FormPersistence from '../components/FormPersistence.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  og?: {
    title: string;
    description: string;
    badge?: string;
  };
}

const { 
  title, 
  description = "Tualatin Valley Volleyball Club. High-quality, affordable volleyball club in Hillsboro, OR. Smarter training, not just more reps.",
  image: propImage,
  noindex = false,
  og
} = Astro.props;

// Generate OG image URL
let image = propImage || "/assets/images/og-image.jpg";
if (og) {
  const ogUrl = new URL('/api/og.png', 'https://tualatinvalleyvb.com');
  ogUrl.searchParams.set('title', og.title);
  ogUrl.searchParams.set('description', og.description);
  if (og.badge) ogUrl.searchParams.set('badge', og.badge);
  image = ogUrl.toString();
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://tualatinvalleyvb.com');
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/assets/images/tvvc-logo.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#009695" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/assets/images/tvvc-logo.png" />
    
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Primary Meta Tags -->
    <title>{title} — TVVC</title>
    <meta name="title" content={`${title} — TVVC`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={`${title} — TVVC`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={`${title} — TVVC`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <slot name="head" />
  </head>
  <body class="bg-brand-charcoal text-white selection:bg-brand-teal/30 antialiased font-body relative">
    <LoadingBar />
    <FormPersistence />
    
    <Header />

    <slot />

    <Footer />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(err => {
            console.log('ServiceWorker registration failed: ', err);
          });
        });
      }
    </script>
  </body>
</html>
